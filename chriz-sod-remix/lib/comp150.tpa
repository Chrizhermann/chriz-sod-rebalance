// Component 150 owns the palace-night, arrival and council blocks and the
// selected council dialogue fields. Missing graph records are supplied.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
LOAD_TRA ~chriz-sod-remix/languages/english/comp150.tra~
OUTER_SET csr150_tlk_shift = 0
ACTION_IF GAME_IS ~eet~ BEGIN OUTER_SET csr150_tlk_shift = 200000 END
OUTER_SET csr150_treasury_journal = 67494 + csr150_tlk_shift
OUTER_SET csr150_council_info = 56387 + csr150_tlk_shift
OUTER_SET csr150_campaign_quest = 59617 + csr150_tlk_shift
OUTER_SET csr150_quest_root = 66700 + csr150_tlk_shift

ACTION_FOR_EACH script IN ~bd0103~ ~bd0100~ ~bd0102~ BEGIN
  LAF csr_ensure_script STR_VAR script END
END
COPY_EXISTING ~bd0103.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr150/night.baf~ ~.../csr150-read~ READ_ASCII 0 night (SOURCE_SIZE) END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csrarr.baf~ ~.../csr150-read~ READ_ASCII 0 arrival (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1
      STR_VAR pattern = ~TextScreen("DPALACE")\|Global("CSR_BEDTIME","GLOBAL",1)~ replacement = EVAL ~%night%~ END
    LPF csr_replace_script_blocks
      STR_VAR pattern = ~"CSR_ARRIVE"\|"CSR_SERV_RESPAWN"~ replacement = EVAL ~%arrival%~ END
  END
BUT_ONLY
COPY_EXISTING ~bd0100.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csrswp.baf~ ~.../csr150-read~ READ_ASCII 0 sweep (SOURCE_SIZE) END
    LPF csr_replace_script_blocks STR_VAR pattern = ~"CSR_SWEEP"~ replacement = EVAL ~%sweep%~ END
  END
BUT_ONLY
COPY_EXISTING ~bd0102.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr150/council.baf~ ~.../csr150-read~ READ_ASCII 0 council (SOURCE_SIZE) END
    INNER_PATCH_SAVE council ~%council%~ BEGIN
      // A repeated tail respects our later Entar-removal component.
      PATCH_IF MOD_IS_INSTALLED ~chriz-sod-remix/setup-chriz-sod-remix.tp2~ ~185~ BEGIN
        REPLACE_TEXTUALLY CASE_INSENSITIVE ~^[ %TAB%]*\(CreateCreature("BDENTAR",[^%WNL%]*\|ActionOverride("BDENTAR",[^%WNL%]*\)~ ~~
      END
    END
    LPF csr_replace_script_blocks INT_VAR in_place = 1
      STR_VAR pattern = ~SetGlobal("BD_plot","global",52)~ replacement = EVAL ~%council%~ END
  END
BUT_ONLY

ACTION_IF FILE_EXISTS_IN_GAME ~bdserv.cre~ BEGIN
  COPY_EXISTING - ~bdserv.cre~ ~override~ SET readable = SOURCE_SIZE >= 0x2d4
  ACTION_IF readable BEGIN
    COPY_EXISTING ~bdserv.cre~ ~override/csrserv.cre~
      WRITE_ASCII 0x248 ~None~ #8
      WRITE_ASCII 0x280 ~csrserv~ #32
      WRITE_ASCII 0x2cc ~csrserv~ #8
  END ELSE BEGIN PRINT ~SoD Remix #150: servant donor is unreadable; this copy is unavailable.~ END
END ELSE BEGIN PRINT ~SoD Remix #150: servant donor is absent; this copy is unavailable.~ END
COMPILE ~chriz-sod-remix/dlg/csrserv.d~
INCLUDE ~chriz-sod-remix/lib/comp150_dialog.tpa~
COMPILE EVALUATE_BUFFER ~chriz-sod-remix/dlg/csrcncl.d~

ACTION_IF FILE_EXISTS_IN_GAME ~bgee.lua~ BEGIN
  OUTER_SET csr_jdone = RESOLVE_STR_REF(@15010)
  COPY_EXISTING ~bgee.lua~ ~override~
    SPRINT registration ~
-- CSR150 journal registration
CSR150_BuildQuests = CSR150_BuildQuests or buildQuestsTable
function buildQuestsTable()
  if CSR150_BuildQuests then CSR150_BuildQuests() end
  quests = quests or {}
  userNotes = userNotes or {}
  looseEntries = looseEntries or {}
  subGroups = subGroups or {}
  if not findQuest(%csr150_quest_root%) then createQuest(%csr150_quest_root%) end
  createEntry(%csr150_quest_root%, -1, %csr_jdone%, {}, 277)
end
-- CSR150 registration end
~
    REPLACE_TEXTUALLY ~-- CSR150 journal registration\(.\|[%WNL%]\)*-- CSR150 registration end~ ~~
    INSERT_BYTES BUFFER_LENGTH (STRING_LENGTH ~%registration%~)
    WRITE_ASCIIE (BUFFER_LENGTH - STRING_LENGTH ~%registration%~) ~%registration%~
END ELSE BEGIN PRINT ~SoD Remix #150: BGEE.LUA is absent; journal UI registration is unavailable.~ END
