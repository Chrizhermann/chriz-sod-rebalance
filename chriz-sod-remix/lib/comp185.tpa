// Entar's city spawns/staging are removed. Belt owns the departure staging.
INCLUDE ~chriz-sod-remix/lib/overwrite_tail.tpa~
LOAD_TRA ~chriz-sod-remix/languages/english/csr185ent.tra~
OUTER_SET csr185_shift = 0
ACTION_IF GAME_IS ~eet~ BEGIN OUTER_SET csr185_shift = 200000 END
LAF csr_ensure_script STR_VAR script = ~bd0102~ END
COPY_EXISTING ~bd0102.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr185-departure.baf~ ~.../csr185-read~ READ_ASCII 0 departure (SOURCE_SIZE) END
    // Preserve our later party-safe Skie cleanup on a repeated tail.
    INNER_PATCH_SAVE departure ~%departure%~ BEGIN
      PATCH_IF MOD_IS_INSTALLED ~chriz-sod-remix/setup-chriz-sod-remix.tp2~ 197 BEGIN
        REPLACE_TEXTUALLY CASE_INSENSITIVE ~ApplySpellRES("bddest","bdskie")~ ~~
      END
    END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~SetGlobal("BD_plot","global",56)~ replacement = EVAL ~%departure%~ END
    REPLACE_TEXTUALLY CASE_INSENSITIVE ~^[ %TAB%]*\(CreateCreature("BDENTAR",[^%WNL%]*\|ActionOverride("BDENTAR",[^%WNL%]*\)~ ~~
  END
BUT_ONLY
INCLUDE ~chriz-sod-remix/lib/comp185_seed.tpa~
OUTER_SET first_text = RESOLVE_STR_REF(@18501)
LAF csr_claim_dialogue_tail INT_VAR count = 3 first_text STR_VAR dialog = ~BDBELT~ key = ~185_BDBELT~ RET base END
OUTER_SET csr185_open = base OUTER_SET csr185_loop = base + 1 OUTER_SET csr185_close = base + 2
LAF csr_dlg_state_weight INT_VAR state = csr185_open STR_VAR dialog = ~BDBELT~ RET csr185_open_weight = clause END
LAF csr_dlg_state_weight INT_VAR state = csr185_loop STR_VAR dialog = ~BDBELT~ RET csr185_loop_weight = clause END
LAF csr_dlg_state_weight INT_VAR state = csr185_close STR_VAR dialog = ~BDBELT~ RET csr185_close_weight = clause END
COMPILE EVALUATE_BUFFER ~chriz-sod-remix/dlg/csr185ent.d~
