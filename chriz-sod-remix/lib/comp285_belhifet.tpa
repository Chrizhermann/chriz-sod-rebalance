INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~

// Interim finale: preserve the native offensive AI, replace only the unfair
// opener/reinforcement loop and apply the approved access/durability changes.

<<<<<<<< .../csr285bel.baf
%csr285_boss_prefix%
>>>>>>>>
<<<<<<<< .../csr285die.baf
IF
  Die()
  Global("CSR285_COUNTED_DEAD","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("CSR285_COUNTED_DEAD","LOCALS",1)
    IncrementGlobal("CSR285_ADDS","BD4700",-1)
    Continue()
END
>>>>>>>>

DEFINE_ACTION_FUNCTION csr285_belhifet_preflight RET csr285_breach csr285_breach_range BEGIN
  OUTER_SPRINT csr285_breach ~SPWI513~
  OUTER_SET csr285_breach_id = IDS_OF_SYMBOL (~SPELL~ ~WIZARD_BREACH~)
  ACTION_IF csr285_breach_id >= 2000 AND csr285_breach_id < 3000 BEGIN
    OUTER_SET csr285_breach_suffix = csr285_breach_id - 2000
    OUTER_SPRINT csr285_breach ~SPWI%csr285_breach_suffix%~
  END
  OUTER_SET csr285_breach_range = 12
  ACTION_IF FILE_EXISTS_IN_GAME ~%csr285_breach%.SPL~ BEGIN
    COPY_EXISTING - ~%csr285_breach%.SPL~ ~override~
      PATCH_IF SOURCE_SIZE >= 0x72 BEGIN
        READ_LONG 0x64 ab READ_SHORT 0x68 count
        PATCH_IF count > 0 AND ab + 0x28 <= SOURCE_SIZE BEGIN
          READ_SHORT (ab + 0x0e) csr285_breach_range
          SET csr285_breach_range = (csr285_breach_range < 12) ? csr285_breach_range : 12
        END
      END
  END ELSE BEGIN
    PRINT ~#285: Breach is absent; the other finale changes still apply.~
  END
END

DEFINE_ACTION_FUNCTION csr285_make_hp_spell
  INT_VAR bonus = 0
  STR_VAR ref = ~~
BEGIN
  CREATE ~spl~ ~%ref%~
    WRITE_LONG 0x08 0xffffffff
    WRITE_LONG 0x0c 0xffffffff
    WRITE_SHORT 0x1c 4
    WRITE_LONG 0x34 1
    WRITE_LONG 0x64 0x72
    WRITE_SHORT 0x68 1
    WRITE_LONG 0x6a 0x9a
    INSERT_BYTES 0x72 0x58
    WRITE_BYTE 0x72 1
    WRITE_BYTE 0x7e 5
    WRITE_SHORT 0x82 1
    WRITE_SHORT 0x90 1
    WRITE_SHORT 0x98 1
    WRITE_SHORT 0x9a 18
    WRITE_BYTE 0x9c 1
    WRITE_LONG 0x9e bonus
    WRITE_LONG 0xa2 0
    WRITE_BYTE 0xa6 1
    WRITE_BYTE 0xa7 2
    WRITE_BYTE 0xac 100
END

DEFINE_ACTION_FUNCTION csr285_build_boss_prefix RET csr285_boss_prefix BEGIN
  OUTER_SPRINT csr285_boss_prefix ~~
  // Additive, once-only HP keeps the engine's separate LoB bonus intact.
  // On the stock 350-HP chassis: Easy350, Normal400, Core450, Hard475, Insane500.
  ACTION_FOR_EACH tier IN ~EASIEST~ ~EASY~ ~NORMAL~ ~HARD~ ~HARDEST~ BEGIN
    OUTER_SPRINT hp_action ~~
    // Eight-character resources, independent of difficulty-name lengths.
    ACTION_IF (~%tier%~ STRING_EQUAL ~EASY~) BEGIN OUTER_SPRINT hp_action ~    ApplySpellRES("CSR285H2",Myself)%LNL%~ END
    ACTION_IF (~%tier%~ STRING_EQUAL ~NORMAL~) BEGIN OUTER_SPRINT hp_action ~    ApplySpellRES("CSR285H3",Myself)%LNL%~ END
    ACTION_IF (~%tier%~ STRING_EQUAL ~HARD~) BEGIN OUTER_SPRINT hp_action ~    ApplySpellRES("CSR285H4",Myself)%LNL%~ END
    ACTION_IF (~%tier%~ STRING_EQUAL ~HARDEST~) BEGIN OUTER_SPRINT hp_action ~    ApplySpellRES("CSR285H5",Myself)%LNL%~ END
    OUTER_SPRINT csr285_boss_prefix ~%csr285_boss_prefix%IF
  AreaCheck("BD4700")
  !StateCheck(Myself,STATE_REALLY_DEAD)
  Global("CSR285_INIT","LOCALS",0)
  Difficulty(%tier%)
THEN
  RESPONSE #100
    SetGlobal("CSR285_INIT","LOCALS",1)
%hp_action%    Continue()
END

~
  END
  OUTER_SPRINT csr285_boss_prefix ~%csr285_boss_prefix%IF
  Global("bd_plot","GLOBAL",565)
  Global("CSR285_COMBAT","LOCALS",0)
  !StateCheck(Myself,STATE_REALLY_DEAD)
THEN
  RESPONSE #100
    SetGlobal("CSR285_COMBAT","LOCALS",1)
    SetGlobalTimer("CSR285_BREACH","LOCALS",THREE_ROUNDS)
    SetGlobalTimer("CSR285_GATE","LOCALS",FOUR_ROUNDS)
    Continue()
END

~
  ACTION_FOR_EACH tier IN ~HARDEST~ ~LOWER~ BEGIN
    OUTER_SPRINT difficulty ~  Difficulty(HARDEST)~
    OUTER_SPRINT cooldown ~THREE_ROUNDS~
    ACTION_IF (~%tier%~ STRING_EQUAL ~LOWER~) BEGIN
      OUTER_SPRINT difficulty ~  DifficultyLT(HARDEST)
  DifficultyGT(EASIEST)~
      OUTER_SPRINT cooldown ~FOUR_ROUNDS~
    END
    ACTION_FOR_EACH who IN ~NearestEnemyOf(Myself)~ ~SecondNearestEnemyOf(Myself)~ ~ThirdNearestEnemyOf(Myself)~ BEGIN
      OUTER_SPRINT csr285_boss_prefix ~%csr285_boss_prefix%IF
  Global("bd_plot","GLOBAL",565)
  Global("CSR285_COMBAT","LOCALS",1)
%difficulty%
  !GlobalTimerNotExpired("CSR285_BREACH","LOCALS")
  !GlobalTimerNotExpired("BD_Cast","LOCALS")
  !StateCheck(Myself,STATE_IMMOBILE)
  See(%who%)
  Range(LastSeenBy(Myself),%csr285_breach_range%)
  !StateCheck(LastSeenBy(Myself),STATE_REALLY_DEAD)
  !StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
  OR(3)
    CheckStatGT(LastSeenBy(Myself),0,STONESKINS)
    CheckStatGT(LastSeenBy(Myself),0,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)
    CheckStatGT(LastSeenBy(Myself),0,WIZARD_PROTECTION_FROM_NORMAL_WEAPONS)
THEN
  RESPONSE #100
    SetGlobalTimer("CSR285_BREACH","LOCALS",%cooldown%)
    SetGlobalTimer("BD_Cast","LOCALS",ONE_ROUND)
    SetGlobalTimer("BD_NoTeleport","LOCALS",TWO_ROUNDS)
    ForceSpellRES("%csr285_breach%",LastSeenBy(Myself))
    AttackOneRound(LastSeenBy(Myself))
END

~
    END
  END
  ACTION_FOR_EACH tier IN ~NORMAL~ ~HARD~ ~HARDEST~ BEGIN
    OUTER_SET cap = 4
    OUTER_SPRINT threshold ~~
    OUTER_SPRINT delay ~FOUR_ROUNDS~
    ACTION_IF (~%tier%~ STRING_EQUAL ~NORMAL~) BEGIN
      OUTER_SET cap = 2
      OUTER_SPRINT threshold ~  HPPercentLT(Myself,50)%LNL%~
      OUTER_SPRINT delay ~FIVE_ROUNDS~
    END
    ACTION_IF (~%tier%~ STRING_EQUAL ~HARD~) BEGIN
      OUTER_SPRINT threshold ~  HPPercentLT(Myself,75)%LNL%~
    END
    OUTER_SPRINT csr285_boss_prefix ~%csr285_boss_prefix%IF
  Global("bd_plot","GLOBAL",565)
  Global("CSR285_COMBAT","LOCALS",1)
  Difficulty(%tier%)
  GlobalLT("CSR285_ADDS","BD4700",%cap%)
  !GlobalTimerNotExpired("CSR285_GATE","LOCALS")
  !GlobalTimerNotExpired("BD_Cast","LOCALS")
  !StateCheck(Myself,STATE_IMMOBILE)
  See(NearestEnemyOf(Myself))
%threshold%THEN
~
    ACTION_FOR_EACH slot IN ~1~ ~2~ ~3~ ~4~ BEGIN
      OUTER_SPRINT csr285_boss_prefix ~%csr285_boss_prefix%  RESPONSE #100
    SetGlobalTimer("CSR285_GATE","LOCALS",%delay%)
    SetGlobalTimer("BD_Cast","LOCALS",ONE_ROUND)
    IncrementGlobal("CSR285_ADDS","BD4700",1)
    CreateCreatureObjectEffect("CSR285D%slot%","DDOORH",Myself)
~
    END
    OUTER_SPRINT csr285_boss_prefix ~%csr285_boss_prefix%END

~
  END
END

// Format bounds protect an individual file, never the component.
DEFINE_ACTION_FUNCTION csr285_readable
  STR_VAR resource = ~~ kind = ~~
  RET readable
BEGIN
  OUTER_SET readable = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~%resource%~ BEGIN
    COPY_EXISTING - ~%resource%~ ~override~
      PATCH_IF ~%kind%~ STRING_EQUAL ~cre~ BEGIN
        SET readable = SOURCE_SIZE >= 0x2d4
      END ELSE BEGIN
        SET readable = SOURCE_SIZE >= 0x72
        PATCH_IF readable BEGIN
          READ_LONG 0x64 ab READ_SHORT 0x68 ac
          READ_LONG 0x6a fx READ_SHORT 0x6e first READ_SHORT 0x70 count
          SET readable = ab + ac * 0x38 <= SOURCE_SIZE AND fx + (first + count) * 0x30 <= SOURCE_SIZE
          FOR (check = 0; readable AND check < ac; ++check) BEGIN
            READ_SHORT (ab + check * 0x38 + 0x1e) count
            READ_SHORT (ab + check * 0x38 + 0x20) first
            SET readable = fx + (first + count) * 0x30 <= SOURCE_SIZE
          END
        END
      END
    ACTION_IF NOT readable BEGIN PRINT ~#285: %resource% has unreadable tables; only this file is omitted.~ END
  END ELSE BEGIN PRINT ~#285: %resource% is absent; only this donor is omitted.~ END
END

DEFINE_ACTION_FUNCTION csr285_belhifet_install BEGIN
  ACTION_DEFINE_ASSOCIATIVE_ARRAY csr285_items BEGIN
    BDBELHIA => CSR285AR
    BDBELHI1 => CSR285W1
    BDBELHI2 => CSR285W2
  END
  ACTION_PHP_EACH csr285_items AS original => owned BEGIN
    LAF csr285_readable STR_VAR resource = EVAL ~%original%.ITM~ kind = ~itm~ RET readable END
    ACTION_IF readable BEGIN
    COPY_EXISTING ~%original%.ITM~ ~override/%owned%.ITM~
      // Enchantment immunity and MR are the owned effect behaviors.
      LPF DELETE_EFFECT INT_VAR match_opcode = 166 END
      PATCH_IF NOT (~%original%~ STRING_EQUAL_CASE ~BDBELHI1~) BEGIN
        LPF DELETE_EFFECT INT_VAR match_opcode = 120 match_parameter2 = 0 END
        // Append to the equipped slice and move every subsequent effect index.
        READ_LONG 0x6a fx READ_SHORT 0x6e first READ_SHORT 0x70 count
        SET at_index = first + count SET at = fx + at_index * 0x30
        INSERT_BYTES at 0x30
        WRITE_SHORT at 120 WRITE_BYTE (at + 2) 1
        WRITE_BYTE (at + 12) 2 WRITE_BYTE (at + 18) 100
        WRITE_SHORT 0x70 (count + 1)
        READ_LONG 0x64 abilities READ_SHORT 0x68 ability_count
        PATCH_IF abilities >= at BEGIN
          SET abilities += 0x30 WRITE_LONG 0x64 abilities
        END
        FOR (i = 0; i < ability_count; ++i) BEGIN
          READ_SHORT (abilities + i * 0x38 + 0x20) first_ability
          PATCH_IF first_ability >= at_index BEGIN
            WRITE_SHORT (abilities + i * 0x38 + 0x20) (first_ability + 1)
          END
        END
      END
    END
  END
  LAF csr285_readable STR_VAR resource = ~BDBELHIF.CRE~ kind = ~cre~ RET readable END
  ACTION_IF readable BEGIN
  COPY_EXISTING ~BDBELHIF.CRE~ ~override~
    READ_LONG 0x2b8 slots READ_LONG 0x2bc items READ_LONG 0x2c0 count
    READ_LONG 0x2c4 fx READ_LONG 0x2c8 fc READ_BYTE 0x33 ev
    SET stride = ev ? 264 : 48
    SET writable = (slots = 0 OR slots + 80 <= SOURCE_SIZE) AND items + count * 20 <= SOURCE_SIZE AND fx + fc * stride <= SOURCE_SIZE
    PATCH_IF writable BEGIN
    PATCH_IF slots = 0 BEGIN
      SET slots = BUFFER_LENGTH INSERT_BYTES slots 80
      FOR (i = 0; i < 80; ++i) BEGIN WRITE_BYTE (slots + i) 255 END
      WRITE_LONG 0x2b8 slots
    END
    WRITE_BYTE 0x5d 60
    // Own the armor ring and two weapon slots, including an absent item record.
    DEFINE_ASSOCIATIVE_ARRAY equipment BEGIN 6 => CSR285AR 9 => CSR285W1 10 => CSR285W2 END
    PHP_EACH equipment AS slot => owned BEGIN
      READ_LONG 0x2b8 slots READ_LONG 0x2bc items READ_LONG 0x2c0 count
      READ_SHORT (slots + slot * 2) index
      PATCH_IF index >= count BEGIN
        READ_ASCII items previous_items (count * 20)
        SET items = BUFFER_LENGTH
        INSERT_BYTES items ((count + 1) * 20)
        WRITE_ASCIIE items ~%previous_items%~
        WRITE_LONG 0x2bc items WRITE_LONG 0x2c0 (count + 1)
        SET index = count
        WRITE_SHORT (slots + slot * 2) index
        WRITE_LONG (items + index * 20 + 16) 10
      END
      WRITE_ASCIIE (items + index * 20) ~%owned%~ #8
    END
    // Delete only movement records, retaining every byte of unrelated V1/V2
    // effects and repairing offsets for tables stored after them.
    READ_BYTE 0x33 effect_version
    SET effect_size = effect_version ? 0x108 : 0x30
    READ_LONG 0x2c4 effect_offset READ_LONG 0x2c8 effect_count
    PATCH_IF effect_count = 0 AND effect_offset < 0x2d4 BEGIN
      SET effect_offset = BUFFER_LENGTH WRITE_LONG 0x2c4 effect_offset
    END
    FOR (i = effect_count - 1; i >= 0; --i) BEGIN
      SET at = effect_offset + i * effect_size
      PATCH_IF effect_version BEGIN READ_LONG (at + 8) opcode END
      ELSE BEGIN READ_SHORT at opcode END
      PATCH_IF opcode = 176 BEGIN
        DELETE_BYTES at effect_size
        WRITE_LONG 0x2c8 (LONG_AT 0x2c8 - 1)
        PATCH_FOR_EACH pointer IN 0x2a0 0x2a8 0x2b0 0x2b8 0x2bc BEGIN
          READ_LONG pointer offset
          PATCH_IF offset > at BEGIN WRITE_LONG pointer (offset - effect_size) END
        END
      END
    END
    SET at = effect_offset + LONG_AT 0x2c8 * effect_size
    INSERT_BYTES at effect_size
    WRITE_LONG 0x2c8 (LONG_AT 0x2c8 + 1)
    PATCH_FOR_EACH pointer IN 0x2a0 0x2a8 0x2b0 0x2b8 0x2bc BEGIN
      READ_LONG pointer offset
      PATCH_IF offset >= at BEGIN WRITE_LONG pointer (offset + effect_size) END
    END
    PATCH_IF effect_version BEGIN
      WRITE_LONG (at + 8) 176 WRITE_LONG (at + 12) 1
      WRITE_LONG (at + 20) 125 WRITE_LONG (at + 24) 2
      WRITE_LONG (at + 28) 9 WRITE_SHORT (at + 36) 100
      WRITE_LONG (at + 0x54) 2
    END ELSE BEGIN
      WRITE_SHORT at 176 WRITE_BYTE (at + 2) 1
      WRITE_LONG (at + 4) 125 WRITE_LONG (at + 8) 2
      WRITE_BYTE (at + 12) 9 WRITE_BYTE (at + 13) 2 WRITE_BYTE (at + 18) 100
    END

    END ELSE BEGIN PATCH_PRINT ~#285: BDBELHIF tables are unreadable; only this creature is unchanged.~ END
  BUT_ONLY
  END

  LAF csr285_make_hp_spell INT_VAR bonus=50 STR_VAR ref=~CSR285H2~ END
  LAF csr285_make_hp_spell INT_VAR bonus=100 STR_VAR ref=~CSR285H3~ END
  LAF csr285_make_hp_spell INT_VAR bonus=125 STR_VAR ref=~CSR285H4~ END
  LAF csr285_make_hp_spell INT_VAR bonus=150 STR_VAR ref=~CSR285H5~ END

  ACTION_DEFINE_ASSOCIATIVE_ARRAY csr285_devils BEGIN
    1 => BDABIGRE  2 => BDABIRED  3 => BDERINYE  4 => BDBONEFI
  END
  ACTION_PHP_EACH csr285_devils AS slot => donor BEGIN
    LAF csr285_readable STR_VAR resource = EVAL ~%donor%.CRE~ kind = ~cre~ RET readable END
    OUTER_SPRINT original_ai ~~
    ACTION_IF readable BEGIN
    COPY_EXISTING ~%donor%.CRE~ ~override/CSR285D%slot%.CRE~
      READ_ASCII 0x248 original_ai (8) NULL
      WRITE_ASCIIE 0x248 ~CSR285D%slot%~ #8
      WRITE_ASCIIE 0x280 ~CSR285D%slot%~ #32
    END
    ACTION_IF NOT FILE_EXISTS_IN_GAME ~%original_ai%.BCS~ BEGIN
      COPY ~.../csr285die.baf~ ~weidu_external/chriz-sod-remix/csr285d%slot%.baf~
      COMPILE ~weidu_external/chriz-sod-remix/csr285d%slot%.baf~
    END ELSE BEGIN
      COPY_EXISTING ~%original_ai%.BCS~ ~override/CSR285D%slot%.BCS~
      EXTEND_TOP ~CSR285D%slot%.BCS~ ~.../csr285die.baf~
    END
  END
  COPY ~chriz-sod-remix/baf/csr285ar.baf~ ~weidu_external/chriz-sod-remix/csr285ar.baf~
    READ_ASCII 0 arena (BUFFER_LENGTH)
  LAF csr_ensure_script STR_VAR script = ~BD4700~ END
  COPY_EXISTING ~BD4700.BCS~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      LPF csr_replace_script_blocks INT_VAR in_place = 1
        STR_VAR pattern = ~"BD_BELH_ALLIES"~ replacement = EVAL ~%arena%~ END
    END
  COPY ~chriz-sod-remix/baf/csr285iv.baf~ ~weidu_external/chriz-sod-remix/csr285iv.baf~
    READ_ASCII 0 invisibility (BUFFER_LENGTH)
  LAF csr_ensure_script STR_VAR script = ~BDBELHIF~ END
  COPY_EXISTING ~BDBELHIF.BCS~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      // Remove the retired opener and reinforcement blocks, including duplicates.
      LPF csr_replace_script_blocks STR_VAR pattern = ~"BD_Dispel"\|ForceSpell(\[PC\],WIZARD_TRUE_DISPEL_MAGIC)\|!GlobalTimerNotExpired("BD_Gate"~ END
      LPF csr_replace_script_blocks INT_VAR in_place = 1
        STR_VAR pattern = ~"BD_IInv"\|"CSR285_INVIS"~ replacement = EVAL ~%invisibility%~ END
      LPF csr_replace_script_blocks STR_VAR pattern = ~"CSR285_INIT"\|"CSR285_COMBAT"~ END
    END
  LAF csr285_build_boss_prefix RET csr285_boss_prefix END
  COPY ~.../csr285bel.baf~ ~weidu_external/chriz-sod-remix/csr285bel.baf~ EVALUATE_BUFFER
  EXTEND_TOP ~BDBELHIF.BCS~ ~weidu_external/chriz-sod-remix/csr285bel.baf~
END
