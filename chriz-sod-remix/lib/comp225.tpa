// The pool's owned click behavior is complete and independent of the retired
// visions. The pedestal puzzle and its original reward remain in their blocks.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
LOAD_TRA ~chriz-sod-remix/languages/english/csr225om.tra~
LAF csr_ensure_script STR_VAR script = ~bdodscry~ END
COPY_EXISTING ~bdodscry.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks STR_VAR pattern = ~"CSR_SCRY_DONE"\|^[ %TAB%]+Global("BD_SDDD12_CLOUDY"\|ActionOverride("BDSCRY",StartDialogNoSet(LastTrigger))\|TakePartyItem("BDMISC59")~ END
  END
BUT_ONLY
EXTEND_TOP ~bdodscry.bcs~ ~chriz-sod-remix/baf/csr225om.baf~
LAF csr_disable_bdscry_picker_route STR_VAR csr_scry_flag = ~bd_sddd12_imoen~ csr_scry_component = ~225~ END
LAF csr_disable_bdscry_picker_route STR_VAR csr_scry_flag = ~bd_sddd12_caelar~ csr_scry_component = ~225~ END

// The sarcophagus owns one scepter and the rehomed Essence. Preserve unrelated
// contents, including their raw item metadata; create the target if absent.
ACTION_IF FILE_EXISTS_IN_GAME ~bd1200.are~ BEGIN
  COPY_EXISTING ~bd1200.are~ ~override~
    SET writable = SOURCE_SIZE >= 0xf4
    PATCH_IF writable BEGIN
      READ_LONG 0x54 ao READ_SHORT 0x58 ac READ_LONG 0x70 co READ_SHORT 0x74 cc
      READ_SHORT 0x76 ic READ_LONG 0x78 io READ_LONG 0x7c vo READ_SHORT 0x80 vc
      SET writable = ao + ac * 0x110 <= SOURCE_SIZE AND co + cc * 0xc0 <= SOURCE_SIZE AND io + ic * 20 <= SOURCE_SIZE AND vo + vc * 4 <= SOURCE_SIZE
      FOR (i = 0; writable AND i < cc; ++i) BEGIN
        READ_LONG (co + i * 0xc0 + 0x40) first READ_LONG (co + i * 0xc0 + 0x44) count
        SET writable = first + count <= ic
      END
    END
    PATCH_IF writable BEGIN
      SET target = (0 - 1) SET first = 0 SET count = 0
      FOR (i = 0; i < cc; ++i) BEGIN
        SET at = co + i * 0xc0 READ_ASCII at name (32) NULL
        PATCH_IF ~%name%~ STRING_EQUAL_CASE ~Sarcophagus01~ AND target < 0 BEGIN SET target = i END
      END
      SPRINT run ~~ SET total = 0 SET scepter = 0
      PATCH_IF target >= 0 BEGIN
        READ_LONG (co + target * 0xc0 + 0x40) first READ_LONG (co + target * 0xc0 + 0x44) count
        FOR (j = 0; j < count; ++j) BEGIN
          READ_ASCII (io + (first + j) * 20) res (8) NULL
          PATCH_IF NOT (~%res%~ STRING_EQUAL_CASE ~BDMISC59~) AND (NOT (~%res%~ STRING_EQUAL_CASE ~BDMISC55~) OR NOT scepter) BEGIN
            READ_ASCII (io + (first + j) * 20) item (20) SPRINT run ~%run%%item%~ SET total += 1
          END
          PATCH_IF ~%res%~ STRING_EQUAL_CASE ~BDMISC55~ BEGIN SET scepter = 1 END
        END
      END
      PATCH_IF NOT scepter BEGIN
        INNER_PATCH_SAVE item ~~ BEGIN INSERT_BYTES 0 20 WRITE_ASCII 0 ~BDMISC55~ #8 END
        SPRINT run ~%run%%item%~ SET total += 1
      END
      INNER_PATCH_SAVE item ~~ BEGIN INSERT_BYTES 0 20 WRITE_ASCII 0 ~BDMISC59~ #8 END
      SPRINT run ~%run%%item%~ SET total += 1
      SET shared = 0
      FOR (i = 0; i < cc; ++i) BEGIN
        READ_LONG (co + i * 0xc0 + 0x40) other_first READ_LONG (co + i * 0xc0 + 0x44) other_count
        PATCH_IF i != target AND other_count AND count AND first < other_first + other_count AND other_first < first + count BEGIN SET shared = 1 END
      END
      SET append = shared OR total > count
      SET writable = (NOT append OR ic + total <= 65535) AND (target >= 0 OR (cc < 65535 AND vc <= 65515))
      PATCH_IF writable BEGIN
        PATCH_IF target < 0 BEGIN
          READ_ASCII co entries (cc * 0xc0)
          SET co = BUFFER_LENGTH INSERT_BYTES co ((cc + 1) * 0xc0)
          WRITE_ASCIIE co ~%entries%~ WRITE_LONG 0x70 co WRITE_SHORT 0x74 (cc + 1)
          SET target = cc SET at = co + cc * 0xc0
          WRITE_ASCII at ~Sarcophagus01~ #32
          WRITE_SHORT (at + 0x20) 2414 WRITE_SHORT (at + 0x22) 1736 WRITE_SHORT (at + 0x24) 8
          WRITE_SHORT (at + 0x38) 2329 WRITE_SHORT (at + 0x3a) 1583 WRITE_SHORT (at + 0x3c) 2397 WRITE_SHORT (at + 0x3e) 1701
          WRITE_LONG (at + 0x50) vc WRITE_SHORT (at + 0x54) 20
          READ_ASCII vo vertices (vc * 4)
          SET vo = BUFFER_LENGTH INSERT_BYTES vo ((vc + 20) * 4)
          WRITE_ASCIIE vo ~%vertices%~ WRITE_LONG 0x7c vo WRITE_SHORT 0x80 (vc + 20)
          DEFINE_ASSOCIATIVE_ARRAY csr225_poly BEGIN
            0,2344 => 1701 1,2375 => 1693 2,2380 => 1692 3,2380 => 1690 4,2397 => 1672
            5,2397 => 1665 6,2394 => 1663 7,2394 => 1601 8,2397 => 1597 9,2397 => 1592
            10,2393 => 1592 11,2388 => 1595 12,2386 => 1596 13,2371 => 1583 14,2333 => 1601
            15,2329 => 1608 16,2329 => 1676 17,2345 => 1689 18,2345 => 1691 19,2343 => 1692
          END
          PHP_EACH csr225_poly AS point => y BEGIN
            WRITE_SHORT (vo + (vc + point_0) * 4) point_1 WRITE_SHORT (vo + (vc + point_0) * 4 + 2) y
          END
        END
        SET at = co + target * 0xc0
        WRITE_SHORT (at + 0x26) 0 WRITE_LONG (at + 0x28) 0 WRITE_SHORT (at + 0x30) 0
        WRITE_ASCII (at + 0x48) ~~ #8 WRITE_ASCII (at + 0x78) ~~ #8
        PATCH_IF append BEGIN
          READ_ASCII io old_items (ic * 20)
          SET io = BUFFER_LENGTH INSERT_BYTES io ((ic + total) * 20)
          WRITE_ASCIIE io ~%old_items%~ WRITE_LONG 0x78 io WRITE_SHORT 0x76 (ic + total)
          SET first = ic
        END
        WRITE_ASCIIE (io + first * 20) ~%run%~ WRITE_LONG (at + 0x40) first WRITE_LONG (at + 0x44) total
        FOR (i = 0; i < ac; ++i) BEGIN
          SET at = ao + i * 0x110 READ_ASCII at name (32) NULL
          PATCH_IF ~%name%~ STRING_EQUAL_CASE ~IMBUED_WIGHT_POTION~ BEGIN WRITE_LONG (at + 0x40) 0 END
        END
      END ELSE BEGIN PATCH_PRINT ~#225: BD1200 has no representable table space for the reward; only this area is unchanged.~ END
    END ELSE BEGIN PATCH_PRINT ~#225: BD1200 tables are unreadable; only this area is unchanged.~ END
  BUT_ONLY
END ELSE BEGIN PRINT ~#225: BD1200 is absent; the other pool changes still apply.~ END
