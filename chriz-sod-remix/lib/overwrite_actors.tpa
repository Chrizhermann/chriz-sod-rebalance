// Address native actor records by their script-name label and occurrence within
// that label. This distinguishes kept and cut actors sharing a label without
// testing a creature build, coordinate, schedule or expected match count.
DEFINE_ACTION_FUNCTION csr_write_area_actors STR_VAR area = ~~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%area%.are~ BEGIN
    COPY_EXISTING ~%area%.are~ ~override~
      SET readable = SOURCE_SIZE >= 0x5a
      PATCH_IF readable BEGIN READ_LONG 0x54 ao READ_SHORT 0x58 ac SET readable = ao + ac * 272 <= SOURCE_SIZE END
      PATCH_IF readable BEGIN
        PHP_EACH csr_actor_fields AS row => unused BEGIN
          SPRINT name ~%row_0%~ SET ordinal = row_1 SET target = (0 - 1) SET occurrence = 0
          FOR (i = 0; i < ac; ++i) BEGIN
            READ_ASCII (ao + i * 272) current (32) NULL
            PATCH_IF ~%current%~ STRING_EQUAL_CASE ~%name%~ BEGIN
              SET occurrence += 1
              PATCH_IF occurrence = ordinal BEGIN SET target = i END
            END
            PATCH_IF ~%row_7%~ STRING_COMPARE ~~ != 0 AND ~%current%~ STRING_EQUAL_CASE ~%row_7%~ BEGIN SET target = i END
          END
          PATCH_IF row_2 = 1 BEGIN
            // Removing an already absent actor is complete.
            PATCH_IF target >= 0 BEGIN WRITE_LONG (ao + target * 272 + 64) 0 END
          END ELSE BEGIN
            PATCH_IF target < 0 AND ac < 65535 BEGIN
              INNER_ACTION BEGIN COPY - ~%row_6%~ ~.../csr-actor-read~ READ_ASCII 0 actor (SOURCE_SIZE) END
              READ_ASCII ao entries (ac * 272) SET ao = BUFFER_LENGTH
              INSERT_BYTES ao ((ac + 1) * 272) WRITE_ASCIIE ao ~%entries%%actor%~
              WRITE_LONG 0x54 ao SET target = ac SET ac += 1 WRITE_SHORT 0x58 ac
              WRITE_ASCIIE (ao + target * 272) ~%row_7%~ #32
            END
            PATCH_IF target >= 0 BEGIN
              SET at = ao + target * 272
              WRITE_SHORT (at + 0x20) row_3 WRITE_SHORT (at + 0x22) row_4
              WRITE_SHORT (at + 0x24) row_3 WRITE_SHORT (at + 0x26) row_4
              WRITE_SHORT (at + 0x34) row_5
            END ELSE BEGIN PATCH_PRINT ~SoD Remix: %area% has no representable actor slot for %name%; this actor is unavailable.~ END
          END
        END
      END ELSE BEGIN PATCH_PRINT ~SoD Remix: %area% actor table is unreadable; only this table is unchanged.~ END
    BUT_ONLY
  END ELSE BEGIN PRINT ~SoD Remix: %area% is absent; other component resources are still written.~ END
END
