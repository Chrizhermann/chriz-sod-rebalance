<<<<<<<< .../csrskask.baf
IF
  Global("CSR_SKIP_CHOICE","GLOBAL",0)
  Global("CSR_SKIP_OFFER","GLOBAL",1)
THEN
  RESPONSE #100
    SetGlobal("CSR_SKIP_OFFER","GLOBAL",2)
    StartDialogueNoSet(Player1)
END
IF
  Global("CSR_SKIP_CHOICE","GLOBAL",2)
THEN
  RESPONSE #100
    DestroySelf()
END
IF
  Global("CSR_SKIP_CHOICE","GLOBAL",1)
  Global("CSR_SKIP_PHASE","GLOBAL",0)
THEN
  RESPONSE #100
    SetGlobal("CSR_SKIP_PHASE","GLOBAL",1)
    EndCutSceneMode()
    SetCutSceneLite(TRUE)
    FadeToColor([1.0],0)
    RealSetGlobalTimer("CSR_SKIP_PROGRESS","GLOBAL",15)
END
%csr910_imoen_baf%
IF
  Global("CSR_SKIP_PHASE","GLOBAL",1)
  Global("CSR_SKIP_FAILED","GLOBAL",0)
  Global("CSR_IMOEN_IMPORT","GLOBAL",1)
  !InPartyAllowDead("IMOEN2")
  InMyArea("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_SKIP_PHASE","GLOBAL",2)
    ActionOverride("PlayerChest00",TakeCreatureItems("IMOEN2",ALL))
END
IF
  Global("CSR_SKIP_PHASE","GLOBAL",1)
  Global("CSR_SKIP_FAILED","GLOBAL",0)
THEN
  RESPONSE #100
    SetGlobal("CSR_SKIP_PHASE","GLOBAL",2)
END
IF
  Global("CSR_SKIP_PHASE","GLOBAL",2)
  Global("CSR_SKIP_FAILED","GLOBAL",0)
THEN
  RESPONSE #100
    SetGlobal("CSR_SKIP_PHASE","GLOBAL",5)
    MoveContainerContents("BD0103*PlayerChest00","BD6100*K#ImportContainer")
    SetGlobal("bd_finale","BD6100",6)
    ActionOverride(Player2,LeaveAreaLUA("BD6100","",[695.745],SW))
    ActionOverride(Player3,LeaveAreaLUA("BD6100","",[695.825],SW))
    ActionOverride(Player4,LeaveAreaLUA("BD6100","",[745.785],SW))
    ActionOverride(Player5,LeaveAreaLUA("BD6100","",[745.865],SW))
    ActionOverride(Player6,LeaveAreaLUA("BD6100","",[795.825],SW))
    ActionOverride(Player1,LeaveAreaLUA("BD6100","",[645.785],SW))
    DestroySelf()
END
IF
  Global("CSR_SKIP_PHASE","GLOBAL",12)
  Global("CSR_SKIP_FAILED","GLOBAL",0)
  RealGlobalTimerExpired("CSR_SKIP_PROGRESS","GLOBAL")
THEN
  RESPONSE #100
    SetGlobal("CSR_SKIP_FAILED","GLOBAL",1)
    SetGlobal("CSR_SKIP_PHASE","GLOBAL",99)
    SetCutSceneLite(FALSE)
    EndCutSceneMode()
    FadeFromColor([10.0],0)
    DisplayStringHeadNoLog(Player1,@11)
END
