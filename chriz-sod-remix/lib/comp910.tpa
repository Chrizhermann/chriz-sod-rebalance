IF
  Global("CSR_SKIP_PHASE","GLOBAL",5)
  Global("CSR_SKIP_FAILED","GLOBAL",0)
  Exists("K#ImportContainer")
  InMyArea(Player1)
  OR(3)
    !Exists(Player2)
    Name("None",Player2)
    InMyArea(Player2)
  OR(3)
    !Exists(Player3)
    Name("None",Player3)
    InMyArea(Player3)
  OR(3)
    !Exists(Player4)
    Name("None",Player4)
    InMyArea(Player4)
  OR(3)
