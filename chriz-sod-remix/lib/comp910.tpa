<<<<<<<< .../csr910-handoff.baf
IF
  Global("CSR_SKIP_PHASE","GLOBAL",5)
  Global("CSR_SKIP_FAILED","GLOBAL",0)
  Exists("K#ImportContainer")
  InMyArea(Player1)
  OR(3)
    !Exists(Player2)
    Name("None",Player2)
    InMyArea(Player2)
  OR(3)
    !Exists(Player3)
    Name("None",Player3)
    InMyArea(Player3)
  OR(3)
    !Exists(Player4)
    Name("None",Player4)
    InMyArea(Player4)
  OR(3)
    !Exists(Player5)
    Name("None",Player5)
    InMyArea(Player5)
  OR(3)
    !Exists(Player6)
    Name("None",Player6)
    InMyArea(Player6)
THEN
  RESPONSE #100
    SetGlobal("CSR_SKIP_PHASE","GLOBAL",6)
    SetGlobal("CSR_SKIP_ITEMS_READY","GLOBAL",1)
    FadeToColor([1.0],0)
    EndCutSceneMode()
    SetCutSceneLite(TRUE)
    CreateCreatureObject("K#TELBGT",Player1,0,0,0)
    Continue()
END
IF
  Global("CSR_SKIP_PHASE","GLOBAL",5)
  !Exists("K#ImportContainer")
THEN
  RESPONSE #100
    SetGlobal("CSR_SKIP_PHASE","GLOBAL",98)
    SetGlobal("CSR_SKIP_FAILED","GLOBAL",1)
    SetCutSceneLite(FALSE)
    EndCutSceneMode()
    FadeFromColor([10.0],0)
    DisplayStringHeadNoLog(Player1,@10)
END
