// Decided encounter cuts and the chapter award. Actor addresses are labels
// plus native occurrences; builds, coordinates and schedules are not preconditions.
INCLUDE ~chriz-sod-remix/lib/comp230_lists.tpa~

INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
LAF csr_ensure_script STR_VAR script = ~bd2000~ END
COPY_EXISTING ~bd2000.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr230xp.baf~ ~.../csr230-read~ READ_ASCII 0 award (SOURCE_SIZE) END
    LPF csr_replace_script_blocks STR_VAR pattern = ~"CSR_RN_CHUNK"~ replacement = EVAL ~%award%~ END
  END
BUT_ONLY
