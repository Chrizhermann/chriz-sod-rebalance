// West spiders and their spawn/trap are removed; the bridge has no magic wall
// and gives the decided thirty-second fight window before the parley.
INCLUDE ~chriz-sod-remix/lib/comp200_lists.tpa~
ACTION_IF FILE_EXISTS_IN_GAME ~bd1000.are~ BEGIN
  COPY_EXISTING ~bd1000.are~ ~override~
    PATCH_IF SOURCE_SIZE >= 0x68 BEGIN
      READ_LONG 0x60 off READ_LONG 0x64 count
      PATCH_IF off + count * 200 <= SOURCE_SIZE BEGIN
        FOR (i = 0; i < count; ++i) BEGIN
          SET at = off + i * 200 READ_ASCII at name (32) NULL
          PATCH_IF ~%name%~ STRING_EQUAL_CASE ~Spiders02~ BEGIN WRITE_SHORT (at + 0x74) 0 END
        END
      END ELSE BEGIN PATCH_PRINT ~#200: unreadable spawn table; only these spawn records are unchanged.~ END
      READ_LONG 0x5c off READ_SHORT 0x5a count
      PATCH_IF off + count * 196 <= SOURCE_SIZE BEGIN
        FOR (i = 0; i < count; ++i) BEGIN
          SET at = off + i * 196 READ_ASCII at name (32) NULL
          PATCH_IF ~%name%~ STRING_EQUAL_CASE ~Trap_web02~ BEGIN WRITE_SHORT (at + 0x6c) 0 END
        END
      END ELSE BEGIN PATCH_PRINT ~#200: unreadable trap table; only these trap records are unchanged.~ END
    END
  BUT_ONLY
END
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
OUTER_SET csr200_shift = 0
ACTION_IF GAME_IS ~eet~ BEGIN OUTER_SET csr200_shift = 200000 END
OUTER_SET csr200_line1 = 64918 + csr200_shift OUTER_SET csr200_line2 = 60189 + csr200_shift
LAF csr_ensure_script STR_VAR script = ~bdcut14~ END
COPY_EXISTING ~bdcut14.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr200-bridge.baf~ ~.../csr200-read~ READ_ASCII 0 bridge (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_caelar_timer"\|"force_wall_door"\|"bdwforce"~ replacement = EVAL ~%bridge%~ END
  END
BUT_ONLY
