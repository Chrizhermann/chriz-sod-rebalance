// Own the dead-magic loop and its area/companion commentary. Removing these
// blocks never depends on their timers, action order, text or multiplicity.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
ACTION_IF FILE_EXISTS_IN_GAME ~BD0063.BCS~ BEGIN
  COPY_EXISTING ~BD0063.BCS~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      LPF csr_replace_script_blocks
        STR_VAR pattern = ~AntimagicTimer\|DEAD_MAGIC_AREA\|BD_String\|BD_NPC01~
      END
    END
  BUT_ONLY
END ELSE BEGIN
  PRINT ~SoD Remix #135: BD0063.BCS is absent; the assassin encounter is unavailable.~
END
