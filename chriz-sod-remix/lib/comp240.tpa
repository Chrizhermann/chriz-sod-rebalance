// Forest of Wyrms: the approved named enemies are absent, and the dragon
// cave and temple connect directly. Other actors and area records are retained.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
ACTION_CLEAR_ARRAY csr_cut_bd7200
ACTION_CLEAR_ARRAY csr_cut_bd7230
INCLUDE ~chriz-sod-remix/lib/comp240_lists.tpa~

DEFINE_PATCH_MACRO csr240_cut_actors BEGIN
  FOR (i = 0; i < ac; ++i) BEGIN
    SET at = ao + i * 0x110 READ_ASCII at name (32) NULL TO_UPPER name
    SET cut = 0
    PATCH_IF ~%area%~ STRING_EQUAL ~bd7200~ BEGIN
      PATCH_IF VARIABLE_IS_SET $csr_cut_bd7200(~%name%~) BEGIN SET cut = 1 END
    END ELSE BEGIN
      PATCH_IF VARIABLE_IS_SET $csr_cut_bd7230(~%name%~) BEGIN SET cut = 1 END
    END
    PATCH_IF cut BEGIN WRITE_LONG (at + 0x40) 0 END
  END
END

ACTION_FOR_EACH area IN ~bd7200~ ~bd7230~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%area%.are~ BEGIN
    COPY_EXISTING ~%area%.are~ ~override~
      SET writable = SOURCE_SIZE >= 0x5a
      PATCH_IF writable BEGIN
        READ_LONG 0x54 ao READ_SHORT 0x58 ac
        SET writable = ao + ac * 0x110 <= SOURCE_SIZE
      END
      PATCH_IF writable BEGIN LPM csr240_cut_actors END
      ELSE BEGIN PATCH_PRINT ~#240: %area% actor table is unreadable; only this table is unchanged.~ END
    BUT_ONLY
  END ELSE BEGIN PRINT ~#240: %area% is absent; its removed actors are already unavailable.~ END
END

ACTION_FOR_EACH area IN ~bd7210~ ~bd7230~ BEGIN
  OUTER_SPRINT destination ~BD7230~
  OUTER_SET entrance_x = 1626 OUTER_SET entrance_y = 1259 OUTER_SET entrance_face = 7
  OUTER_SET use_x = 1845 OUTER_SET use_y = 1374
  OUTER_SET left = 1665 OUTER_SET top = 1239 OUTER_SET right = 1909 OUTER_SET bottom = 1494
  ACTION_CLEAR_ARRAY csr240_polygon
  ACTION_DEFINE_ASSOCIATIVE_ARRAY csr240_polygon BEGIN 0,1755 => 1275 1,1665 => 1410 2,1909 => 1494 3,1909 => 1239 END
  ACTION_IF ~%area%~ STRING_EQUAL ~bd7230~ BEGIN
    OUTER_SPRINT destination ~BD7210~
    OUTER_SET entrance_x = 1578 OUTER_SET entrance_y = 589 OUTER_SET entrance_face = 14
    OUTER_SET use_x = 1460 OUTER_SET use_y = 543
    OUTER_SET left = 1222 OUTER_SET top = 333 OUTER_SET right = 1544 OUTER_SET bottom = 611
    ACTION_CLEAR_ARRAY csr240_polygon
    ACTION_DEFINE_ASSOCIATIVE_ARRAY csr240_polygon BEGIN 0,1464 => 611 1,1544 => 437 2,1342 => 333 3,1222 => 542 END
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~%area%.are~ BEGIN
    COPY_EXISTING ~%area%.are~ ~override~
      SET writable = SOURCE_SIZE >= 0x84
      PATCH_IF writable BEGIN
        READ_SHORT 0x5a rc READ_LONG 0x5c ro READ_LONG 0x68 eo READ_LONG 0x6c ec
        READ_LONG 0x7c vo READ_SHORT 0x80 vc
        SET writable = ro + rc * 0xc4 <= SOURCE_SIZE AND eo + ec * 0x68 <= SOURCE_SIZE AND vo + vc * 4 <= SOURCE_SIZE
      END
      PATCH_IF writable BEGIN
        SET entrance = 0
        FOR (i = 0; i < ec; ++i) BEGIN
          READ_ASCII (eo + i * 0x68) name (32) NULL
          PATCH_IF ~%name%~ STRING_EQUAL_CASE ~ExitBD7220~ BEGIN SET entrance = 1 END
        END
        PATCH_IF NOT entrance BEGIN
          READ_ASCII eo entries (ec * 0x68)
          SET eo = BUFFER_LENGTH INSERT_BYTES eo ((ec + 1) * 0x68)
          WRITE_ASCIIE eo ~%entries%~ WRITE_LONG 0x68 eo WRITE_LONG 0x6c (ec + 1)
          SET at = eo + ec * 0x68
          WRITE_ASCII at ~ExitBD7220~ #32
          WRITE_SHORT (at + 32) entrance_x WRITE_SHORT (at + 34) entrance_y WRITE_SHORT (at + 36) entrance_face
        END
        SET region = 0
        FOR (i = 0; i < rc; ++i) BEGIN
          SET at = ro + i * 0xc4 READ_ASCII at name (32) NULL
          PATCH_IF ~%name%~ STRING_EQUAL_CASE ~TranBD7220~ BEGIN
            WRITE_SHORT (at + 0x20) 2
            WRITE_ASCIIE (at + 0x38) ~%destination%~ #8
            WRITE_ASCII (at + 0x40) ~ExitBD7220~ #32
            WRITE_LONG (at + 0x60) (LONG_AT (at + 0x60) BAND (BNOT 0x100))
            SET region = 1
          END
        END
        PATCH_IF NOT region BEGIN
          READ_ASCII ro entries (rc * 0xc4)
          SET ro = BUFFER_LENGTH INSERT_BYTES ro ((rc + 1) * 0xc4)
          WRITE_ASCIIE ro ~%entries%~ WRITE_LONG 0x5c ro WRITE_SHORT 0x5a (rc + 1)
          SET at = ro + rc * 0xc4
          WRITE_ASCII at ~TranBD7220~ #32 WRITE_SHORT (at + 0x20) 2
          WRITE_SHORT (at + 0x22) left WRITE_SHORT (at + 0x24) top
          WRITE_SHORT (at + 0x26) right WRITE_SHORT (at + 0x28) bottom
          WRITE_SHORT (at + 0x2a) 4 WRITE_LONG (at + 0x2c) vc
          WRITE_ASCIIE (at + 0x38) ~%destination%~ #8 WRITE_ASCII (at + 0x40) ~ExitBD7220~ #32
          WRITE_LONG (at + 0x60) 1540 WRITE_LONG (at + 0x64) 0xffffffff
          WRITE_SHORT (at + 0x84) use_x WRITE_SHORT (at + 0x86) use_y
          READ_ASCII vo vertices (vc * 4)
          SET vo = BUFFER_LENGTH INSERT_BYTES vo ((vc + 4) * 4)
          WRITE_ASCIIE vo ~%vertices%~ WRITE_LONG 0x7c vo WRITE_SHORT 0x80 (vc + 4)
          PHP_EACH csr240_polygon AS vertex => y BEGIN
            WRITE_SHORT (vo + (vc + vertex_0) * 4) vertex_1 WRITE_SHORT (vo + (vc + vertex_0) * 4 + 2) y
          END
        END
      END ELSE BEGIN PATCH_PRINT ~#240: %area% travel tables are unreadable; only this file is unchanged.~ END
    BUT_ONLY
  END ELSE BEGIN PRINT ~#240: %area% is absent; the other forest changes still apply.~ END
END

LAF csr_ensure_script STR_VAR script = ~BD7230~ END
MKDIR ~weidu_external/work/chriz-sod-remix/240~
COPY ~chriz-sod-remix/baf/csr240xp.baf~ ~weidu_external/work/chriz-sod-remix/240/xp.baf~
  EVALUATE_BUFFER READ_ASCII 0 award (BUFFER_LENGTH)
COPY_EXISTING ~BD7230.BCS~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks STR_VAR pattern = ~"CSR_FOW_CHUNK"~ replacement = EVAL ~%award%~ END
  END
BUT_ONLY
