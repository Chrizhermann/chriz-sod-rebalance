<<<<<<<< .../csr198-cameos.d
REPLACE_STATE_TRIGGER ~BDFRITZ~ 0 ~%csr198_fritz_root%
Global("CSR198_TIAX_JOINED","GLOBAL",0)~

// The skipped argument cannot remain a player recollection or a reason to
// recruit Safana, especially now that Coran can accompany her. Preserve the
// native join actions, interjections and the ordinary persuasion choices.
REPLACE_SAY ~BDSAFANA~ 69 ~Very well. A change of scenery would do me good. I'm with you.~
REPLACE_SAY ~BDSAFANA~ 71 ~Very well. A change of scenery would do me good. I'm with you.~

// State 60 is the not-yet-joined city recruitment hub. The removed opening
// used to set this marker; successful native join actions still advance it
// to 2. Retain the city conversation counter even if the player declines.
%csr198_safana_join%
>>>>>>>>
LAF csr_ensure_dlg_states INT_VAR count = 1 STR_VAR dialog = ~BDFRITZ~ END
LAF csr_ensure_dlg_states INT_VAR count = 72 STR_VAR dialog = ~BDSAFANA~ END
OUTER_SPRINT csr198_fritz_root ~~
COPY_EXISTING - ~BDFRITZ.DLG~ ~override~
  READ_LONG 0x0c states READ_SLONG (states + 12) trigger
  READ_LONG 0x18 table READ_LONG 0x1c count
  PATCH_IF trigger >= 0 AND trigger < count BEGIN
    READ_LONG (table + trigger * 8) text READ_LONG (table + trigger * 8 + 4) length
    READ_ASCII text csr198_fritz_root (length)
    INNER_PATCH_SAVE csr198_fritz_root ~%csr198_fritz_root%~ BEGIN
      REPLACE_TEXTUALLY CASE_INSENSITIVE ~Global("CSR198_TIAX_JOINED","GLOBAL",[-0-9]+)[ %TAB%%WNL%]*~ ~~
    END
  END
OUTER_SPRINT csr198_safana_join ~~
COPY_EXISTING - ~BDSAFANA.DLG~ ~override~
  READ_LONG 0x0c states READ_LONG 0x14 transitions
  READ_LONG 0x28 actions READ_LONG 0x2c action_count
  READ_LONG (states + 60 * 16 + 4) first READ_LONG (states + 60 * 16 + 8) count
  FOR (reply = 0; reply < count; ++reply) BEGIN
    SET at = transitions + (first + reply) * 32
    READ_LONG at flags READ_LONG (at + 16) action
    SPRINT body ~~
    PATCH_IF (flags BAND 4) AND action < action_count BEGIN
      READ_LONG (actions + action * 8) text READ_LONG (actions + action * 8 + 4) length
      READ_ASCII text body (length)
      INNER_PATCH_SAVE body ~%body%~ BEGIN
        REPLACE_TEXTUALLY CASE_INSENSITIVE ~SetGlobal("BD_Spoken_Safana","GLOBAL",[-0-9]+)[ %TAB%%WNL%]*~ ~~
      END
    END
    SPRINT csr198_safana_join ~~~~~%csr198_safana_join%
ALTER_TRANS ~BDSAFANA~ BEGIN 60 END BEGIN %reply% END BEGIN
  ~ACTION~ ~%body%
SetGlobal("BD_Spoken_Safana","GLOBAL",1)~
END
~~~~~
  END
COPY_EXISTING - ~BDSAFANA.DLG~ ~override~
  READ_LONG 0x0c states
  READ_LONG (states + 63 * 16 + 8) replies
// An absent reply is already removed. Existing recollection replies are disabled.
OUTER_FOR (reply = 1; reply < replies AND reply < 3; ++reply) BEGIN
  COMPILE EVALUATE_BUFFER ~.../csr198-disable-recollection.d~
END
COMPILE EVALUATE_BUFFER ~.../csr198-cameos.d~

