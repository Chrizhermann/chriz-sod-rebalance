INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
// #198: replace the three city cameos with the shared recruitment system.
// The saved party actor wins. Never remove a currently/previously recruited
// BDCORAN, BDGARRIC or BDTIAX: those aliases can be adopted by the dispatcher.

DEFINE_PATCH_FUNCTION csr198_cameo_replace
  INT_VAR expected = 1
  STR_VAR pattern = ~~ replacement = ~~ context = ~~
BEGIN
  REPLACE_TEXTUALLY CASE_INSENSITIVE ~%pattern%~ ~%replacement%~
END

<<<<<<<< .../csr198-cameo.baf
IF
  InMyArea("%csr198_cameo%")
  !InPartyAllowDead("%csr198_cameo%")
  !BeenInParty("%csr198_cameo%")
THEN
  RESPONSE #100
    ActionOverride("%csr198_cameo%",DestroySelf())
    Continue()
END
>>>>>>>>

ACTION_FOR_EACH csr198_cameo IN ~BDCORAN~ ~BDGARRIC~ ~BDTIAX~ BEGIN
  ACTION_IF (~%csr198_cameo%~ STRING_EQUAL_CASE ~BDCORAN~) BEGIN
    OUTER_SPRINT csr198_cameo_area ~BD0110~
    OUTER_SPRINT csr198_cameo_actor ~Coran~
  END ELSE ACTION_IF (~%csr198_cameo%~ STRING_EQUAL_CASE ~BDGARRIC~) BEGIN
    OUTER_SPRINT csr198_cameo_area ~BD0109~
    OUTER_SPRINT csr198_cameo_actor ~Garrick~
  END ELSE BEGIN
    OUTER_SPRINT csr198_cameo_area ~BD0104~
    OUTER_SPRINT csr198_cameo_actor ~Tiax~
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~%csr198_cameo_area%.are~ BEGIN
  COPY_EXISTING ~%csr198_cameo_area%.are~ ~override~
    PATCH_IF SOURCE_SIZE >= 0x5a BEGIN
    READ_LONG 0x54 csr198_actors
    READ_SHORT 0x58 csr198_actor_count
    FOR (csr198_actor = 0; csr198_actor < csr198_actor_count AND csr198_actors + (csr198_actor + 1) * 0x110 <= SOURCE_SIZE; ++csr198_actor) BEGIN
      SET csr198_record = csr198_actors + csr198_actor * 0x110
      READ_ASCII csr198_record csr198_actor_name (32) NULL
      PATCH_IF (~%csr198_actor_name%~ STRING_EQUAL_CASE ~%csr198_cameo_actor%~) BEGIN
        WRITE_LONG (csr198_record + 0x40) 0
      END
    END
    END ELSE BEGIN PATCH_PRINT ~#198: unreadable cameo area; its actor schedule is unchanged.~ END
  BUT_ONLY
  END ELSE BEGIN PRINT ~#198: cameo area %csr198_cameo_area% is absent.~ END
  COPY_EXISTING ~%csr198_cameo_area%.bcs~ ~override~ DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks STR_VAR pattern = EVAL ~ActionOverride("%csr198_cameo%",DestroySelf())~ END
  END BUT_ONLY
  // Schedule edits cover new area loads; this covers an already visited area.
  EXTEND_TOP ~%csr198_cameo_area%.bcs~ ~.../csr198-cameo.baf~ EVALUATE_BUFFER
END

COPY_EXISTING ~bd0110.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    // Preserve both Safana spawn branches and #110's in-party skip. Replace
    // only the argument block, whose ending targets Coran directly. The
    // separate argument global must also reach 2 or Safana's click dialogue
    // selects state 18 and tries to speak to the removed cameo.
    LPF csr_replace_script_blocks
      STR_VAR pattern = ~StartDialogNoSet("BDCORAN")\|"bd_safana_argument"~
        replacement = ~IF
  Global("BD_SPAWN_SAFANA","BD0110",1)
  CombatCounter(0)
THEN
  RESPONSE #100
    SetGlobal("BD_SPAWN_SAFANA","BD0110",2)
    SetGlobal("bd_safana_argument","BD0110",2)
END

~
    END
  END
BUT_ONLY

<<<<<<<< .../csr198-safana.baf
IF
  Global("BD_SPAWN_SAFANA","BD0110",2)
  GlobalLT("bd_safana_argument","BD0110",2)
THEN
  RESPONSE #100
    SetGlobal("bd_safana_argument","BD0110",2)
    Continue()
END
>>>>>>>>
EXTEND_TOP ~bd0110.bcs~ ~.../csr198-safana.baf~

COPY_EXISTING ~bd0109.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    // The adopted BDGARRIC alias is a companion, not an actor the tavern may
    // silence or turn hostile. Keep every other staff/crowd action intact.
    LPF csr_replace_script_blocks STR_VAR pattern = ~SetGlobal("BD_Garrick_Play","BD0109",6)~ END
    LPF csr198_cameo_replace
      STR_VAR pattern = ~ActionOverride("BDGARRIC",DialogueInterrupt(FALSE))~
        context = ~Garrick initial conversation lock~
    END
    LPF csr198_cameo_replace
      STR_VAR pattern = ~ActionOverride("BDGARRIC",Enemy())~
        context = ~Garrick tavern hostility~
    END
  END
BUT_ONLY

<<<<<<<< .../csr198-garrick.baf
IF
  Global("BD_Garrick_Play","BD0109",0)
THEN
  RESPONSE #100
    SetGlobal("BD_Garrick_Play","BD0109",6)
    Continue()
END
>>>>>>>>
// His personal recital is retired by the new override. Its settled marker
// lets the existing audience/crowd blocks continue their ordinary behavior.
EXTEND_TOP ~bd0109.bcs~ ~.../csr198-garrick.baf~

// Fritz grants access through the door without any permission global. Once
// Tiax joins, suppress only the repeated 'get out' nuisance; preserve Fritz's
// refugee/murder conversations and the other prisoners' stories.
LAF csr_ensure_script STR_VAR script = ~bdfritz~ END
COPY_EXISTING ~bdfritz.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks INT_VAR in_place = 1
      STR_VAR pattern = ~"BD_FRITZ_GET_OUT"~ replacement = ~IF
  See([PC])
  Global("BD_Spoken_Tiax","GLOBAL",1)
  RealGlobalTimerExpired("BD_FRITZ_GET_OUT","BD0104")
  Global("CSR198_TIAX_JOINED","GLOBAL",0)
  Global("BD_FRITZ_NO_TALK","BD0104",1)
  Range([PC],15)
THEN
  RESPONSE #100
    SmallWait(5)
    StartDialogNoSet([PC])
END
~ END
  END
BUT_ONLY

