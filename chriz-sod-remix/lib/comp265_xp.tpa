// Own the future chapter-11 payout. No catch-up award is added to existing saves.
OUTER_SET csr_xp_chunk_260 = 106800
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
OUTER_SET csr_sod_tlk_shift = 0
ACTION_IF GAME_IS ~eet~ BEGIN OUTER_SET csr_sod_tlk_shift = 200000 END
OUTER_SET csr260_str256373 = csr_sod_tlk_shift + 56373
OUTER_SET csr260_str269073 = csr_sod_tlk_shift + 69073
OUTER_SET csr260_str269074 = csr_sod_tlk_shift + 69074
OUTER_SET csr260_str269075 = csr_sod_tlk_shift + 69075
OUTER_SET csr260_str269076 = csr_sod_tlk_shift + 69076
OUTER_SET csr260_str269138 = csr_sod_tlk_shift + 69138
MKDIR ~weidu_external/work/chriz-sod-remix/260~
COPY ~chriz-sod-remix/baf/csr260award.baf~ ~weidu_external/work/chriz-sod-remix/260/award.baf~
  EVALUATE_BUFFER
  READ_ASCII 0 csr_award (BUFFER_LENGTH)
LAF csr_ensure_script STR_VAR script = ~BD4000~ END
COPY_EXISTING ~bd4000.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks INT_VAR in_place = 1
      STR_VAR pattern = ~IncrementChapter("chptxt11")~ replacement = EVAL ~%csr_award%~ END
  END
BUT_ONLY
