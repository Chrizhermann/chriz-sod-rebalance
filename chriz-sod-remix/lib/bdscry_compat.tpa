// Own the disabled routes, identified by their local once-flag. Missing routes
// are already absent; every matching trigger is disabled, in any dialogue shape.
DEFINE_ACTION_FUNCTION csr_disable_bdscry_picker_route
  STR_VAR csr_scry_flag = ~~ csr_scry_component = ~~
BEGIN
  // Only a programming error in the bundled callers can reach this branch.
  ACTION_IF (~%csr_scry_flag%~ STR_EQ ~~) BEGIN
    FAIL ~chriz-sod-remix: the scrying route flag must be supplied by its caller.~
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~bdscry.dlg~ BEGIN
    COPY_EXISTING ~bdscry.dlg~ ~override~
      SET readable = SOURCE_SIZE >= 0x30
      PATCH_IF readable BEGIN
        READ_LONG 0x08 sc READ_LONG 0x0c so READ_LONG 0x10 tc READ_LONG 0x14 tr
        SET readable = so + sc * 16 <= SOURCE_SIZE AND tr + tc * 32 <= SOURCE_SIZE
        FOR (i = 0; readable AND i < sc; ++i) BEGIN
          READ_LONG (so + i * 16 + 4) first READ_LONG (so + i * 16 + 8) count
          SET readable = first + count <= tc
        END
        PATCH_FOR_EACH header IN 0x18 0x20 0x28 BEGIN
          READ_LONG header table READ_LONG (header + 4) count
          SET readable = readable AND table + count * 8 <= SOURCE_SIZE
          FOR (i = 0; readable AND i < count; ++i) BEGIN
            READ_LONG (table + i * 8) text READ_LONG (table + i * 8 + 4) length
            SET readable = text + length <= SOURCE_SIZE
          END
        END
      END
      PATCH_IF readable BEGIN
        DECOMPILE_DLG_TO_D
        // The token boundary excludes SetGlobal actions, including resets.
        REPLACE_EVALUATE CASE_INSENSITIVE ~\(^\|[^a-zA-Z!]\)\(False()[%WNL% ]+\)*!?\(Global("%csr_scry_flag%","LOCALS",[-0-9]+)\)~ BEGIN
        END ~%MATCH1%False()
%MATCH3%~
        COMPILE_D_TO_DLG
      END ELSE BEGIN PATCH_PRINT ~#%csr_scry_component%: unreadable BDSCRY dialogue; this file is unchanged.~ END
    BUT_ONLY
  END ELSE BEGIN PRINT ~#%csr_scry_component%: BDSCRY is absent; its routes are already unavailable.~ END
END
