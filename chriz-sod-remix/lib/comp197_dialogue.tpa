// Own BDSKIE's campaign POST route. Existing JOIN/DREAM and optional cells
// belong to their current mods; a new row receives the original native defaults.
INCLUDE ~chriz-sod-remix/lib/overwrite_2da.tpa~
DEFINE_ACTION_FUNCTION csr197_install_dialogue_route BEGIN
  LAF csr_ensure_bddialog END
  COPY_EXISTING ~bddialog.2da~ ~override~
    LPF csr_set_2da_cell STR_VAR row = ~BDSKIE~ column = ~POST_DIALOG_FILE~
      value = ~BDSKIE~ new_row_default = ~***~ RET added_row END
    PATCH_IF added_row BEGIN
      LPF csr_set_2da_cell STR_VAR row = ~BDSKIE~ column = ~JOIN_DIALOG_FILE~ value = ~MULTIG~ END
      LPF csr_set_2da_cell STR_VAR row = ~BDSKIE~ column = ~DREAM_SCRIPT_FILE~ value = ~***~ END
    END
  BUT_ONLY
END
