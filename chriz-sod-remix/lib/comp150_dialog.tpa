ACTION_IF csr150_old_BDAUDAM <= 10 BEGIN
  LAF csr_dlg_state_weight INT_VAR state = 10 STR_VAR dialog = ~BDAUDAM~ RET csr150_weight = clause END
  OUTER_SPRINT csr150_fallback ~~~~~REPLACE ~BDAUDAM~
IF %csr150_weight% ~  True()
~ THEN BEGIN 10
  SAY #%csr150_ref_58134%
  IF ~~ THEN REPLY #%csr150_ref_58135%  GOTO 13
  IF ~  Global("bd_MDD009a_met_audamar","bd0101",0)
~ THEN REPLY #%csr150_ref_66841%  DO ~SetGlobal("bd_MDD009a_met_audamar","bd0101",1)
~ GOTO 11
  IF ~~ THEN REPLY #%csr150_ref_58136%  GOTO 14
  IF ~  False()
~ THEN REPLY #%csr150_ref_58137%  GOTO 14
END
END
~~~~~
  COMPILE EVALUATE_BUFFER ~.../csr150-fallback.d~
END ELSE BEGIN
  COPY_EXISTING - ~BDAUDAM.dlg~ ~override~ READ_LONG 0x0c off READ_LONG (off + 10 * 16 + 8) csr150_transitions
  ACTION_IF csr150_transitions <= 0 BEGIN
    OUTER_SPRINT csr150_seed ~~~~~%csr150_seed%
EXTEND_BOTTOM ~BDAUDAM~ 10
  IF ~~ THEN REPLY #%csr150_ref_58135%  GOTO 13
END
~~~~~
  END
  ACTION_IF csr150_transitions <= 1 BEGIN
    OUTER_SPRINT csr150_seed ~~~~~%csr150_seed%
EXTEND_BOTTOM ~BDAUDAM~ 10
  IF ~  Global("bd_MDD009a_met_audamar","bd0101",0)
~ THEN REPLY #%csr150_ref_66841%  DO ~SetGlobal("bd_MDD009a_met_audamar","bd0101",1)
~ GOTO 11
END
~~~~~
  END
  ACTION_IF csr150_transitions <= 2 BEGIN
    OUTER_SPRINT csr150_seed ~~~~~%csr150_seed%
EXTEND_BOTTOM ~BDAUDAM~ 10
  IF ~~ THEN REPLY #%csr150_ref_58136%  GOTO 14
END
~~~~~
  END
  ACTION_IF csr150_transitions <= 3 BEGIN
    OUTER_SPRINT csr150_seed ~~~~~%csr150_seed%
EXTEND_BOTTOM ~BDAUDAM~ 10
  IF ~  False()
~ THEN REPLY #%csr150_ref_58137%  GOTO 14
END
~~~~~
  END
END
COMPILE EVALUATE_BUFFER ~.../csr150-seed.d~
