// Own the one-use Insane Mislead block; keep the remaining Shadow Aspect AI.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
LAF csr_ensure_script STR_VAR script = ~BDASHIRU~ END
  COPY_EXISTING ~BDASHIRU.BCS~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      LPF csr_replace_script_blocks INT_VAR in_place = 1
        STR_VAR pattern = ~"CSR266_MISLEAD","LOCALS"\|ApplySpell(Myself,WIZARD_MISLEAD)~
          replacement = ~IF
  !StateCheck(Myself,STATE_INVISIBLE)
  Difficulty(HARDEST)
  !GlobalTimerNotExpired("bd_invis","locals")
  Global("CSR266_MISLEAD","LOCALS",0)
THEN
  RESPONSE #100
    SetGlobal("CSR266_MISLEAD","LOCALS",1)
    SetGlobalTimer("bd_invis","locals",12)
    CreateVisualEffectObject("shair",Myself)
    ApplySpell(Myself,WIZARD_MISLEAD)
END

~ END
    END
  BUT_ONLY
