// The shared victory timer is an owned field, irrespective of trigger shape.
// Other companion actions and text remain untouched.
DEFINE_PATCH_FUNCTION csr290_victory_barks
  INT_VAR csr290_normalize = 1
  RET csr290_bark_count
BEGIN
  COUNT_REGEXP_INSTANCES CASE_INSENSITIVE ~SetGlobalTimer("bd_mdd1341a_ot_timer","bd4300",[^)%WNL%]*)~ csr290_bark_count
  PATCH_IF csr290_normalize BEGIN
    REPLACE_EVALUATE CASE_INSENSITIVE ~\(SetGlobalTimer("bd_mdd1341a_ot_timer","bd4300",\)[^)%WNL%]*)~ BEGIN END ~%MATCH1%2)~
  END
END
