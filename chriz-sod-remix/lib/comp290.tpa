// 290.3 — common BCS preflight, still before any mutation
// ------------------------------------------------------------
COPY_EXISTING - ~BD4300.BCS~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    SPRINT csr290_what ~BD4300 victory timers~
    SPRINT csr290_pat ~SetGlobalTimer("bd_mdd1341a_ot_timer","bd4300",[^)]*)~
    COUNT_REGEXP_INSTANCES ~%csr290_pat%~ csr290_timer_count
    COUNT_REGEXP_INSTANCES ~Global("bd_ot2_C0Aura","bd4300",0)~ csr290_aura_count
    COUNT_REGEXP_INSTANCES ~DisplayStringHead("C0Aura",309305)~ csr290_aura_bark_count
    PATCH_IF NOT (((csr290_aura_count = 0) OR (csr290_aura_count = 1)) AND
                  (csr290_aura_bark_count = csr290_aura_count) AND
                  (csr290_timer_count = 17 + csr290_aura_count)) BEGIN
      PATCH_FAIL ~chriz-sod-remix #290 [BD4300 victory timers]: expected 17 vanilla timer setters plus zero/one exact C0Aura block; found %csr290_timer_count% setters, %csr290_aura_count% Aura trigger(s), %csr290_aura_bark_count% Aura bark(s).~
    END
    SPRINT csr290_what ~BD4300 586-to-587 timer convergence~
    SPRINT csr290_pat ~GlobalTimerExpired("bd_mdd1341a_ot_timer","bd4300")%csr290_nl%THEN%csr290_nl%  RESPONSE #100%csr290_nl%    SetGlobal("bd_plot","global",587)~
    SET csr290_expect = 1
    LAUNCH_PATCH_MACRO csr290_assert_count
    PATCH_FOR_EACH csr290_rom IN Corwin Neera BEGIN
      SPRINT csr290_what ~BD4300 %csr290_rom% Romance6 zero trigger~
      SPRINT csr290_pat ~%csr290_nl%  Global("bd_%csr290_rom%Romance6","GLOBAL",0)~
      SET csr290_expect = 1
      LAUNCH_PATCH_MACRO csr290_assert_count
      SPRINT csr290_what ~BD4300 %csr290_rom% Romance6 one trigger~
      SPRINT csr290_pat ~%csr290_nl%  Global("bd_%csr290_rom%Romance6","GLOBAL",1)~
      SET csr290_expect = 1
      LAUNCH_PATCH_MACRO csr290_assert_count
      SPRINT csr290_what ~BD4300 %csr290_rom% Romance6 setter~
      SPRINT csr290_pat ~SetGlobal("bd_%csr290_rom%Romance6","GLOBAL",1)~
      SET csr290_expect = 1
      LAUNCH_PATCH_MACRO csr290_assert_count
    END
  END
