// ============================================================
// Component 290 — short post-victory celebration and direct ending
// ============================================================
// Design: docs/plans/2026-07-16-post-victory-ending-design.md
// Contract: research/scripts/verify_ending.py

// WeiDU decompiles with CRLF on Windows and LF elsewhere. Use this in every
// line-anchored textual guard.
OUTER_SPRINT ~csr290_nl~ ~%MNL%?%LNL%~

DEFINE_PATCH_MACRO ~csr290_assert_count~ BEGIN
  COUNT_REGEXP_INSTANCES ~%csr290_pat%~ csr290_found
  PATCH_IF (csr290_found != csr290_expect) BEGIN
    PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: expected %csr290_expect% occurrence(s), found %csr290_found%. The installed resource differs from the audited ending graph; refusing to guess.~
  END
END

// Numeric .d edits are safe only while the installed DLG still has the
// audited state/transition structure. These helpers read DLG V1.0 tables
// directly so semantic guards are bound to the exact numeric targets.
DEFINE_PATCH_MACRO ~csr290_assert_dlg_state~ BEGIN
  PATCH_IF (SOURCE_SIZE < 0x34) BEGIN
    PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: resource is too short for a DLG V1.0 header (%SOURCE_SIZE% bytes).~
  END
  READ_ASCII 0x00 csr290_sig (8)
  PATCH_IF NOT (~%csr290_sig%~ STRING_EQUAL_CASE ~DLG V1.0~) BEGIN
    PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: expected a DLG V1.0 resource, found signature '%csr290_sig%'.~
  END
  READ_LONG 0x08 csr290_state_count
  READ_LONG 0x0c csr290_state_off
  READ_LONG 0x10 csr290_transition_count
  READ_LONG 0x14 csr290_transition_off
  READ_LONG 0x18 csr290_state_trigger_off
  READ_LONG 0x1c csr290_state_trigger_count
  READ_LONG 0x20 csr290_transition_trigger_off
  READ_LONG 0x24 csr290_transition_trigger_count
  READ_LONG 0x28 csr290_action_off
  READ_LONG 0x2c csr290_action_count
  PATCH_IF ((csr290_state_count < 0) OR (csr290_state_off < 0) OR
            (csr290_transition_count < 0) OR (csr290_transition_off < 0) OR
            (csr290_state_trigger_count < 0) OR (csr290_state_trigger_off < 0) OR
            (csr290_transition_trigger_count < 0) OR (csr290_transition_trigger_off < 0) OR
            (csr290_action_count < 0) OR (csr290_action_off < 0) OR
            ((csr290_state_count > 0) AND
             ((csr290_state_off < 0x34) OR
              (csr290_state_off + csr290_state_count * 0x10 > SOURCE_SIZE))) OR
            ((csr290_transition_count > 0) AND
             ((csr290_transition_off < 0x34) OR
              (csr290_transition_off + csr290_transition_count * 0x20 > SOURCE_SIZE))) OR
            ((csr290_state_trigger_count > 0) AND
             ((csr290_state_trigger_off < 0x34) OR
              (csr290_state_trigger_off + csr290_state_trigger_count * 8 > SOURCE_SIZE))) OR
            ((csr290_transition_trigger_count > 0) AND
             ((csr290_transition_trigger_off < 0x34) OR
              (csr290_transition_trigger_off + csr290_transition_trigger_count * 8 > SOURCE_SIZE))) OR
            ((csr290_action_count > 0) AND
             ((csr290_action_off < 0x34) OR
              (csr290_action_off + csr290_action_count * 8 > SOURCE_SIZE))) OR
            (csr290_state < 0) OR (csr290_state >= csr290_state_count)) BEGIN
    PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: DLG tables or state %csr290_state% are out of bounds (states %csr290_state_count%, transitions %csr290_transition_count%, size %SOURCE_SIZE%).~
  END
  SET csr290_state_base = csr290_state_off + csr290_state * 0x10
  READ_LONG (csr290_state_base + 0x04) csr290_state_first_transition
  READ_LONG (csr290_state_base + 0x08) csr290_trans_found
  PATCH_IF ((csr290_state_first_transition < 0) OR (csr290_trans_found < 0) OR
            (csr290_state_first_transition > csr290_transition_count) OR
            (csr290_trans_found > csr290_transition_count - csr290_state_first_transition)) BEGIN
    PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: state %csr290_state%'s transition run is out of bounds (first %csr290_state_first_transition%, count %csr290_trans_found%, table %csr290_transition_count%).~
  END
  PATCH_IF (csr290_trans_found != csr290_trans_expect) BEGIN
    PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: state %csr290_state% has %csr290_trans_found% transition(s), expected %csr290_trans_expect%.~
  END
END

DEFINE_PATCH_MACRO ~csr290_read_dlg_state_trigger~ BEGIN
  READ_LONG (csr290_state_base + 0x0c) csr290_state_trigger_index
  PATCH_IF ((csr290_state_trigger_index < 0) OR
            (csr290_state_trigger_index >= csr290_state_trigger_count)) BEGIN
    PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: state %csr290_state% has no valid audited state trigger (index %csr290_state_trigger_index%, table %csr290_state_trigger_count%).~
  END
  SET csr290_string_entry = csr290_state_trigger_off + csr290_state_trigger_index * 8
  READ_LONG csr290_string_entry csr290_string_off
  READ_LONG (csr290_string_entry + 4) csr290_string_len
  PATCH_IF ((csr290_string_off < 0) OR (csr290_string_len < 0) OR
            (csr290_string_off + csr290_string_len > SOURCE_SIZE)) BEGIN
    PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: state %csr290_state%'s trigger string is out of bounds (offset %csr290_string_off%, length %csr290_string_len%, size %SOURCE_SIZE%).~
  END
  READ_ASCII csr290_string_off csr290_state_trigger_text (csr290_string_len)
END

DEFINE_PATCH_MACRO ~csr290_read_dlg_transition~ BEGIN
  PATCH_IF ((csr290_transition < 0) OR (csr290_transition >= csr290_trans_found)) BEGIN
    PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: transition %csr290_transition% is out of bounds for state %csr290_state% (%csr290_trans_found% transition(s)).~
  END
  SET csr290_transition_index = csr290_state_first_transition + csr290_transition
  SET csr290_transition_base = csr290_transition_off + csr290_transition_index * 0x20
  READ_LONG csr290_transition_base csr290_transition_flags
  READ_LONG (csr290_transition_base + 0x10) csr290_transition_action_index
  READ_ASCII (csr290_transition_base + 0x14) csr290_transition_next_dlg (8) NULL
  TO_UPPER csr290_transition_next_dlg
  READ_LONG (csr290_transition_base + 0x1c) csr290_transition_next_state
  SPRINT csr290_transition_action_text ~~
  PATCH_IF ((csr290_transition_flags BAND 0x4) = 0x4) BEGIN
    PATCH_IF ((csr290_transition_action_index < 0) OR
              (csr290_transition_action_index >= csr290_action_count)) BEGIN
      PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: state %csr290_state% transition %csr290_transition% has invalid action index %csr290_transition_action_index% (table %csr290_action_count%).~
    END
    SET csr290_string_entry = csr290_action_off + csr290_transition_action_index * 8
    READ_LONG csr290_string_entry csr290_string_off
    READ_LONG (csr290_string_entry + 4) csr290_string_len
    PATCH_IF ((csr290_string_off < 0) OR (csr290_string_len < 0) OR
              (csr290_string_off + csr290_string_len > SOURCE_SIZE)) BEGIN
      PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: state %csr290_state% transition %csr290_transition%'s action string is out of bounds (offset %csr290_string_off%, length %csr290_string_len%, size %SOURCE_SIZE%).~
    END
    READ_ASCII csr290_string_off csr290_transition_action_text (csr290_string_len)
  END
END

DEFINE_PATCH_MACRO ~csr290_assert_dlg_state_token~ BEGIN
  PATCH_IF (INDEX(~%csr290_pat%~ ~%csr290_state_trigger_text%~) < 0) BEGIN
    PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: state %csr290_state%'s trigger does not contain its audited semantic token.~
  END
END

DEFINE_PATCH_MACRO ~csr290_assert_dlg_action_token~ BEGIN
  PATCH_IF (((csr290_transition_flags BAND 0x4) != 0x4) OR
            ((csr290_transition_flags BAND 0x8) != 0x8) OR
            (INDEX(~%csr290_pat%~ ~%csr290_transition_action_text%~) < 0)) BEGIN
    PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: state %csr290_state% transition %csr290_transition% is not the audited terminal action route.~
  END
END

DEFINE_PATCH_MACRO ~csr290_assert_dlg_goto~ BEGIN
  PATCH_IF (((csr290_transition_flags BAND 0x4) != 0) OR
            ((csr290_transition_flags BAND 0x8) != 0) OR
            NOT (~%csr290_transition_next_dlg%~ STRING_EQUAL_CASE ~%csr290_next_dlg%~) OR
            (csr290_transition_next_state != csr290_next_state)) BEGIN
    PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: state %csr290_state% transition %csr290_transition% is not the audited actionless route to %csr290_next_dlg% state %csr290_next_state%.~
  END
END

DEFINE_PATCH_MACRO ~csr290_replace~ BEGIN
  COUNT_REGEXP_INSTANCES ~%csr290_pat%~ csr290_found
  PATCH_IF (csr290_found = csr290_expect) BEGIN
    REPLACE_TEXTUALLY ~%csr290_pat%~ ~%csr290_rep%~
  END ELSE BEGIN
    PATCH_FAIL ~chriz-sod-remix #290 [%csr290_what%]: expected %csr290_expect% textual anchor(s), found %csr290_found%.~
  END
END

// ------------------------------------------------------------
// 290.0 — all-or-nothing platform classification
// ------------------------------------------------------------
OUTER_SET csr290_eet_anchors = 0
ACTION_IF FILE_EXISTS_IN_GAME ~K#TELBGT.BCS~ BEGIN
  OUTER_SET csr290_eet_anchors += 1
END
ACTION_IF FILE_EXISTS_IN_GAME ~K#TELBGT.CRE~ BEGIN
  OUTER_SET csr290_eet_anchors += 1
END
ACTION_IF FILE_EXISTS_IN_GAME ~AR0602.BCS~ BEGIN
  OUTER_SET csr290_eet_anchors += 1
END

ACTION_IF ((csr290_eet_anchors = 1) OR (csr290_eet_anchors = 2)) BEGIN
  FAIL ~chriz-sod-remix #290: partial EET handoff signature (%csr290_eet_anchors% of K#TELBGT.BCS, K#TELBGT.CRE, AR0602.BCS). Refusing to select the standalone branch for a damaged or unexpected EET install.~
END

OUTER_SET csr290_is_eet = 0
ACTION_IF (csr290_eet_anchors = 3) BEGIN
  OUTER_SET csr290_is_eet = 1
END

// EET's imported TLK shifts these SoD journal strrefs by 200000; native SoD
// retains the unshifted values.
OUTER_SET csr290_tlk_shift = 0
ACTION_IF (csr290_is_eet = 1) BEGIN
  OUTER_SET csr290_tlk_shift = 200000
END
OUTER_SET csr290_victory_journal = 66908 + csr290_tlk_shift
OUTER_SET csr290_corwin_arrest_info = 59855 + csr290_tlk_shift

// ------------------------------------------------------------
// 290.1 — platform-specific preflight, before any mutation/text
// ------------------------------------------------------------
ACTION_IF (csr290_is_eet = 1) BEGIN
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~BD6100.ARE~ BEGIN
    FAIL ~chriz-sod-remix #290: complete EET signature found, but BD6100.ARE is missing.~
  END
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~BD4300.ARE~ BEGIN
    FAIL ~chriz-sod-remix #290: EET ending requires BD4300.ARE for the local equipment bank.~
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~CSRETBGT.BCS~ BEGIN
    FAIL ~chriz-sod-remix #290: CSRETBGT.BCS already exists; refusing to overwrite another resource.~
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~CSRETBGT.CRE~ BEGIN
    FAIL ~chriz-sod-remix #290: CSRETBGT.CRE already exists; refusing to overwrite another resource.~
  END

  // Destination bank: exactly one empty K#ImportContainer in BD6100.
  COPY_EXISTING - ~BD6100.ARE~ ~override~
    READ_ASCII 0x00 csr290_sig (8)
    PATCH_IF NOT (~%csr290_sig%~ STRING_EQUAL_CASE ~AREAV1.0~) BEGIN
      PATCH_FAIL ~chriz-sod-remix #290 [BD6100 destination]: expected AREAV1.0, found '%csr290_sig%'.~
    END
    READ_LONG  0x70 csr290_co
    READ_SHORT 0x74 csr290_cc
    PATCH_IF ((csr290_co < 0xf4) OR (csr290_co + csr290_cc * 0xc0 > SOURCE_SIZE)) BEGIN
      PATCH_FAIL ~chriz-sod-remix #290 [BD6100 destination]: container table is out of bounds.~
    END
    SET csr290_hits = 0
    SET csr290_empty_hits = 0
    FOR (csr290_i = 0; csr290_i < csr290_cc; csr290_i += 1) BEGIN
      SET csr290_b = csr290_co + csr290_i * 0xc0
      READ_ASCII csr290_b csr290_name (32) NULL
      TO_UPPER csr290_name
      PATCH_IF (~%csr290_name%~ STRING_EQUAL_CASE ~K#IMPORTCONTAINER~) BEGIN
        SET csr290_hits += 1
        READ_LONG (csr290_b + 0x44) csr290_items
        PATCH_IF (csr290_items = 0) BEGIN
          SET csr290_empty_hits += 1
        END
      END
    END
    PATCH_IF NOT ((csr290_hits = 1) AND (csr290_empty_hits = 1)) BEGIN
      PATCH_FAIL ~chriz-sod-remix #290 [BD6100 destination]: expected exactly one empty K#ImportContainer, found %csr290_hits% named container(s), %csr290_empty_hits% empty.~
    END
  // Local bank must not already exist; also validate the tables that will be
  // relocated to EOF later.
  COPY_EXISTING - ~BD4300.ARE~ ~override~
    READ_ASCII 0x00 csr290_sig (8)
    PATCH_IF NOT (~%csr290_sig%~ STRING_EQUAL_CASE ~AREAV1.0~) BEGIN
      PATCH_FAIL ~chriz-sod-remix #290 [BD4300 local bank]: expected AREAV1.0, found '%csr290_sig%'.~
    END
    READ_LONG  0x70 csr290_co
    READ_SHORT 0x74 csr290_cc
    READ_SHORT 0x76 csr290_item_count
    READ_LONG  0x78 csr290_io
    READ_LONG  0x7c csr290_vo
    READ_SHORT 0x80 csr290_vc
    PATCH_IF ((csr290_co < 0) OR (csr290_io < 0) OR (csr290_vo < 0) OR
              (csr290_co < 0xf4) OR (csr290_co + csr290_cc * 0xc0 > SOURCE_SIZE) OR
              ((csr290_item_count > 0) AND (csr290_io < 0xf4)) OR
              (csr290_io + csr290_item_count * 0x14 > SOURCE_SIZE) OR
              (csr290_vo < 0xf4) OR (csr290_vo + csr290_vc * 4 > SOURCE_SIZE) OR
              (csr290_cc >= 0xffff) OR (csr290_vc > 0xfffb)) BEGIN
      PATCH_FAIL ~chriz-sod-remix #290 [BD4300 local bank]: container/item/vertex table bounds or 16-bit counts are unsafe (containers %csr290_cc%, items %csr290_item_count%, vertices %csr290_vc%, size %SOURCE_SIZE%).~
    END
    SET csr290_hits = 0
    FOR (csr290_i = 0; csr290_i < csr290_cc; csr290_i += 1) BEGIN
      SET csr290_b = csr290_co + csr290_i * 0xc0
      READ_ASCII csr290_b csr290_name (32) NULL
      READ_LONG (csr290_b + 0x40) csr290_first_item
      READ_LONG (csr290_b + 0x44) csr290_live_items
      READ_LONG (csr290_b + 0x50) csr290_first_vertex
      READ_SHORT (csr290_b + 0x54) csr290_live_vertices
      PATCH_IF ((csr290_first_item < 0) OR (csr290_live_items < 0) OR
                (csr290_first_vertex < 0) OR
                (csr290_first_item > csr290_item_count) OR
                (csr290_live_items > csr290_item_count - csr290_first_item) OR
                (csr290_first_vertex > csr290_vc) OR
                (csr290_live_vertices > csr290_vc - csr290_first_vertex)) BEGIN
        PATCH_FAIL ~chriz-sod-remix #290 [BD4300 local bank]: existing container %csr290_i% has an invalid item or vertex run (items %csr290_first_item% + %csr290_live_items% of %csr290_item_count%; vertices %csr290_first_vertex% + %csr290_live_vertices% of %csr290_vc%).~
      END
      TO_UPPER csr290_name
      PATCH_IF (~%csr290_name%~ STRING_EQUAL_CASE ~K#IMPORTCONTAINER~) BEGIN
        SET csr290_hits += 1
      END
    END
    PATCH_IF (csr290_hits != 0) BEGIN
      PATCH_FAIL ~chriz-sod-remix #290 [BD4300 local bank]: expected zero K#ImportContainer records before installation, found %csr290_hits%.~
    END
  // The clone must be an exact copy of the currently installed carrier plus
  // one guard and one cross-area move. Validate every insertion anchor now.
  COPY_EXISTING - ~K#TELBGT.BCS~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      SPRINT csr290_what ~K# carrier INTRO15F anchor~
      SPRINT csr290_pat ~StartMovie("INTRO15F")~
      SET csr290_expect = 1
      LAUNCH_PATCH_MACRO csr290_assert_count
      SPRINT csr290_what ~K# carrier SoA campaign move~
      SPRINT csr290_pat ~MoveToCampaign("SoA")~
      SET csr290_expect = 1
      LAUNCH_PATCH_MACRO csr290_assert_count
      SPRINT csr290_what ~K# carrier pre-existing container move~
      SPRINT csr290_pat ~MoveContainerContents(~
      SET csr290_expect = 0
      LAUNCH_PATCH_MACRO csr290_assert_count
      FOR (csr290_player = 1; csr290_player <= 6; csr290_player += 1) BEGIN
        SPRINT csr290_what ~K# carrier local bank for Player%csr290_player%~
        SPRINT csr290_pat ~ActionOverride("K#ImportContainer",TakeCreatureItems(Player%csr290_player%,ALL))~
        SET csr290_expect = 1
        LAUNCH_PATCH_MACRO csr290_assert_count
      END
      SPRINT csr290_what ~K# carrier contiguous Player1-through-Player6 bank sequence~
      SPRINT csr290_pat ~ActionOverride("K#ImportContainer",TakeCreatureItems(Player1,ALL))%csr290_nl%    ActionOverride("K#ImportContainer",TakeCreatureItems(Player2,ALL))%csr290_nl%    ActionOverride("K#ImportContainer",TakeCreatureItems(Player3,ALL))%csr290_nl%    ActionOverride("K#ImportContainer",TakeCreatureItems(Player4,ALL))%csr290_nl%    ActionOverride("K#ImportContainer",TakeCreatureItems(Player5,ALL))%csr290_nl%    ActionOverride("K#ImportContainer",TakeCreatureItems(Player6,ALL))~
      SET csr290_expect = 1
      LAUNCH_PATCH_MACRO csr290_assert_count
      SET csr290_bank_sequence_pos = INDEX_BUFFER (~%csr290_pat%~)
      SPRINT csr290_what ~K# carrier immediate movie-to-campaign sequence~
      SPRINT csr290_pat ~StartMovie("INTRO15F")%csr290_nl%    MoveToCampaign("SoA")~
      SET csr290_expect = 1
      LAUNCH_PATCH_MACRO csr290_assert_count
      SET csr290_movie_sequence_pos = INDEX_BUFFER (~%csr290_pat%~)
      PATCH_IF ((csr290_bank_sequence_pos < 0) OR
                (csr290_movie_sequence_pos < 0) OR
                (csr290_bank_sequence_pos >= csr290_movie_sequence_pos)) BEGIN
        PATCH_FAIL ~chriz-sod-remix #290 [K# carrier ordered handoff]: the exact Player1-through-Player6 bank sequence must precede the immediate INTRO15F-to-SoA sequence.~
      END
    END
  COPY_EXISTING - ~K#TELBGT.CRE~ ~override~
    PATCH_IF (SOURCE_SIZE < 0x2a0) BEGIN
      PATCH_FAIL ~chriz-sod-remix #290 [K# carrier CRE]: resource is too short for the override-script and death-variable fields (%SOURCE_SIZE% bytes).~
    END
    READ_ASCII 0x00 csr290_sig (8)
    PATCH_IF NOT (~%csr290_sig%~ STRING_EQUAL_CASE ~CRE V1.0~) BEGIN
      PATCH_FAIL ~chriz-sod-remix #290 [K# carrier CRE]: expected CRE V1.0, found signature '%csr290_sig%'.~
    END
END ELSE BEGIN
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~BD6100.BCS~ BEGIN
    FAIL ~chriz-sod-remix #290: standalone SoD signature selected, but native BD6100.BCS is missing.~
  END

  // Native standalone SoD has two terminal response paths with the same exact
  // EndCutSceneMode -> ContinueGame(FALSE) -> EndCredits order and no EET code.
  COPY_EXISTING - ~BD6100.BCS~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      SPRINT csr290_what ~standalone BD6100 terminal triples~
      SPRINT csr290_pat ~EndCutSceneMode()%csr290_nl%    ContinueGame(FALSE)%csr290_nl%    EndCredits()~
      SET csr290_expect = 2
      LAUNCH_PATCH_MACRO csr290_assert_count
      SPRINT csr290_what ~standalone BD6100 EET resrefs~
      SPRINT csr290_pat ~K#~
      SET csr290_expect = 0
      LAUNCH_PATCH_MACRO csr290_assert_count
      SPRINT csr290_what ~standalone BD6100 campaign moves~
      SPRINT csr290_pat ~MoveToCampaign(~
      SET csr290_expect = 0
      LAUNCH_PATCH_MACRO csr290_assert_count
    END
END

// ------------------------------------------------------------
// 290.2 — common DLG preflight
// ------------------------------------------------------------
// Raw action/trigger inventories plus direct state-trigger, transition-action,
// and GOTO reads bind every numeric ADD/ALTER command to its audited target.

COPY_EXISTING - ~BDBENCE.DLG~ ~override~
  SPRINT csr290_what ~BDBENCE plot-590 root~
  SPRINT csr290_pat ~Global("bd_plot","global",590)~
  SET csr290_expect = 1
  LAUNCH_PATCH_MACRO csr290_assert_count
  SPRINT csr290_what ~BDBENCE murder cutscene roots~
  SPRINT csr290_pat ~StartCutSceneEx("bdcut60b",TRUE)~
  SET csr290_expect = 2
  LAUNCH_PATCH_MACRO csr290_assert_count
  SPRINT csr290_what ~BDBENCE arrest cutscene roots~
  SPRINT csr290_pat ~StartCutSceneEx("bdcut61",TRUE)~
  SET csr290_expect = 3
  LAUNCH_PATCH_MACRO csr290_assert_count
  PATCH_FOR_EACH csr290_state IN 6 9 10 64 65 67 68 70 71 73 BEGIN
    SET csr290_trans_expect = 1
    PATCH_IF (csr290_state = 6) BEGIN
      SET csr290_trans_expect = 4
    END
    PATCH_IF (csr290_state = 68) BEGIN
      SET csr290_trans_expect = 3
    END
    PATCH_IF ((csr290_state = 70) OR (csr290_state = 71) OR (csr290_state = 73)) BEGIN
      SET csr290_trans_expect = 2
    END
    SPRINT csr290_what ~BDBENCE state %csr290_state%~
    LAUNCH_PATCH_MACRO csr290_assert_dlg_state
    PATCH_IF (csr290_state = 6) BEGIN
      LAUNCH_PATCH_MACRO csr290_read_dlg_state_trigger
      SPRINT csr290_pat ~Global("bd_plot","global",590)~
      LAUNCH_PATCH_MACRO csr290_assert_dlg_state_token
    END
    PATCH_IF ((csr290_state = 67) OR (csr290_state = 68)) BEGIN
      LAUNCH_PATCH_MACRO csr290_read_dlg_state_trigger
      SPRINT csr290_pat ~Global("bd_plot","global",591)~
      LAUNCH_PATCH_MACRO csr290_assert_dlg_state_token
    END
    PATCH_IF (csr290_state = 65) BEGIN
      SET csr290_transition = 0
      LAUNCH_PATCH_MACRO csr290_read_dlg_transition
      SPRINT csr290_next_dlg ~BDBENCE~
      SET csr290_next_state = 66
      LAUNCH_PATCH_MACRO csr290_assert_dlg_goto
    END
    PATCH_IF ((csr290_state = 9) OR (csr290_state = 10)) BEGIN
      SET csr290_transition = 0
      LAUNCH_PATCH_MACRO csr290_read_dlg_transition
      SPRINT csr290_pat ~StartCutSceneEx("bdcut60b",TRUE)~
      LAUNCH_PATCH_MACRO csr290_assert_dlg_action_token
    END
    PATCH_IF ((csr290_state = 70) OR (csr290_state = 71) OR (csr290_state = 73)) BEGIN
      SET csr290_transition = 0
      LAUNCH_PATCH_MACRO csr290_read_dlg_transition
      SPRINT csr290_pat ~StartCutSceneEx("bdcut61",TRUE)~
      LAUNCH_PATCH_MACRO csr290_assert_dlg_action_token
      SET csr290_transition = 1
      LAUNCH_PATCH_MACRO csr290_read_dlg_transition
      SPRINT csr290_next_dlg ~BDCORWIJ~
      SET csr290_next_state = 203
      LAUNCH_PATCH_MACRO csr290_assert_dlg_goto
    END
  END
COPY_EXISTING - ~BDDELANC.DLG~ ~override~
  SPRINT csr290_what ~BDDELANC private first-talk trigger~
  SPRINT csr290_pat ~Global("bd_delancie_talk","locals",0)~
  SET csr290_expect = 1
  LAUNCH_PATCH_MACRO csr290_assert_count
  SPRINT csr290_what ~BDDELANC private repeat trigger plus setters~
  SPRINT csr290_pat ~Global("bd_delancie_talk","locals",1)~
  SET csr290_expect = 4
  LAUNCH_PATCH_MACRO csr290_assert_count
  SPRINT csr290_what ~BDDELANC private completion setters~
  SPRINT csr290_pat ~SetGlobal("bd_delancie_talk","locals",1)~
  SET csr290_expect = 3
  LAUNCH_PATCH_MACRO csr290_assert_count
  SPRINT csr290_what ~BDDELANC public victory journal~
  SPRINT csr290_pat ~AddJournalEntry(%csr290_victory_journal%,QUEST)~
  SET csr290_expect = 2
  LAUNCH_PATCH_MACRO csr290_assert_count
  PATCH_FOR_EACH csr290_state IN 77 78 79 80 81 82 83 95 104 BEGIN
    SET csr290_trans_expect = 1
    PATCH_IF ((csr290_state = 77) OR (csr290_state = 80) OR (csr290_state = 95)) BEGIN
      SET csr290_trans_expect = 3
    END
    PATCH_IF (csr290_state = 78) BEGIN
      SET csr290_trans_expect = 4
    END
    PATCH_IF (csr290_state = 79) BEGIN
      SET csr290_trans_expect = 2
    END
    SPRINT csr290_what ~BDDELANC state %csr290_state%~
    LAUNCH_PATCH_MACRO csr290_assert_dlg_state
    PATCH_IF ((csr290_state = 95) OR (csr290_state = 104)) BEGIN
      LAUNCH_PATCH_MACRO csr290_read_dlg_state_trigger
      SET csr290_private_stage = 0
      PATCH_IF (csr290_state = 104) BEGIN
        SET csr290_private_stage = 1
      END
      SPRINT csr290_pat ~Global("bd_delancie_talk","locals",%csr290_private_stage%)~
      LAUNCH_PATCH_MACRO csr290_assert_dlg_state_token
    END
  END
COPY_EXISTING - ~BDDAZZO.DLG~ ~override~
  SPRINT csr290_what ~BDDAZZO two native bdcut60 endings~
  SPRINT csr290_pat ~StartCutSceneEx("bdcut60",FALSE)~
  SET csr290_expect = 2
  LAUNCH_PATCH_MACRO csr290_assert_count
  PATCH_FOR_EACH csr290_state IN 0 2 3 BEGIN
    SET csr290_trans_expect = 1
    PATCH_IF (csr290_state = 0) BEGIN
      SET csr290_trans_expect = 3
    END
    SPRINT csr290_what ~BDDAZZO state %csr290_state%~
    LAUNCH_PATCH_MACRO csr290_assert_dlg_state
    PATCH_IF (csr290_state = 0) BEGIN
      LAUNCH_PATCH_MACRO csr290_read_dlg_state_trigger
      INNER_PATCH_SAVE csr290_state_trigger_compact ~%csr290_state_trigger_text%~ BEGIN
        REPLACE_TEXTUALLY ~[ %TAB%%WNL%]~ ~~
      END
      PATCH_IF NOT (~%csr290_state_trigger_compact%~ STRING_EQUAL_CASE ~True()~) BEGIN
        PATCH_FAIL ~chriz-sod-remix #290 [BDDAZZO state 0]: expected the audited unconditional True() state trigger, found '%csr290_state_trigger_compact%'.~
      END
    END ELSE BEGIN
      SET csr290_transition = 0
      LAUNCH_PATCH_MACRO csr290_read_dlg_transition
      SPRINT csr290_pat ~StartCutSceneEx("bdcut60",FALSE)~
      LAUNCH_PATCH_MACRO csr290_assert_dlg_action_token
    END
  END
COPY_EXISTING - ~BDRUMOR3.DLG~ ~override~
  PATCH_FOR_EACH csr290_native_journal IN 67031 67057 67091 BEGIN
    SET csr290_platform_journal = csr290_native_journal + csr290_tlk_shift
    SPRINT csr290_what ~BDRUMOR3 Hooded-Man journal %csr290_platform_journal%~
