// End at the public victory celebration; only private carrier copies change.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
INCLUDE ~chriz-sod-remix/lib/comp290_barks.tpa~
OUTER_SET csr290_is_eet = GAME_IS ~eet~
OUTER_SET csr290_shift = 0
ACTION_IF csr290_is_eet BEGIN OUTER_SET csr290_shift = 200000 END
INCLUDE ~chriz-sod-remix/lib/comp290_seed.tpa~
OUTER_SET csr290_s39327 = 39327 + csr290_shift
OUTER_SET csr290_s39328 = 39328 + csr290_shift
OUTER_SET csr290_s39329 = 39329 + csr290_shift
OUTER_SET csr290_s39330 = 39330 + csr290_shift
OUTER_SET csr290_s39331 = 39331 + csr290_shift
OUTER_SET csr290_s39332 = 39332 + csr290_shift
OUTER_SET csr290_s39333 = 39333 + csr290_shift
OUTER_SET csr290_s39334 = 39334 + csr290_shift
OUTER_SET csr290_s39335 = 39335 + csr290_shift
OUTER_SET csr290_s39336 = 39336 + csr290_shift
OUTER_SET csr290_s39337 = 39337 + csr290_shift
OUTER_SET csr290_s39338 = 39338 + csr290_shift
OUTER_SET csr290_s39339 = 39339 + csr290_shift
OUTER_SET csr290_s39340 = 39340 + csr290_shift
OUTER_SET csr290_s39341 = 39341 + csr290_shift
OUTER_SET csr290_s39343 = 39343 + csr290_shift
OUTER_SET csr290_s67488 = 67488 + csr290_shift
LAF csr_ensure_script STR_VAR script = ~bd4300~ END
COPY_EXISTING ~bd4300.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Corwin.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Corwin"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Voghil.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Voghil"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Viconi.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Viconi"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Rasaad.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Rasaad"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Edwin.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Edwin"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Minsc.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Minsc"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Dynahe.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Dynahe"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Dorn.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Dorn"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Neera.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Neera"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Safana.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Safana"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Glint.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Glint"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Baelot.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Baelot"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/MKhiin.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_MKhiin"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Jaheir.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Jaheir"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/Khalid.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_Khalid"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/darnas.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_darnas"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/aun.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_ot2_aun"~ replacement = EVAL ~%authored%~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/convergence.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~SetGlobal("bd_plot","global",587)~ replacement = EVAL ~%authored%~ END
    LPF csr_replace_script_blocks STR_VAR pattern = ~"bd_CorwinRomance6"\|"bd_NeeraRomance6"~ replacement = ~~ END
    LPF csr290_victory_barks INT_VAR csr290_normalize = 1 RET csr290_bark_count END
  END
BUT_ONLY
ACTION_FOR_EACH script IN bddebug bdpalace BEGIN
  LAF csr_ensure_script STR_VAR script END
  COPY_EXISTING ~%script%.bcs~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      PATCH_IF ~%script%~ STRING_EQUAL_CASE ~bddebug~ BEGIN
        LPF csr_replace_script_blocks STR_VAR pattern = ~"bd_debug_move_to_dream"\|"bd_debug_move_to_cell"~ replacement = ~~ END
      END ELSE BEGIN
        LPF csr_replace_script_blocks STR_VAR pattern = ~Range("BDENTAR"~ replacement = ~~ END
      END
    END
  BUT_ONLY
END
COMPILE ~chriz-sod-remix/dlg/csr290common.d~
ACTION_IF csr290_is_eet BEGIN
  INCLUDE ~chriz-sod-remix/lib/comp290_bank.tpa~
  ACTION_IF FILE_EXISTS_IN_GAME ~K#TELBGT.bcs~ BEGIN
    COPY_EXISTING ~K#TELBGT.bcs~ ~override/CSRETBGT.bcs~
  END ELSE BEGIN
    COPY ~chriz-sod-remix/baf/csr290/carrier-fallback.baf~ ~override/CSRETBGT.bcs~ COMPILE_BAF_TO_BCS
    PRINT ~#290: the EET carrier script is absent; the native handoff framework is supplied and unmatched equipment is banked.~
  END
  COPY_EXISTING ~CSRETBGT.bcs~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/carrier-bank.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
      LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~TakeCreatureItems(Player1,ALL)~ replacement = EVAL ~%authored%~ END
      INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr290/carrier-end.baf~ ~.../csr290-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
      LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~MoveToCampaign("SoA")\|StartMovie("INTRO15F")~ replacement = EVAL ~%authored%~ END
      LPF csr_replace_script_blocks STR_VAR pattern = ~"CSR_ENDING_FAILED"~ replacement = ~~ END
    END
  BUT_ONLY
  EXTEND_TOP ~CSRETBGT.bcs~ ~chriz-sod-remix/baf/csr290guard.baf~ USING ~chriz-sod-remix/languages/english/csr290guard.tra~
  LAF csr_readable_cre STR_VAR resource = ~K#TELBGT.cre~ RET readable END
  ACTION_IF readable BEGIN
    COPY_EXISTING ~K#TELBGT.cre~ ~override/CSRETBGT.cre~
      WRITE_ASCIIE 0x248 ~CSRETBGT~ #8 WRITE_ASCIIE 0x280 ~CSRETBGT~ #32
    BUT_ONLY
  END ELSE BEGIN PRINT ~#290: the EET carrier creature is absent or unreadable; its private copy is unavailable.~ END
  COMPILE ~chriz-sod-remix/dlg/csr290eet.d~
END ELSE BEGIN
  COMPILE ~chriz-sod-remix/dlg/csr290sod.d~
END

OUTER_SET csr290_imoen_choice = 0
ACTION_IF MOD_IS_INSTALLED ~chriz-sod-remix/setup-chriz-sod-remix.tp2~ ~292~ BEGIN OUTER_SET csr290_imoen_choice = 1 END
ACTION_IF MOD_IS_INSTALLED ~chriz-sod-remix/setup-chriz-sod-remix.tp2~ ~293~ BEGIN OUTER_SET csr290_imoen_choice = 2 END
ACTION_IF MOD_IS_INSTALLED ~chriz-sod-remix/setup-chriz-sod-remix.tp2~ ~294~ BEGIN OUTER_SET csr290_imoen_choice = 3 END
ACTION_IF csr290_is_eet AND csr290_imoen_choice BEGIN
  INCLUDE ~chriz-sod-remix/lib/comp292_lib.tpa~
  LAF csr292_host_ending INT_VAR choice = csr290_imoen_choice END
END
