// ------------------------------------------------------------
// 290.5 — EET or standalone endpoint
// ------------------------------------------------------------
ACTION_IF (csr290_is_eet = 1) BEGIN
  // Relocate the complete container and vertex arrays to EOF, preserve every
  // old entry/index byte-for-byte, then append the one audited invisible bank.
  COPY_EXISTING ~BD4300.ARE~ ~override~
    READ_LONG  0x70 csr290_co
    READ_SHORT 0x74 csr290_cc
    READ_SHORT 0x76 csr290_item_count
    READ_LONG  0x7c csr290_vo
    READ_SHORT 0x80 csr290_vc

    SET csr290_new_co = BUFFER_LENGTH
    SET csr290_old_cont_bytes = csr290_cc * 0xc0
    INSERT_BYTES csr290_new_co (csr290_old_cont_bytes + 0xc0)
    FOR (csr290_i = 0; csr290_i < csr290_old_cont_bytes; csr290_i += 4) BEGIN
      READ_LONG (csr290_co + csr290_i) csr290_value
      WRITE_LONG (csr290_new_co + csr290_i) csr290_value
    END

    SET csr290_new_container = csr290_new_co + csr290_old_cont_bytes
    WRITE_ASCIIE csr290_new_container ~K#ImportContainer~ #32
    WRITE_SHORT (csr290_new_container + 0x20) 88
    WRITE_SHORT (csr290_new_container + 0x22) 76
    WRITE_SHORT (csr290_new_container + 0x24) 8
    WRITE_SHORT (csr290_new_container + 0x26) 100
    WRITE_LONG  (csr290_new_container + 0x28) 0
    WRITE_SHORT (csr290_new_container + 0x2c) 0
    WRITE_SHORT (csr290_new_container + 0x2e) 100
    WRITE_SHORT (csr290_new_container + 0x30) 0
    WRITE_SHORT (csr290_new_container + 0x32) 0
    WRITE_SHORT (csr290_new_container + 0x34) 80
    WRITE_SHORT (csr290_new_container + 0x36) 70
    WRITE_SHORT (csr290_new_container + 0x38) 72
    WRITE_SHORT (csr290_new_container + 0x3a) 26
    WRITE_SHORT (csr290_new_container + 0x3c) 120
    WRITE_SHORT (csr290_new_container + 0x3e) 58
    WRITE_LONG  (csr290_new_container + 0x40) csr290_item_count
    WRITE_LONG  (csr290_new_container + 0x44) 0
    WRITE_ASCIIE (csr290_new_container + 0x48) ~~ #8
    WRITE_LONG  (csr290_new_container + 0x50) csr290_vc
    WRITE_SHORT (csr290_new_container + 0x54) 4
    WRITE_SHORT (csr290_new_container + 0x56) 0
    WRITE_ASCIIE (csr290_new_container + 0x58) ~~ #32
    WRITE_ASCIIE (csr290_new_container + 0x78) ~~ #8
    WRITE_LONG  (csr290_new_container + 0x80) 0
    WRITE_LONG  (csr290_new_container + 0x84) (0 - 1)
    FOR (csr290_i = 0x88; csr290_i < 0xc0; csr290_i += 4) BEGIN
      WRITE_LONG (csr290_new_container + csr290_i) 0
    END

    SET csr290_new_vo = BUFFER_LENGTH
    SET csr290_old_vertex_bytes = csr290_vc * 4
    INSERT_BYTES csr290_new_vo (csr290_old_vertex_bytes + 16)
    FOR (csr290_i = 0; csr290_i < csr290_old_vertex_bytes; csr290_i += 4) BEGIN
      READ_LONG (csr290_vo + csr290_i) csr290_value
      WRITE_LONG (csr290_new_vo + csr290_i) csr290_value
    END
    SET csr290_new_vertex = csr290_new_vo + csr290_old_vertex_bytes
    WRITE_SHORT (csr290_new_vertex + 0x00) 111
    WRITE_SHORT (csr290_new_vertex + 0x02) 58
    WRITE_SHORT (csr290_new_vertex + 0x04) 72
    WRITE_SHORT (csr290_new_vertex + 0x06) 45
    WRITE_SHORT (csr290_new_vertex + 0x08) 82
    WRITE_SHORT (csr290_new_vertex + 0x0a) 26
    WRITE_SHORT (csr290_new_vertex + 0x0c) 120
    WRITE_SHORT (csr290_new_vertex + 0x0e) 39

    WRITE_LONG  0x70 csr290_new_co
    WRITE_SHORT 0x74 (csr290_cc + 1)
    WRITE_LONG  0x7c csr290_new_vo
    WRITE_SHORT 0x80 (csr290_vc + 4)
  BUT_ONLY

  // Clone the installed carrier; only this clone receives the cross-area move.
  COPY_EXISTING ~K#TELBGT.BCS~ ~override/CSRETBGT.BCS~
    DECOMPILE_AND_PATCH BEGIN
      SPRINT csr290_what ~CSRETBGT INTRO15F insertion point~
      SPRINT csr290_pat ~StartMovie("INTRO15F")~
      SET csr290_expect = 1
      SPRINT csr290_rep ~MoveContainerContents("BD4300*K#ImportContainer","BD6100*K#ImportContainer")
    StartMovie("INTRO15F")~
      LAUNCH_PATCH_MACRO csr290_replace
    END
  BUT_ONLY

  EXTEND_TOP ~CSRETBGT.BCS~ ~chriz-sod-remix/baf/csr290guard.baf~
    USING ~chriz-sod-remix/languages/english/csr290guard.tra~

  COPY_EXISTING ~K#TELBGT.CRE~ ~override/CSRETBGT.CRE~
    WRITE_ASCIIE 0x248 ~CSRETBGT~ #8
    WRITE_ASCIIE 0x280 ~CSRETBGT~ #32
  BUT_ONLY

  COMPILE ~chriz-sod-remix/dlg/csr290eet.d~
END ELSE BEGIN
  COMPILE ~chriz-sod-remix/dlg/csr290sod.d~
END
