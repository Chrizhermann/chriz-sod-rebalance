      SPRINT csr290_pat ~%csr290_nl%  Global("bd_%csr290_rom%Romance6","GLOBAL",0)~
      SET csr290_expect = 1
      SPRINT csr290_rep ~
  False()
  Global("bd_%csr290_rom%Romance6","GLOBAL",0)~
      LAUNCH_PATCH_MACRO csr290_replace
      SPRINT csr290_what ~BD4300 %csr290_rom% Romance6 one block~
      SPRINT csr290_pat ~%csr290_nl%  Global("bd_%csr290_rom%Romance6","GLOBAL",1)~
      SET csr290_expect = 1
