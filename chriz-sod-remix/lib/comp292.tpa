// ============================================================
// Components 292-294 — Imoen in Shadows of Amn (EET)
// ============================================================
// Design (DECIDED 2026-10-17): docs/design/wave1/12-imoen-soa-handover.md.
// The tp2 sets csr292_choice before including this file:
//   1 Shadows of Amn's Imoen (EET's IMOEN10) plus her BG1/SoD tome boosts
//   2 as taken along
//   3 dual-classed to mage at her end-of-SoD thief level (EEex)
// Every choice hands her SoD gear over like the party's (EET's import rules,
// everything else banked) before the campaign switch. The SoD side lives in
// lib/comp292_lib.tpa; the Shadows of Amn side is appended to BALDUR.BCS here.
// Owned handover blocks are supplied even when the previous graph is absent.
// An unavailable donor costs only its private copy.

INCLUDE ~chriz-sod-remix/lib/comp292_lib.tpa~

// Symbols are addressed by name; supply missing official Enhanced Edition IDs.
APPEND ~TRIGGER.IDS~ ~0x40E0 NextTriggerObject(O:Object*)~ UNLESS ~NextTriggerObject(~
ACTION_IF csr292_choice = 3 BEGIN
  APPEND ~ACTION.IDS~ ~472 EEex_LuaAction(S:Chunk*)~ UNLESS ~EEex_LuaAction(~
END
LAF csr_ensure_script STR_VAR script = ~BALDUR~ END
LAF csr292_post_dialog RET csr292_post = dialog csr292_post_first = first csr292_post_rest = rest csr292_post_source = source END
OUTER_SET csr292_donor = 0
ACTION_IF FILE_EXISTS_IN_GAME ~IMOEN10.CRE~ BEGIN
  COPY_EXISTING - ~IMOEN10.CRE~ ~override~ SET csr292_donor = SOURCE_SIZE >= 0x2d4
END
ACTION_IF NOT csr292_donor BEGIN PRINT ~#292: the SoA Imoen donor is absent or unreadable; its copy is unavailable and other handover resources are written.~ END

// ------------------------------------------------------------
// Choice 1: SoA Imoen's own ability scores cap the boosts at 25.
// ------------------------------------------------------------
ACTION_IF (csr292_choice = 1) BEGIN
  LAF csr292_chassis_scores RET_ARRAY csr292_refs END
  ACTION_DEFINE_ASSOCIATIVE_ARRAY csr292_bg2 BEGIN STR => 9 INT => 17 WIS => 11 DEX => 18 CON => 16 CHR => 16 END
  ACTION_IF csr292_donor BEGIN
    COPY_EXISTING ~IMOEN10.CRE~ ~override/CSRIMST.CRE~
      WRITE_ASCII 0x280 ~IMOEN2~ #32
      READ_LONG 0x10 flags WRITE_LONG 0x10 (flags BAND (BNOT 0x8000))
      PHP_EACH csr292_abilities AS name => off BEGIN
        READ_BYTE off value DEFINE_ASSOCIATIVE_ARRAY csr292_bg2 BEGIN ~%name%~ => ~%value%~ END
      END
  END
  // The boosts belong on Shadows of Amn's Imoen only. Should the stand-in swap
  // have failed at the end of SoD, EET carries her own Imoen over instead; she
  // still carries the SoD party mark the preparation gave her (K#PartySoD), and
  // her scores already include the boosts, so she gets a report, not the boosts.
  OUTER_SPRINT csr292_new ~InParty("IMOEN2")
  NextTriggerObject("IMOEN2")
  !Global("K#PartySoD","LOCALS",1)~
  OUTER_SPRINT csr292_soa ~~
  ACTION_PHP_EACH csr292_refs AS csr292_name => csr292_ref BEGIN
    OUTER_SET csr292_room = 25 - $csr292_bg2(~%csr292_name%~)
    OUTER_FOR (csr292_d = 1; csr292_d <= (25 - csr292_ref); ++csr292_d) BEGIN
      OUTER_SET csr292_add = (csr292_d < csr292_room) ? csr292_d : csr292_room
      ACTION_IF (csr292_add > 0) BEGIN
        OUTER_SPRINT csr292_soa ~%csr292_soa%
IF
  Global("CSR_IMSOA_BOOST","GLOBAL",1)
  %csr292_new%
  Global("CSR_IMSOA_D%csr292_name%","GLOBAL",%csr292_d%)
THEN
  RESPONSE #100
    ChangeStat("IMOEN2",%csr292_name%,%csr292_add%,ADD)
    Continue()
END
~
      END
    END
  END
  OUTER_SPRINT csr292_soa ~// chriz-sod-remix 292: tome boosts on Shadows of Amn's Imoen.
IF
  Global("CSR_IMSOA_BOOST","GLOBAL",1)
  InParty("IMOEN2")
  NextTriggerObject("IMOEN2")
  Global("K#PartySoD","LOCALS",1)
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_BOOST","GLOBAL",3)
    DisplayStringNoName(Player1,@2)
    Continue()
END%csr292_soa%
IF
  Global("CSR_IMSOA_BOOST","GLOBAL",1)
  %csr292_new%
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_BOOST","GLOBAL",2)
    Continue()
END
~
  // Removes every temporary ability-score effect before her scores are read.
  CREATE ~spl~ ~csrimstr~
    WRITE_LONG  0x08 (0 - 1)      // no name
    WRITE_LONG  0x0C (0 - 1)
    WRITE_SHORT 0x1C 4            // innate: script-applied only
    WRITE_LONG  0x34 1            // level 1
    WRITE_LONG  0x64 0x72         // ability table offset
    WRITE_SHORT 0x68 1            // one ability
    WRITE_LONG  0x6A 0x9A         // effect table offset
    INSERT_BYTES 0x72 (0x28 + (7 * 0x30))
    WRITE_BYTE  (0x72 + 0x00) 1   // ability type
    WRITE_BYTE  (0x72 + 0x0C) 1   // target: living actor
    WRITE_SHORT (0x72 + 0x10) 1   // min level
    WRITE_SHORT (0x72 + 0x1E) 7   // effect count (empirical offset, see comp250)
    WRITE_SHORT (0x72 + 0x20) 0   // first effect index
    WRITE_SHORT (0x72 + 0x26) 1   // projectile: none
    SET csr292_fx = 0x9A
    // CHR, CON, DEX, INT, STR, WIS, exceptional STR
    PATCH_FOR_EACH csr292_opcode IN 6 10 15 19 44 49 97 BEGIN
      WRITE_SHORT  csr292_fx           337          // remove effects by opcode
      WRITE_BYTE  (csr292_fx + 0x02)   2            // target: preset
      WRITE_LONG  (csr292_fx + 0x04)   (0 - 1)      // any parameter 2
      WRITE_LONG  (csr292_fx + 0x08)   csr292_opcode
      WRITE_BYTE  (csr292_fx + 0x0C)   1            // instant / permanent
      WRITE_BYTE  (csr292_fx + 0x0D)   2            // not dispellable, bypasses MR
      WRITE_BYTE  (csr292_fx + 0x12)   100          // probability
      SET csr292_fx += 0x30
    END
END

// ------------------------------------------------------------
// Choice 3: the conversion and BG2 Imoen's spellbook (EEex).
// ------------------------------------------------------------
ACTION_IF (csr292_choice = 3) BEGIN
  ACTION_CLEAR_ARRAY csr292_wizard
  ACTION_IF csr292_donor BEGIN
    COPY_EXISTING - ~IMOEN10.CRE~ ~override~
      READ_LONG 0x2a0 off READ_LONG 0x2a4 count
      PATCH_IF off + count * 12 <= SOURCE_SIZE BEGIN
        FOR (i = 0; i < count; ++i) BEGIN
          READ_SHORT (off + i * 12 + 10) type
          PATCH_IF type = 1 BEGIN
            READ_ASCII (off + i * 12) spell (8) NULL TO_UPPER spell
            DEFINE_ASSOCIATIVE_ARRAY csr292_wizard BEGIN ~%spell%~ => 1 END
          END
        END
      END ELSE BEGIN PATCH_PRINT ~#294: the donor spell table is unreadable; the conversion keeps her existing spells.~ END
  END
  OUTER_SPRINT csr292_spells ~~
  OUTER_SET csr292_taught = 0
  ACTION_PHP_EACH csr292_wizard AS csr292_spell => csr292_ignored BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%csr292_spell%.spl~ BEGIN
      OUTER_SPRINT csr292_spells ~%csr292_spells%"%csr292_spell%", ~
      OUTER_SET csr292_taught += 1
    END ELSE BEGIN
      PRINT ~chriz-sod-remix 294: IMOEN10's spell %csr292_spell% is not in this game; skipped.~
    END
  END
  // Lower-case source: WeiDU on Linux and macOS looks mod files up in lower case.
  COPY ~chriz-sod-remix/lua/m_csrimd.lua~ ~override/M_CSRIMD.lua~
    REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~--[[CSR292_SPELLS]]~ ~%csr292_spells%~
  OUTER_SPRINT csr292_soa ~// chriz-sod-remix 294: dual-class Imoen at her SoD thief level (EEex).
IF
  Global("CSR_IMSOA_DUAL","GLOBAL",0)
  Global("K#ImoenImport","AR0602",1)
  BeenInParty("IMOEN2")
  !StateCheck("IMOEN2",STATE_REALLY_DEAD)
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_DUAL","GLOBAL",1)
    RealSetGlobalTimer("CSR_IMSOA_DTIMER","GLOBAL",10)
    EEex_LuaAction("CSR_ImoenSoA_Dual()")
    Continue()
END
IF
  Global("CSR_IMSOA_DUAL","GLOBAL",1)
  RealGlobalTimerExpired("CSR_IMSOA_DTIMER","GLOBAL")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_DUAL","GLOBAL",8)
    Continue()
END
IF
  Global("CSR_IMSOA_DUAL","GLOBAL",2)
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_DUAL","GLOBAL",3)
    RealSetGlobalTimer("CSR_IMSOA_DTIMER","GLOBAL",1)
    Continue()
END
IF
  Global("CSR_IMSOA_DUAL","GLOBAL",3)
  RealGlobalTimerExpired("CSR_IMSOA_DTIMER","GLOBAL")
THEN
  RESPONSE #100
    RealSetGlobalTimer("CSR_IMSOA_DTIMER","GLOBAL",1)
    EEex_LuaAction("CSR_ImoenSoA_Learn()")
    Continue()
END
IF
  Global("CSR_IMSOA_DUAL","GLOBAL",5)
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_DUAL","GLOBAL",6)
    DisplayStringNoName(Player1,@4)
    Continue()
END
IF
  Global("CSR_IMSOA_DUAL","GLOBAL",8)
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_DUAL","GLOBAL",9)
    DisplayStringNoName(Player1,@3)
    Continue()
END
~
END

ACTION_IF (csr292_choice = 2) BEGIN
  OUTER_SPRINT csr292_soa ~// chriz-sod-remix 293: Imoen continues as taken along.~
END

// ------------------------------------------------------------
// Every choice: if the SoD-end preparation could not reach her, she arrived
// with her SoD gear (and EET's belt, possibly pushed out of the belt slot).
// Once she is in the party: drop EET's belt (no second copy in the bank),
// bank the rest in EET's AR0602 import container, then give her BG2 belt
// back, now correctly equipped. Separate passes: each step is done by a
// different object.
// ------------------------------------------------------------
OUTER_SPRINT csr292_unprepared ~DisplayStringNoName(Player1,@1)~
OUTER_SPRINT csr292_kept ~DisplayStringNoName(Player1,@6)~
ACTION_IF (csr292_choice = 1) BEGIN
  OUTER_SPRINT csr292_unprepared ~%csr292_unprepared%
    DisplayStringNoName(Player1,@2)~
  OUTER_SPRINT csr292_kept ~%csr292_kept%
    DisplayStringNoName(Player1,@2)~
END
OUTER_SPRINT csr292_soa ~%csr292_soa%
IF
  Global("CSR_IMSOA_FAILED","GLOBAL",1)
  Global("CSR_IMSOA_FB","GLOBAL",0)
  Global("K#ImoenImport","AR0602",1)
  AreaCheck("AR0602")
  InParty("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_FB","GLOBAL",1)
    ActionOverride("IMOEN2",DestroyItem("IMOENHP1"))
    RealSetGlobalTimer("CSR_IMSOA_FBTIMER","GLOBAL",1)
    Continue()
END
IF
  Global("CSR_IMSOA_FB","GLOBAL",1)
  RealGlobalTimerExpired("CSR_IMSOA_FBTIMER","GLOBAL")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_FB","GLOBAL",2)
    ActionOverride("K#ImportContainer",TakeCreatureItems("IMOEN2",0))
    RealSetGlobalTimer("CSR_IMSOA_FBTIMER","GLOBAL",2)
    Continue()
END
IF
  Global("CSR_IMSOA_FB","GLOBAL",2)
  RealGlobalTimerExpired("CSR_IMSOA_FBTIMER","GLOBAL")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_FB","GLOBAL",3)
    SetGlobal("CSR_IMSOA_FAILED","GLOBAL",3)
    ActionOverride("IMOEN2",CreateItem("IMOENHP1",1,0,0))
    ActionOverride("IMOEN2",FillSlot(SLOT_BELT))
    %csr292_unprepared%
    Continue()
END
IF
  Global("CSR_IMSOA_FAILED","GLOBAL",4)
  InParty("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_FAILED","GLOBAL",3)
    DisplayStringNoName(Player1,@5)
    Continue()
END
IF
  Global("CSR_IMSOA_FAILED","GLOBAL",5)
  InParty("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_FAILED","GLOBAL",3)
    %csr292_kept%
    Continue()
END
~

// ------------------------------------------------------------
// Writes: the SoD-end preparation in every host, then Shadows of Amn.
// ------------------------------------------------------------
LAF csr292_host_ending INT_VAR choice = csr292_choice END
LAF csr292_host_skip INT_VAR choice = csr292_choice END

// Her post-party dialog cannot open while the preparation runs (CSR_IMSOA_PREP
// 1-8): LeaveParty() opens it at once, and it may offer to rejoin. Before and
// after the preparation every state is unchanged.
<<<<<<<< .../csr292post.d
%csr292_post_source%
>>>>>>>>
ACTION_IF NOT (~%csr292_post_first%~ STRING_EQUAL ~~) BEGIN
  COMPILE EVALUATE_BUFFER ~.../csr292post.d~
  PRINT ~chriz-sod-remix 292-294: Imoen's post-party dialog %csr292_post% stays closed during the handover (states %csr292_post_first%%csr292_post_rest%).~
END

<<<<<<<< .../csr292soa.baf
%csr292_soa%
>>>>>>>>
COPY_EXISTING ~BALDUR.BCS~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks STR_VAR pattern = ~"CSR_IMSOA_~ replacement = ~~ END
  END
BUT_ONLY
EXTEND_TOP ~BALDUR.BCS~ ~.../csr292soa.baf~ EVALUATE_BUFFER USING ~chriz-sod-remix/languages/%LANGUAGE%/comp292.tra~

ACTION_IF (csr292_choice = 3) BEGIN
  PRINT ~chriz-sod-remix 294: %csr292_taught% wizard spells of IMOEN10 will be taught after the conversion.~
END
