// Corrections to the approved filler cuts. Own the named actors' schedules,
// the amulet's destination and the Shadow Aspect's ordinary-shadow summons.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
ACTION_IF NOT (((csr265_repair260 = 0) OR (csr265_repair260 = 1)) AND
               ((csr265_repair240 = 0) OR (csr265_repair240 = 1))) BEGIN
  FAIL ~#265: invalid caller dependency flags.~
END

ACTION_IF csr265_repair260 BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~BD5000.ARE~ BEGIN
    COPY_EXISTING ~BD5000.ARE~ ~override~
      SET writable = SOURCE_SIZE >= 0xf4
      PATCH_IF writable BEGIN
        READ_LONG 0x54 ao READ_SHORT 0x58 ac
        READ_LONG 0x70 co READ_SHORT 0x74 cc READ_SHORT 0x76 ic READ_LONG 0x78 io
        SET writable = ao + ac * 0x110 <= SOURCE_SIZE AND co + cc * 0xc0 <= SOURCE_SIZE AND io + ic * 20 <= SOURCE_SIZE
        FOR (i = 0; writable AND i < cc; ++i) BEGIN
          READ_LONG (co + i * 0xc0 + 0x40) first READ_LONG (co + i * 0xc0 + 0x44) count
          SET writable = first + count <= ic
        END
      END
      PATCH_IF writable BEGIN
        FOR (i = 0; i < ac; ++i) BEGIN
          SET at = ao + i * 0x110 READ_ASCII at name (32) NULL
          PATCH_IF ~%name%~ STRING_CONTAINS_REGEXP ~^Displacer Beast [123]$~ = 0 BEGIN WRITE_LONG (at + 0x40) 0 END
        END
        SET target = (0 - 1)
        SPRINT amulet ~~
        FOR (i = 0; i < cc; ++i) BEGIN
          SET at = co + i * 0xc0 READ_ASCII at name (32) NULL
          PATCH_IF ~%name%~ STRING_EQUAL_CASE ~Dead_fighter~ BEGIN SET target = i END
        END
        PATCH_IF target < 0 BEGIN
          READ_ASCII co old_containers (cc * 0xc0)
          SET co = BUFFER_LENGTH INSERT_BYTES co ((cc + 1) * 0xc0)
          WRITE_ASCIIE co ~%old_containers%~ WRITE_LONG 0x70 co WRITE_SHORT 0x74 (cc + 1)
          SET target = cc SET cc += 1 SET at = co + target * 0xc0
          WRITE_ASCII at ~Dead_fighter~ #32
          WRITE_SHORT (at + 0x20) 4295 WRITE_SHORT (at + 0x22) 1098 WRITE_SHORT (at + 0x24) 4
          WRITE_LONG (at + 0x28) 64
        END
        // Prefer an existing item in the destination; otherwise move an existing
        // source copy. Preserve its raw flags/charges instead of auto-identifying.
        READ_LONG (co + target * 0xc0 + 0x40) first READ_LONG (co + target * 0xc0 + 0x44) count
        FOR (i = 0; i < count; ++i) BEGIN
          READ_ASCII (io + (first + i) * 20) res (8) NULL
          PATCH_IF ~%res%~ STRING_EQUAL_CASE ~BDMISC68~ AND STRING_LENGTH ~%amulet%~ = 0 BEGIN READ_ASCII (io + (first + i) * 20) amulet (20) END
        END
        FOR (i = 0; i < ic; ++i) BEGIN
          READ_ASCII (io + i * 20) res (8) NULL
          PATCH_IF ~%res%~ STRING_EQUAL_CASE ~BDMISC68~ AND STRING_LENGTH ~%amulet%~ = 0 BEGIN READ_ASCII (io + i * 20) amulet (20) END
          SET $csr265_used(~%i%~) = 0
        END
        PATCH_IF STRING_LENGTH ~%amulet%~ = 0 BEGIN
          INNER_PATCH_SAVE amulet ~~ BEGIN INSERT_BYTES 0 20 WRITE_ASCII 0 ~BDMISC68~ #8 END
        END
        // Rebuild runs independently. Even overlapping source runs retain each
        // container's unrelated item bytes, while the decided reward occurs once.
        SPRINT items ~~ SET total = 0
        FOR (i = 0; i < cc; ++i) BEGIN
          SET at = co + i * 0xc0 READ_LONG (at + 0x40) first READ_LONG (at + 0x44) count
          SET start = total SET placed = 0
          FOR (j = 0; j < count; ++j) BEGIN
            SET index = first + j SET $csr265_used(~%index%~) = 1
            READ_ASCII (io + index * 20) res (8) NULL
            PATCH_IF NOT (~%res%~ STRING_EQUAL_CASE ~BDMISC68~) BEGIN
              READ_ASCII (io + index * 20) item (20) SPRINT items ~%items%%item%~ SET total += 1
            END ELSE PATCH_IF i = target AND NOT placed BEGIN
              SPRINT items ~%items%%amulet%~ SET total += 1 SET placed = 1
            END
          END
          PATCH_IF i = target AND NOT placed BEGIN SPRINT items ~%items%%amulet%~ SET total += 1 END
          WRITE_LONG (at + 0x40) start WRITE_LONG (at + 0x44) (total - start)
        END
        FOR (i = 0; i < ic; ++i) BEGIN
          READ_ASCII (io + i * 20) res (8) NULL
          PATCH_IF NOT $csr265_used(~%i%~) AND NOT (~%res%~ STRING_EQUAL_CASE ~BDMISC68~) BEGIN
            READ_ASCII (io + i * 20) item (20) SPRINT items ~%items%%item%~ SET total += 1
          END
        END
        PATCH_IF total > ic BEGIN SET io = BUFFER_LENGTH INSERT_BYTES io (total * 20) END
        WRITE_ASCIIE io ~%items%~ WRITE_LONG 0x78 io WRITE_SHORT 0x76 total
      END ELSE BEGIN PATCH_PRINT ~#265: BD5000 tables are unreadable; only this area is unchanged.~ END
    BUT_ONLY
  END ELSE BEGIN PRINT ~#265: BD5000 is absent; the other corrections still apply.~ END

  ACTION_IF FILE_EXISTS_IN_GAME ~BD5110.ARE~ BEGIN
    COPY_EXISTING ~BD5110.ARE~ ~override~
      SET writable = SOURCE_SIZE >= 0x5a
      PATCH_IF writable BEGIN READ_LONG 0x54 ao READ_SHORT 0x58 ac SET writable = ao + ac * 0x110 <= SOURCE_SIZE END
      PATCH_IF writable BEGIN
        FOR (i = 0; i < ac; ++i) BEGIN
          SET at = ao + i * 0x110 READ_ASCII at name (32) NULL
          PATCH_IF ~%name%~ STRING_EQUAL_CASE ~UNSLEEPING_GUARDIAN~ BEGIN WRITE_LONG (at + 0x40) 0 END
        END
      END ELSE BEGIN PATCH_PRINT ~#265: BD5110 actors are unreadable; only this table is unchanged.~ END
    BUT_ONLY
  END ELSE BEGIN PRINT ~#265: BD5110 is absent; its removed Guardian is already unavailable.~ END
  ACTION_IF FILE_EXISTS_IN_GAME ~BD5000.BCS~ BEGIN
    COPY_EXISTING ~BD5000.BCS~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        REPLACE_TEXTUALLY CASE_INSENSITIVE ~^[ %TAB%]*GiveItemCreate("bdmisc68",[^%WNL%]*)[^%WNL%]*[%WNL%]+~ ~~
      END
    BUT_ONLY
  END ELSE BEGIN PRINT ~#265: BD5000 script is absent; obsolete amulet grants are already unavailable.~ END
END

ACTION_IF csr265_repair240 BEGIN
  OUTER_SPRINT summons ~~
  ACTION_FOR_EACH difficulty IN ~HARD~ ~HARDEST~ BEGIN
    OUTER_SPRINT summons ~%summons%IF
  !StateCheck(Myself,STATE_INVISIBLE)
  Difficulty(%difficulty%)
  !GlobalTimerNotExpired("bd_summons","locals")
  See(NearestEnemyOf(Myself))
THEN
  RESPONSE #100
    SetGlobalTimer("bd_summons","locals",60)
    ApplySpell(Myself,WIZARD_SHADOW_DOOR)
    ApplySpell(Myself,WIZARD_DARKNESS_15_FOOT)
    CreateCreatureObject("bdshad04",Myself,1,0,0)
    CreateCreatureObject("bdshad04",Myself,1,0,0)
    Continue()
END

~
  END
  LAF csr_ensure_script STR_VAR script = ~BDASHIRU~ END
  COPY_EXISTING ~BDASHIRU.BCS~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      REPLACE_TEXTUALLY CASE_INSENSITIVE ~^[ %TAB%]*CreateCreatureObject("bdshsoul",[^%WNL%]*)[^%WNL%]*[%WNL%]+~ ~~
      LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"bd_summons"~ replacement = EVAL ~%summons%~ END
    END
  BUT_ONLY
END
