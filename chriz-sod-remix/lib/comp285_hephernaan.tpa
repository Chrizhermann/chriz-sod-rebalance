// Hephernaan's final devil form only. The original human creature, the native
// transformation and the donor's creature/script are never modified.
// SCS combat logic is David Wallace's installed, generated cleric/mage AI;
// this bounded adaptation excludes its free casts, preparation and burst spells.

DEFINE_ACTION_FUNCTION csr285_h_spell STR_VAR symbol=~~ RET res level kind BEGIN
  // The authored level-14 book uses these spell identities and levels.
  ACTION_DEFINE_ASSOCIATIVE_ARRAY spell_identity BEGIN
    WIZARD_STONE_SKIN => 2408 WIZARD_MIRROR_IMAGE => 2212 CLERIC_ARMOR_OF_FAITH => 1111
    WIZARD_MINOR_GLOBE_OF_INVULNERABILITY => 2406 CLERIC_FREE_ACTION => 1403
    WIZARD_MAGIC_MISSILE => 2112 WIZARD_MELF_ACID_ARROW => 2211 WIZARD_FLAME_ARROW => 2303
    WIZARD_BREACH => 2513 WIZARD_GLITTERDUST => 2224 WIZARD_SECRET_WORD => 2419
    WIZARD_GREATER_MALISON => 2412 CLERIC_CURE_SERIOUS_WOUNDS => 1401 CLERIC_COMMAND => 1102
  END
  OUTER_SET native = $spell_identity(~%symbol%~)
  OUTER_SET kind = native / 1000 - 1
  OUTER_SET level = (native MODULO 1000) / 100
  OUTER_SET id = IDS_OF_SYMBOL (~SPELL~ ~%symbol%~)
  ACTION_IF id < 1000 OR id >= 3000 BEGIN OUTER_SET id = native END
  OUTER_SET suffix = id MODULO 1000
  OUTER_SPRINT prefix ~SPWI~
  ACTION_IF id < 2000 BEGIN OUTER_SPRINT prefix ~SPPR~ END
  OUTER_SPRINT res ~%prefix%%suffix%~
END

// Decompilation gives a line-normalized grammar. Match one complete block,
// excluding END by indentation, exactly as the bridge timer patch does.
DEFINE_PATCH_MACRO csr285_h_sanitize BEGIN
  SPRINT csr285_h_nl ~%MNL%?%LNL%~
  REPLACE_EVALUATE CASE_INSENSITIVE ~^IF%csr285_h_nl%\(\([ %TAB%]+[^%WNL%]*%csr285_h_nl%\|THEN%csr285_h_nl%\)*\)END~ BEGIN
    SPRINT csr285_h_block ~%MATCH0%~
    INNER_PATCH ~%csr285_h_block%~ BEGIN
      COUNT_REGEXP_INSTANCES CASE_INSENSITIVE ~\(ReallyForceSpell\|ForceSpell\|SpellNoDec\|Rest(\|ApplySpell\|CreateCreature\)~ csr285_h_free
      COUNT_REGEXP_INSTANCES CASE_INSENSITIVE ~\(Contingency\|Sequencer\|SpellTrigger\)~ csr285_h_burst
    END
    PATCH_IF (csr285_h_free > 0 OR csr285_h_burst > 0) BEGIN
      SPRINT csr285_h_block ~~
    END
  END ~%csr285_h_block%~
END

DEFINE_ACTION_MACRO csr285_h_context BEGIN
  OUTER_SPRINT csr285_h_source ~BDCLMA01~
  OUTER_SET csr285_h_adapted = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~SHUPOL01.CRE~ BEGIN
    COPY_EXISTING - ~SHUPOL01.CRE~ ~override~
      PATCH_IF SOURCE_SIZE >= 0x2d4 BEGIN
        READ_ASCII 0x268 candidate (8) NULL
        PATCH_IF FILE_EXISTS_IN_GAME ~%candidate%.BCS~ BEGIN
          SPRINT csr285_h_source ~%candidate%~
          SET csr285_h_adapted = 1
        END
      END
  END
  // Native and adapted donor books retain their existing approved allocations.
  // The selected book no longer depends on matching text inside the donor AI.
  ACTION_DEFINE_ASSOCIATIVE_ARRAY csr285_h_base BEGIN
    WIZARD_STONE_SKIN => 1 WIZARD_MIRROR_IMAGE => 1 CLERIC_ARMOR_OF_FAITH => 1
    WIZARD_MINOR_GLOBE_OF_INVULNERABILITY => 0 CLERIC_FREE_ACTION => 0
    WIZARD_MAGIC_MISSILE => 2 WIZARD_MELF_ACID_ARROW => 1 WIZARD_FLAME_ARROW => 1
    WIZARD_BREACH => 1 WIZARD_GLITTERDUST => 1 WIZARD_SECRET_WORD => 0
    WIZARD_GREATER_MALISON => 0 CLERIC_CURE_SERIOUS_WOUNDS => 1 CLERIC_COMMAND => 1
  END
  ACTION_DEFINE_ASSOCIATIVE_ARRAY csr285_h_insane BEGIN
    WIZARD_STONE_SKIN => 2 WIZARD_MIRROR_IMAGE => 2 CLERIC_ARMOR_OF_FAITH => 1
    WIZARD_MINOR_GLOBE_OF_INVULNERABILITY => 1 CLERIC_FREE_ACTION => 1
    WIZARD_MAGIC_MISSILE => 2 WIZARD_MELF_ACID_ARROW => 1 WIZARD_FLAME_ARROW => 2
    WIZARD_BREACH => 2 WIZARD_GLITTERDUST => 1 WIZARD_SECRET_WORD => 1
    WIZARD_GREATER_MALISON => 0 CLERIC_CURE_SERIOUS_WOUNDS => 2 CLERIC_COMMAND => 1
  END
  ACTION_DEFINE_ASSOCIATIVE_ARRAY csr285_h_prep BEGIN
    WIZARD_STONE_SKIN => 1 WIZARD_MIRROR_IMAGE => 1 CLERIC_ARMOR_OF_FAITH => 1
    WIZARD_MINOR_GLOBE_OF_INVULNERABILITY => 2 CLERIC_FREE_ACTION => 2
    WIZARD_MAGIC_MISSILE => 0 WIZARD_MELF_ACID_ARROW => 0 WIZARD_FLAME_ARROW => 0
    WIZARD_BREACH => 0 WIZARD_GLITTERDUST => 0 WIZARD_SECRET_WORD => 0
    WIZARD_GREATER_MALISON => 0 CLERIC_CURE_SERIOUS_WOUNDS => 0 CLERIC_COMMAND => 0
  END
  ACTION_IF csr285_h_adapted BEGIN
    ACTION_FOR_EACH symbol IN ~WIZARD_GLITTERDUST~ ~CLERIC_COMMAND~ BEGIN
      OUTER_SET $csr285_h_base(~%symbol%~) = 0
      OUTER_SET $csr285_h_insane(~%symbol%~) = 0
    END
  END
  ACTION_PHP_EACH csr285_h_base AS symbol => copies BEGIN
    LAF csr285_h_spell STR_VAR symbol RET res level kind END
    OUTER_SPRINT $csr285_h_res(~%symbol%~) ~%res%~
    OUTER_SET $csr285_h_level(~%symbol%~) = level
    OUTER_SET $csr285_h_kind(~%symbol%~) = kind
    ACTION_IF NOT FILE_EXISTS_IN_GAME ~%res%.SPL~ BEGIN
      PRINT ~#285: %res% is absent; only this spell is omitted from the final-form book.~
      OUTER_SET $csr285_h_base(~%symbol%~) = 0
      OUTER_SET $csr285_h_insane(~%symbol%~) = 0
      OUTER_SET $csr285_h_prep(~%symbol%~) = 0
    END
  END
END

DEFINE_ACTION_FUNCTION csr285_hephernaan_preflight BEGIN
  // Owned resources are overwritten; all authoring checks run in offline tests.
END

DEFINE_ACTION_FUNCTION csr285_h_transform STR_VAR transform=~~ actor=~~ BEGIN
  CREATE ~spl~ ~%transform%~
    SAY 0x08 @28502
    WRITE_LONG 0x0c 0xffffffff
    WRITE_ASCII 0x10 ~EFF_M61~ #8
    WRITE_LONG 0x18 0x02004000
    WRITE_SHORT 0x1c 4 WRITE_SHORT 0x22 10
    WRITE_LONG 0x34 1 WRITE_SHORT 0x38 1
    WRITE_ASCII 0x3a ~IHUM~ #8
    WRITE_LONG 0x50 0xffffffff SAY 0x54 @28503
    WRITE_LONG 0x64 0x72 WRITE_SHORT 0x68 1
    WRITE_LONG 0x6a 0x9a WRITE_SHORT 0x6e 0 WRITE_SHORT 0x70 0
    INSERT_BYTES 0x72 0x88
    WRITE_BYTE 0x72 1 WRITE_BYTE 0x74 4
    WRITE_ASCII 0x76 ~IHUM~ #8
    DEFINE_ASSOCIATIVE_ARRAY header BEGIN
      0x0c => 5 0x0e => 1 0x10 => 1 0x12 => 1 0x16 => 6
      0x1c => 1 0x1e => 2 0x22 => 1 0x24 => 1 0x26 => 1
    END
    PHP_EACH header AS offset => value BEGIN WRITE_SHORT (0x72 + offset) value END
    WRITE_SHORT 0x9a 215 WRITE_SHORT 0xca 151
    WRITE_ASCII 0xae ~DISINTH~ #8
    WRITE_ASCIIE 0xde ~%actor%~ #8
    PATCH_FOR_EACH effect IN 0x9a 0xca BEGIN
      WRITE_BYTE (effect + 2) 1 WRITE_BYTE (effect + 12) 1 WRITE_BYTE (effect + 18) 100
    END
END

DEFINE_PATCH_MACRO csr285_h_slots BEGIN
  // Own all three spellbook tables. Old table counts and contents are immaterial.
  WRITE_LONG 0x2a0 BUFFER_LENGTH WRITE_LONG 0x2a4 0
  WRITE_LONG 0x2b0 BUFFER_LENGTH WRITE_LONG 0x2b4 0
  SET new_off = BUFFER_LENGTH
  INSERT_BYTES new_off 192
  WRITE_LONG 0x2a8 new_off
  WRITE_LONG 0x2ac 12
  FOR (kind=0; kind<2; ++kind) BEGIN
    FOR (level=0; level<6; ++level) BEGIN
      SET b = new_off+(kind*6+level)*16
      WRITE_SHORT b level
      WRITE_SHORT (b+6) kind
    END
  END
END

DEFINE_ACTION_FUNCTION csr285_hephernaan_install BEGIN
  LAM csr285_h_context
  LAF csr285_readable STR_VAR resource = ~BDFINHEP.CRE~ kind = ~cre~ RET readable END
  ACTION_IF readable AND FILE_EXISTS_IN_GAME ~%csr285_h_source%.BCS~ BEGIN
  COPY_EXISTING ~%csr285_h_source%.BCS~ ~override/CSR285HC.BCS~
    DECOMPILE_AND_PATCH BEGIN LPM csr285_h_sanitize END
  ACTION_FOR_EACH tier IN ~base~ ~insane~ BEGIN
    OUTER_SPRINT actor ~CSR285HP~
    OUTER_SPRINT transform ~CSR285HF~
    OUTER_SPRINT ai ~CSR285HB~
    ACTION_IF ~%tier%~ STRING_EQUAL ~insane~ BEGIN
      OUTER_SPRINT actor ~CSR285HI~
      OUTER_SPRINT transform ~CSR285HX~
      OUTER_SPRINT ai ~CSR285HN~
    END
    OUTER_SPRINT prep_actions ~~
    ACTION_PHP_EACH csr285_h_prep AS symbol => prep BEGIN
      ACTION_IF (prep=1 OR (prep=2 AND ~%tier%~ STRING_EQUAL ~insane~)) BEGIN
        OUTER_SPRINT res $csr285_h_res(~%symbol%~)
        OUTER_SPRINT prep_actions ~%prep_actions%    ReallyForceSpellRES("%res%",Myself)
    RemoveSpellRES("%res%")
~
      END
    END
    OUTER_SPRINT prep_script ~IF
  OR(4)
    !AreaCheck("BD4700")
    !Global("BDFinHep","GLOBAL",2)
    !Global("bd_plot","GLOBAL",565)
    !Allegiance(Myself,ENEMY)
THEN
  RESPONSE #100
    NoAction()
END

IF
  Global("CSR285_READY","LOCALS",0)
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    SetGlobal("CSR285_READY","LOCALS",1)
    SetGlobal("instantprep","LOCALS",1)
    SetGlobal("bd_prebuff","LOCALS",1)
    SetGlobal("bd_no_retreat","LOCALS",1)
%prep_actions%    SetGlobalTimer("castspell","LOCALS",6)
    SetGlobalTimer("BD_Cast","LOCALS",6)
    SetInterrupt(TRUE)
    Continue()
END
~
    COMPILE EVALUATE_BUFFER ~.../%ai%.baf~
    COPY_EXISTING ~BDFINHEP.CRE~ ~override/%actor%.CRE~
      // Own only caster role/book/scripts; preserve devil animation, equipment,
      // allegiance, death variable, dialogue, HP, resistances and other effects.
      WRITE_ASCII 0x280 ~BDHEPHER~ #32
      WRITE_BYTE 0x273 14
      WRITE_BYTE 0x234 14
      WRITE_BYTE 0x235 14
      WRITE_BYTE 0x236 0
      WRITE_ASCIIE 0x248 ~%ai%~ #8
      WRITE_ASCII 0x250 ~~ #8
      WRITE_ASCII 0x258 ~~ #8
      WRITE_ASCII 0x260 ~~ #8
      WRITE_ASCII 0x268 ~CSR285HC~ #8
      LPM csr285_h_slots
      PHP_EACH csr285_h_base AS symbol => base_copies BEGIN
        SET copies = base_copies
        PATCH_IF ~%tier%~ STRING_EQUAL ~insane~ BEGIN SET copies = $csr285_h_insane(~%symbol%~) END
        PATCH_IF copies > 0 BEGIN
          SPRINT res $csr285_h_res(~%symbol%~)
          SET level = $csr285_h_level(~%symbol%~) - 1
          SET kind = $csr285_h_kind(~%symbol%~)
          PATCH_IF kind=1 BEGIN
            ADD_KNOWN_SPELL ~%res%~ (level) wizard
            ADD_MEMORIZED_SPELL ~%res%~ (level) wizard (copies)
          END ELSE BEGIN
            ADD_KNOWN_SPELL ~%res%~ (level) priest
            ADD_MEMORIZED_SPELL ~%res%~ (level) priest (copies)
          END
        END
      END
      READ_LONG 0x2a8 info
      DEFINE_ASSOCIATIVE_ARRAY csr285_h_wizard_caps BEGIN 0 => 5 1 => 5 2 => 5 3 => 4 4 => 4 5 => 2 END
      DEFINE_ASSOCIATIVE_ARRAY csr285_h_priest_caps BEGIN 0 => 6 1 => 6 2 => 6 3 => 5 4 => 3 5 => 2 END
      FOR (i=0; i<12; ++i) BEGIN
        READ_SHORT (info+i*16) level
        READ_SHORT (info+i*16+6) kind
        READ_LONG (info+i*16+12) count
        SET cap = $csr285_h_priest_caps(~%level%~)
        PATCH_IF kind=1 BEGIN SET cap = $csr285_h_wizard_caps(~%level%~) END
        WRITE_SHORT (info+i*16+2) count
        WRITE_SHORT (info+i*16+4) count
      END
    LAF csr285_h_transform STR_VAR transform actor END
  END
  // These blocks consume the native one-shot flag only in the finale. Original
  // dialogue/plot actions and transformation behavior elsewhere remain intact.
  ACTION_IF FILE_EXISTS_IN_GAME ~BDHEPHER.BCS~ BEGIN
    COPY_EXISTING ~BDHEPHER.BCS~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        LPF csr_replace_script_blocks STR_VAR pattern = ~ForceSpellRES("CSR285H[FX]"~ END
      END
  END
  LAF csr_ensure_script STR_VAR script = ~BDHEPHER~ END
  EXTEND_TOP ~BDHEPHER.BCS~ ~.../csr285_heph_transition.baf~
  END ELSE BEGIN
    PRINT ~#285: final devil or caster AI is absent; the other finale changes still apply.~
  END
END

