  AreaCheck("BD4700")
  Name("BDHEPHER",Myself)
  Global("BDFinHep","GLOBAL",1)
  !Difficulty(HARDEST)
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    SetGlobal("BDFinHep","GLOBAL",2)
    ForceSpellRES("CSR285HF",Myself)
    ActionOverride("cutspy",DestroySelf())
    SetInterrupt(TRUE)
END
