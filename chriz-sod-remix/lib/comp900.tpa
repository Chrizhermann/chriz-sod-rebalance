// ============================================================
// Component 900 body — treasure from removed content
// ============================================================
// Design: docs/01-remix-wishlist.md (locked 2026-07-08): every
// chapter pass that deletes content routes its notable loot
// through this ONE choice component — either collected somewhere
// convenient, or removed along with the content. The install-time
// variable csr_keep_treasure (set by the subcomponent stubs in the
// tp2) selects the flavor; the "remove" flavor installs as a pure
// preference marker (future passes read it via MOD_IS_INSTALLED).
//
// Current payload — BD7000 Coast Way Forest (component 210):
//   BDDAGG03  Gemblade +1            (victim-pile container)
//   BDSHLD02  The Suncatcher +2      (Isabella; also SDD122's
//                                     journal beat keys on holding
//                                     it - collecting keeps that
//                                     quest thread reachable)
//   BDBOOT04  Boot and a Half of Speed (Tsolak)
//   WAND04    Wand of Paralyzation x5 (Ikros)
//   RING09    Ring of Free Action    (Tsolak's vampreg transform)
//   SODTRE08 x2, SODTRE09            (treasure pile)
// Skipped as trash/quest-paper: plain gear (PLAT01/SW1H05/HELM06/
// STAF02/CLCK14/potions/darts), BDSTAKE (mundane without the
// vampire), BDMISC63 "Crusader Tract" (SDD123 quest paper), all
// DW#* randomiser injections (owned by that mod).
//
// Destination: Container009, the camp chest at (509,3220) beside
// the Flaming Fist tents. Its existing contents belong to the
// installed game and earlier mods; do not assume a vanilla sword. ARE
// container item lists are contiguous index runs into the shared
// items array, so the array is RELOCATED to end-of-file and grown
// there: the only header fields touched are items count (0x76) and
// items offset (0x78), both dev-verified; every other container's
// indices stay valid, the old array bytes become dead padding, and
// no other section moves. The chest's run is rebuilt as
// [byte-identical existing item records + eight payload records]
// at the array tail. Its former run becomes unreferenced, not a
// second active copy of the chest's items.

ACTION_IF (csr_keep_treasure = 1) BEGIN

  INCLUDE ~chriz-sod-remix/lib/relocated_loot.tpa~
  INCLUDE ~chriz-sod-remix/lib/overwrite_2da.tpa~
  OUTER_SET csr900_base = (0 - 1)
  OUTER_SET csr900_written = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~CSR900.2DA~ BEGIN
    COPY_EXISTING - ~CSR900.2DA~ ~override~
      LPF csr_get_2da_cell STR_VAR row = ~BD1000~ column = ~BASE~ RET value found END
      PATCH_IF found AND IS_AN_INT ~%value%~ BEGIN SET csr900_base = value END
  END


  // payload rows (resref, charges1) — index-parallel arrays
  ACTION_CLEAR_ARRAY csr_pay
  ACTION_CLEAR_ARRAY csr_chg
  OUTER_SPRINT $csr_pay(~0~) ~BDDAGG03~ OUTER_SET $csr_chg(~0~) = 0
  OUTER_SPRINT $csr_pay(~1~) ~BDSHLD02~ OUTER_SET $csr_chg(~1~) = 0
  OUTER_SPRINT $csr_pay(~2~) ~BDBOOT04~ OUTER_SET $csr_chg(~2~) = 0
  OUTER_SPRINT $csr_pay(~3~) ~WAND04~   OUTER_SET $csr_chg(~3~) = 5
  OUTER_SPRINT $csr_pay(~4~) ~RING09~   OUTER_SET $csr_chg(~4~) = 0
  OUTER_SPRINT $csr_pay(~5~) ~SODTRE08~ OUTER_SET $csr_chg(~5~) = 0
  OUTER_SPRINT $csr_pay(~6~) ~SODTRE08~ OUTER_SET $csr_chg(~6~) = 0
  OUTER_SPRINT $csr_pay(~7~) ~SODTRE09~ OUTER_SET $csr_chg(~7~) = 0

  // Preserve explicit identification on the original drop when present. Ring09
  // is an authored replacement for Tsolak's vampreg death drop, not a copied
  // RING09 instance: like a newly created item, it is not auto-identified.
  ACTION_CLEAR_ARRAY csr_pay_id
  OUTER_SET $csr_pay_id(~4~) = 0
  ACTION_PHP_EACH csr_pay AS csr_index => csr_item BEGIN
    ACTION_IF csr_index != 4 BEGIN
      OUTER_SPRINT csr_source ~bd7000.are~
      ACTION_IF csr_index = 1 BEGIN OUTER_SPRINT csr_source ~bdisabel.cre~ END
      ACTION_IF csr_index = 2 BEGIN OUTER_SPRINT csr_source ~bdtsolak.cre~ END
      ACTION_IF csr_index = 3 BEGIN OUTER_SPRINT csr_source ~bdikros.cre~ END
      LAF csr_relocated_loot_id
        STR_VAR source = ~%csr_source%~ item_resref = ~%csr_item%~
        RET csr_identified = id_bit
      END
      OUTER_SET $csr_pay_id(~%csr_index%~) = csr_identified
    END
  END

  ACTION_IF FILE_EXISTS_IN_GAME ~bd1000.are~ BEGIN
  COPY_EXISTING ~bd1000.are~ ~override~
    SET writable = SOURCE_SIZE >= 0x11c
    PATCH_IF writable BEGIN
      READ_ASCII 0 signature (8)
      READ_SHORT 0x76 ic READ_LONG 0x78 io READ_LONG 0x70 co READ_SHORT 0x74 cc
      READ_LONG 0x7c vo READ_SHORT 0x80 vc
      SET writable = ~%signature%~ STRING_EQUAL_CASE ~AREAV1.0~
        AND (cc = 0 OR co >= 0x11c) AND co + cc * 0xc0 <= SOURCE_SIZE
        AND (ic = 0 OR io >= 0x11c) AND io + ic * 20 <= SOURCE_SIZE
        AND NOT (ic AND cc AND io < co + cc * 0xc0 AND co < io + ic * 20)
      SET target = (0 - 1) SET active = 0
      FOR (i = 0; writable AND i < cc; ++i) BEGIN
        SET at = co + i * 0xc0 READ_ASCII at name (32) NULL
        READ_LONG (at + 0x40) first READ_LONG (at + 0x44) count
        SET writable = first >= 0 AND count >= 0 AND first <= ic AND count <= ic - first
        SET active += count
        INNER_PATCH_SAVE name ~%name%~ BEGIN REPLACE_TEXTUALLY ~ ~ ~~ END
        PATCH_IF ~%name%~ STRING_EQUAL_CASE ~Container009~ AND target < 0 BEGIN SET target = i END
      END
      SET first = 0 SET count = 0
      PATCH_IF target >= 0 AND writable BEGIN
        READ_LONG (co + target * 0xc0 + 0x40) first READ_LONG (co + target * 0xc0 + 0x44) count
      END
      SET compact = ic + count + 8 > 65535
      SET writable = writable AND (NOT compact OR active + 8 <= 65535)
        AND (target >= 0 OR (cc < 65535 AND vc <= 65526 AND vo + vc * 4 <= SOURCE_SIZE))
    END
    PATCH_IF writable BEGIN
      SPRINT payload ~~
      FOR (j = 0; j < 8; ++j) BEGIN
        TEXT_SPRINT res $csr_pay(~%j%~)
        INNER_PATCH_SAVE item ~~ BEGIN
          INSERT_BYTES 0 20 WRITE_ASCIIE 0 ~%res%~ #8
          WRITE_SHORT 0x0a $csr_chg(~%j%~) WRITE_LONG 0x10 $csr_pay_id(~%j%~)
        END
        SPRINT payload ~%payload%%item%~
      END
      PATCH_IF target < 0 BEGIN
        READ_ASCII co entries (cc * 0xc0)
        SET co = BUFFER_LENGTH INSERT_BYTES co ((cc + 1) * 0xc0)
        WRITE_ASCIIE co ~%entries%~ WRITE_LONG 0x70 co WRITE_SHORT 0x74 (cc + 1)
        SET target = cc SET cc += 1 SET at = co + target * 0xc0
        WRITE_ASCII at ~Container009~ #32
        WRITE_SHORT (at + 0x20) 509 WRITE_SHORT (at + 0x22) 3220 WRITE_SHORT (at + 0x24) 2
        WRITE_SHORT (at + 0x26) 35 WRITE_LONG (at + 0x28) 1
        WRITE_SHORT (at + 0x38) 461 WRITE_SHORT (at + 0x3a) 3125 WRITE_SHORT (at + 0x3c) 538 WRITE_SHORT (at + 0x3e) 3170
        WRITE_LONG (at + 0x50) vc WRITE_SHORT (at + 0x54) 9
        READ_ASCII vo vertices (vc * 4)
        SET vo = BUFFER_LENGTH INSERT_BYTES vo ((vc + 9) * 4)
        WRITE_ASCIIE vo ~%vertices%~ WRITE_LONG 0x7c vo WRITE_SHORT 0x80 (vc + 9)
        DEFINE_ASSOCIATIVE_ARRAY csr900_poly BEGIN
          0,467 => 3170 1,538 => 3160 2,538 => 3144 3,536 => 3136 4,533 => 3128
          5,529 => 3125 6,464 => 3132 7,461 => 3136 8,461 => 3156
        END
        PHP_EACH csr900_poly AS point => y BEGIN
          WRITE_SHORT (vo + (vc + point_0) * 4) point_1 WRITE_SHORT (vo + (vc + point_0) * 4 + 2) y
        END
      END
      PATCH_IF csr900_base >= 0 AND count >= csr900_base + 8 BEGIN
        // Persistent record address: a second tail overwrites its eight items.
        WRITE_ASCIIE (io + (first + csr900_base) * 20) ~%payload%~
        SET csr900_written = 1
      END ELSE BEGIN
      SET csr900_base = count
      PATCH_IF compact BEGIN
        // Unreferenced records remain in the old padding. The new live table
        // contains every container's raw run and this component's reward.
        SPRINT items ~~ SET total = 0
        FOR (i = 0; i < cc; ++i) BEGIN
          SET at = co + i * 0xc0
          READ_LONG (at + 0x40) old_first READ_LONG (at + 0x44) old_count
          READ_ASCII (io + old_first * 20) run (old_count * 20)
          WRITE_LONG (at + 0x40) total
          SPRINT items ~%items%%run%~ SET total += old_count
          PATCH_IF i = target BEGIN
            SPRINT items ~%items%%payload%~ SET total += 8 WRITE_LONG (at + 0x44) (old_count + 8)
          END
        END
      END ELSE BEGIN
        READ_ASCII io items (ic * 20)
        READ_ASCII (io + first * 20) run (count * 20)
        SPRINT items ~%items%%run%%payload%~ SET total = ic + count + 8
        WRITE_LONG (co + target * 0xc0 + 0x40) ic WRITE_LONG (co + target * 0xc0 + 0x44) (count + 8)
      END
      SET io = BUFFER_LENGTH INSERT_BYTES io (total * 20)
      WRITE_ASCIIE io ~%items%~ WRITE_LONG 0x78 io WRITE_SHORT 0x76 total
      SET csr900_written = 1
      END
    END ELSE BEGIN PATCH_PRINT ~#900: BD1000 tables are unreadable or have no representable reward space; only this area is unchanged.~ END
  BUT_ONLY
  END ELSE BEGIN PRINT ~#900: BD1000 is absent; its reward destination is unavailable.~ END

  ACTION_IF csr900_written BEGIN
    <<<<<<<< .../csr900.2da
2DA V1.0
-1
 BASE
BD1000 %csr900_base%
>>>>>>>>
    COPY ~.../csr900.2da~ ~override/CSR900.2DA~ EVALUATE_BUFFER
  END
END
// flavor "remove": nothing to do — the removals themselves already
// deleted the content; installing the marker records the choice.
ACTION_IF (csr_keep_treasure = 0) BEGIN
  OUTER_SET csr_treasure_removed = 1
END
