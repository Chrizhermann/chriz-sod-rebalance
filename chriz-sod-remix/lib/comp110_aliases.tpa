// Own the palace stripping actions for the normalized BG1 identities. The
// actors' other quest actions and all creature/table data remain independent.
DEFINE_PATCH_MACRO csr110_alias_patch BEGIN
  SPRINT csr110_nl ~%MNL%?%LNL%~
  REPLACE_EVALUATE CASE_INSENSITIVE ~^IF%csr110_nl%\(\([ %TAB%]+[^%WNL%]*%csr110_nl%\|THEN%csr110_nl%\)*\)END~ BEGIN
    SPRINT csr110_block ~%MATCH0%~
    PATCH_IF (~%csr110_block%~ STRING_CONTAINS_REGEXP ~"BD_PLOT"~ = 0) BEGIN
      INNER_PATCH_SAVE csr110_block ~%csr110_block%~ BEGIN
        PATCH_FOR_EACH csr110_alias IN ~O#XAN~ ~LK#YESLK~ BEGIN
          REPLACE_TEXTUALLY CASE_INSENSITIVE ~    ActionOverride("%csr110_alias%",\(LeaveParty\|DestroySelf\)())[^%WNL%]*%csr110_nl%~ ~~
        END
      END
    END
  END ~%csr110_block%~
END

DEFINE_ACTION_FUNCTION csr110_keep_renamed_companions BEGIN
  COPY_EXISTING ~bd0103.bcs~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      LAUNCH_PATCH_MACRO csr110_alias_patch
    END
  BUT_ONLY
END
