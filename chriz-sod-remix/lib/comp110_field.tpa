// Own Shar-Teel's field rejoin route, including its join and wait endpoints.
// Native crypt routes and other dialogue states remain independent.
DEFINE_ACTION_FUNCTION csr110_sharteel_field_rejoin
  STR_VAR dialogue_source = ~chriz-sod-remix/dlg/csr110sh.d~
BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~BDSHARTE.dlg~ BEGIN
    OUTER_SPRINT csr110_field_condition ~Name("sharteel",Myself)
BeenInParty("sharteel")
!InPartyAllowDead(Myself)
!AreaCheck("BD0120")
!AreaCheck("BD0130")
GlobalGT("chapter","GLOBAL",6)
GlobalLT("chapter","GLOBAL",14)~
    // Complete native wording for absent states; existing translations are read
    // as values to carry forward, never as validation or replacement anchors.
    OUTER_SET csr110_sharteel_say = 0xffffffff
    OUTER_SET csr110_yes = 0xffffffff
    OUTER_SET csr110_no = 0xffffffff
    OUTER_SET csr110_join_say = 0xffffffff
    OUTER_SET csr110_wait_say = 0xffffffff
    OUTER_SPRINT csr110_verb ~APPEND~
    OUTER_SPRINT csr110_label ~csr110_sharteel_field~
    OUTER_SET csr110_valid = 0
    COPY_EXISTING - ~BDSHARTE.dlg~ ~override~
      PATCH_IF BUFFER_LENGTH >= 0x34 BEGIN
        READ_LONG 8 csr110_sc READ_LONG 12 csr110_so
        READ_LONG 16 csr110_tc READ_LONG 20 csr110_to
        READ_LONG 24 csr110_go READ_LONG 28 csr110_gc
        SET csr110_valid = (csr110_so >= 0x34 AND csr110_so <= BUFFER_LENGTH AND
          csr110_sc <= (BUFFER_LENGTH - csr110_so) / 16 AND
          csr110_to >= 0x34 AND csr110_to <= BUFFER_LENGTH AND
          csr110_tc <= (BUFFER_LENGTH - csr110_to) / 32 AND
          csr110_go <= BUFFER_LENGTH AND csr110_gc <= (BUFFER_LENGTH - csr110_go) / 8)
        PATCH_IF csr110_valid BEGIN
          PATCH_IF csr110_sc > 4 BEGIN
            READ_LONG (csr110_so + 4 * 16) csr110_sharteel_say
            READ_LONG (csr110_so + 4 * 16 + 4) csr110_first
            READ_LONG (csr110_so + 4 * 16 + 8) csr110_replies
            PATCH_IF csr110_first < csr110_tc AND csr110_replies > 0 BEGIN
              READ_LONG (csr110_to + csr110_first * 32 + 4) csr110_yes
            END
            PATCH_IF csr110_first + 1 < csr110_tc AND csr110_replies > 1 BEGIN
              READ_LONG (csr110_to + (csr110_first + 1) * 32 + 4) csr110_no
            END
          END
          PATCH_IF csr110_sc > 5 BEGIN READ_LONG (csr110_so + 5 * 16) csr110_join_say END
          PATCH_IF csr110_sc > 6 BEGIN READ_LONG (csr110_so + 6 * 16) csr110_wait_say END
          FOR (csr110_i = 0; csr110_i < csr110_sc; ++csr110_i) BEGIN
            READ_LONG (csr110_so + csr110_i * 16 + 12) csr110_gi
            PATCH_IF csr110_gi >= 0 AND csr110_gi < csr110_gc BEGIN
              READ_LONG (csr110_go + csr110_gi * 8) csr110_off
              READ_LONG (csr110_go + csr110_gi * 8 + 4) csr110_len
              PATCH_IF csr110_off >= 0 AND csr110_len >= 0 AND csr110_off <= BUFFER_LENGTH - csr110_len BEGIN
                READ_ASCII csr110_off csr110_trigger (csr110_len)
                PATCH_IF (~%csr110_trigger%~ STRING_CONTAINS_REGEXP ~Name("sharteel",Myself)~ = 0) AND
                         (~%csr110_trigger%~ STRING_CONTAINS_REGEXP ~BeenInParty("sharteel")~ = 0) BEGIN
                  SPRINT csr110_verb ~REPLACE~
                  SPRINT csr110_label ~%csr110_i%~
                END
              END
            END
          END
        END
      END
    ACTION_IF csr110_valid BEGIN
      ACTION_IF csr110_sharteel_say < 0 BEGIN OUTER_SET csr110_sharteel_say = RESOLVE_STR_REF(~You have need of me?~) END
      ACTION_IF csr110_yes < 0 BEGIN OUTER_SET csr110_yes = RESOLVE_STR_REF(~I do, will you travel with me again?~) END
      ACTION_IF csr110_no < 0 BEGIN OUTER_SET csr110_no = RESOLVE_STR_REF(~Not at the moment. If that should change, I'll let you know.~) END
      ACTION_IF csr110_join_say < 0 BEGIN OUTER_SET csr110_join_say = RESOLVE_STR_REF(~Point me where you want me, and I'll be there.~) END
      ACTION_IF csr110_wait_say < 0 BEGIN OUTER_SET csr110_wait_say = RESOLVE_STR_REF(~Ah well. Perhaps next time. If you want my help, I'll be right here.~) END
      COMPILE EVALUATE_BUFFER ~%dialogue_source%~
    END ELSE BEGIN
      PRINT ~SoD Remix #110: BDSHARTE dialogue tables cannot be written; field rejoin is unavailable for this file.~
    END
  END ELSE BEGIN
    PRINT ~SoD Remix #110: BDSHARTE.DLG is absent; Shar-Teel's field rejoin is unavailable.~
  END
END
