// Reassert the private carrier's lite-mode boundary and the two ending actions.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
OUTER_SET csr291_shift = 200000
INCLUDE ~chriz-sod-remix/lib/comp291_seed.tpa~
COMPILE ~chriz-sod-remix/dlg/csr290eet.d~
LAF csr_ensure_script STR_VAR script = ~CSRETBGT~ END
COPY_EXISTING ~CSRETBGT.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks STR_VAR pattern = ~"CSR_ENDING_FAILED"~ replacement = ~~ END
  END
BUT_ONLY
EXTEND_TOP ~CSRETBGT.bcs~ ~chriz-sod-remix/baf/csr290guard.baf~ USING ~chriz-sod-remix/languages/english/csr290guard.tra~
