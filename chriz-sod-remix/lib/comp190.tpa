// Replace Skie's second-night visit with the authored silent wake.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
MKDIR ~weidu_external/work/chriz-sod-remix/190~
COPY ~chriz-sod-remix/baf/csr190wake.baf~ ~weidu_external/work/chriz-sod-remix/190/wake.baf~
  READ_ASCII 0 wake (BUFFER_LENGTH)
LAF csr_ensure_script STR_VAR script = ~bd0103~ END
COPY_EXISTING ~bd0103.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks STR_VAR pattern = ~"BD_MDD005"~ replacement = EVAL ~%wake%~ END
  END
BUT_ONLY
LAF csr_ensure_dlg_states INT_VAR count = 17 STR_VAR dialog = ~BDSKIE~ END
COMPILE ~chriz-sod-remix/dlg/csr190skie.d~
