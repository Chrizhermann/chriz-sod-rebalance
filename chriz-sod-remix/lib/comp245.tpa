// The skip rig owns response 14, the BDCUT14 end state. Write that complete
// response; preserve all other cutscene responses and their dispatch order.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
LAF csr_ensure_script STR_VAR script = ~cutskip~ END
COPY ~chriz-sod-remix/baf/csr245skip.baf~ ~weidu_external/work/chriz-sod-remix/csr245skip.baf~
  READ_ASCII 0 csr245_block (BUFFER_LENGTH)
  SPRINT csr245_response ~%csr245_block%~
  SPRINT csr245_nl ~%MNL%?%LNL%~
  INNER_PATCH_SAVE csr245_response ~%csr245_response%~ BEGIN
    REPLACE_TEXTUALLY ~^IF%csr245_nl%\(  [^%WNL%]*%csr245_nl%\)*THEN%csr245_nl%  RESPONSE #100~ ~  RESPONSE #14~
    REPLACE_TEXTUALLY ~END[%WNL%]*$~ ~~
  END
COPY_EXISTING ~cutskip.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks
      STR_VAR pattern = ~Global("BD_CUTSCENE_BREAKABLE","GLOBAL",14)~ END
    SET csr245_switch = 0
    SPRINT nl ~%MNL%?%LNL%~
    REPLACE_EVALUATE ~^IF%nl%\(\([ %TAB%]+[^%WNL%]*%nl%\|THEN%nl%\)*\)END~ BEGIN
      SPRINT body ~%MATCH0%~
      PATCH_IF ~%body%~ STRING_CONTAINS_REGEXP ~Switch("BD_CUTSCENE_BREAKABLE","GLOBAL")~ = 0 BEGIN
        SET csr245_switch = 1
        INNER_PATCH_SAVE body ~%body%~ BEGIN
          SET found = 0
          REPLACE_EVALUATE ~  RESPONSE #14%nl%\(    [^%WNL%]*%nl%\)*~ BEGIN
            SPRINT response ~~
            PATCH_IF NOT found BEGIN SPRINT response ~%csr245_response%~ END
            SET found = 1
          END ~%response%~
          PATCH_IF NOT found BEGIN REPLACE_TEXTUALLY ~END$~ ~%csr245_response%END~ END
        END
      END
    END ~%body%~
    PATCH_IF NOT csr245_switch BEGIN
      INSERT_BYTES 0 (STRING_LENGTH ~%csr245_block%~)
      WRITE_ASCIIE 0 ~%csr245_block%~
    END
  END
BUT_ONLY
