// #256 owns the replacement finale, its victory gate and obsolete scenery.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
OUTER_SPRINT csr256_nl ~%MNL%?%LNL%~

DEFINE_PATCH_MACRO csr256_world_script BEGIN
  SET csr256_entry_written = 0
  SET csr256_115 = MOD_IS_INSTALLED ~chriz-sod-remix/setup-chriz-sod-remix.tp2~ 115 OR (INDEX_BUFFER (~SetGlobal("csr_kh_fort"~) >= 0)
  SET csr256_journal = 59772
  PATCH_IF GAME_IS ~eet~ BEGIN SET csr256_journal += 200000 END
  SPRINT csr256_skie ~~
  // Read only the journal identity and optional companion actions we preserve.
  // Neither their presence nor their count gates the authored finale.
  REPLACE_EVALUATE CASE_INSENSITIVE ~^IF%csr256_nl%\(\([ %TAB%][^%WNL%]*%csr256_nl%\|THEN%csr256_nl%\|%csr256_nl%\)*\)END~ BEGIN
    SPRINT block ~%MATCH0%~
    PATCH_IF ~%block%~ STRING_CONTAINS_REGEXP ~"bd_elemental"\|"bdsumfir"\|SetGlobal("CSR256_STAGE","BD2000",3)~ = 0 BEGIN
      INNER_PATCH ~%block%~ BEGIN
        REPLACE_EVALUATE CASE_INSENSITIVE ~AddJournalEntry(\([0-9]+\),QUEST)~ BEGIN SET csr256_journal = %MATCH1% END ~%MATCH0%~
        REPLACE_EVALUATE CASE_INSENSITIVE ~CreateCreature("bdskie",[^%WNL%]*)~ BEGIN SPRINT csr256_skie ~    %MATCH0%~ END ~%MATCH0%~
        REPLACE_EVALUATE CASE_INSENSITIVE ~"csr_kh_fort"~ BEGIN SET csr256_115 = 1 END ~%MATCH0%~
      END
      SPRINT block ~~
    END ELSE PATCH_IF (~%block%~ STRING_CONTAINS_REGEXP ~"CSR256_REQUEST"\|"CSR256_STAGE"~ = 0) AND (~%block%~ STRING_CONTAINS_REGEXP ~SetGlobal("bd_bridge_plot"~ != 0) BEGIN
      SPRINT block ~~
    END ELSE PATCH_IF ~%block%~ STRING_CONTAINS_REGEXP ~CreateCreature("bdcrubb[12m]"\|SetGlobal("bd_bridge_plot","bd2000",2)~ = 0 BEGIN
      INNER_PATCH_SAVE block ~%block%~ BEGIN
        REPLACE_TEXTUALLY CASE_INSENSITIVE ~SetGlobal("CSR256_REQUEST","BD2000",[-0-9]+)~ ~~
        REPLACE_TEXTUALLY CASE_INSENSITIVE ~CreateCreature("bdcrubb[12m]",\[[0-9]+\.[0-9]+\],[^)]*)~ ~~
        REPLACE_TEXTUALLY CASE_INSENSITIVE ~SetGlobal("bd_bridge_plot","bd2000",[-0-9]+)~ ~SetGlobal("bd_bridge_plot","bd2000",2)~
        SET request_written = 0
        REPLACE_EVALUATE CASE_INSENSITIVE ~SetGlobal("bd_bridge_plot","bd2000",2)~ BEGIN
          SET request_written = 1
        END ~SetGlobal("bd_bridge_plot","bd2000",2)
    SetGlobal("CSR256_REQUEST","BD2000",1)~
        PATCH_IF NOT request_written BEGIN
          REPLACE_TEXTUALLY ~END$~ ~    SetGlobal("bd_bridge_plot","bd2000",2)
    SetGlobal("CSR256_REQUEST","BD2000",1)
END~
        END
      END
      SET csr256_entry_written = 1
    END
  END ~%block%~
  // Missing native retreat blocks still lead to our encounter after the retreat.
  PATCH_IF NOT csr256_entry_written BEGIN
    SPRINT fallback ~IF
  Global("bd_crusaders_retreat","BD2000",1)
  Global("CSR256_REQUEST","BD2000",0)
  GlobalLT("bd_plot","GLOBAL",293)
THEN
  RESPONSE #100
    SetGlobal("bd_bridge_plot","BD2000",2)
    SetGlobal("bd_plot","GLOBAL",280)
    SetGlobal("CSR256_REQUEST","BD2000",1)
    Continue()
END

~
    INSERT_BYTES 0 (STRING_LENGTH ~%fallback%~) WRITE_ASCIIE 0 ~%fallback%~
  END
  REPLACE_TEXTUALLY CASE_INSENSITIVE ~AddMapNoteColor(\[1384.1862\],[0-9]+,[^)]*)~ ~NoAction()~
  SPRINT csr256_guard ~  Global("CSR256_STAGE","BD2000",2)
  GlobalLT("bd_plot","GLOBAL",293)
  CombatCounter(0)
  InMyArea(Player1)
  HPGT(Player1,0)
~
  PATCH_FOR_EACH dv IN ~CSR256FM~ ~CSR256CM~ ~CSR256G1~ ~CSR256G2~ ~CSR256E1~ ~CSR256E2~ ~CSR256F1~ ~CSR256F2~ BEGIN
    SPRINT csr256_guard ~%csr256_guard%  OR(3)
    Dead("%dv%")
    !Exists("%dv%")
    StateCheck("%dv%",STATE_STONE_DEATH)
~
  END
  SPRINT retreat ~    ActionOverride("khalid",SaveLocation("LOCALS","bd_default_loc",[2425.2485]))
    ActionOverride("khalid",SetGlobal("bd_no_retreat","locals",0))
    ActionOverride("khalid",SetGlobal("bd_retreat","locals",1))
~
  SPRINT victory ~~
  FOR (route = 0; route <= csr256_115; ++route) BEGIN
    SPRINT route_guard ~~ SPRINT route_retreat ~%retreat%~
    PATCH_IF csr256_115 BEGIN
      SPRINT route_guard ~  !Global("csr_kh_fort","GLOBAL",1)
~
      PATCH_IF route = 0 BEGIN SPRINT route_guard ~  Global("csr_kh_fort","GLOBAL",1)
~ SPRINT route_retreat ~~ END
    END
    SPRINT victory ~%victory%IF
%route_guard%%csr256_guard%THEN
  RESPONSE #100
    SetGlobal("CSR256_STAGE","BD2000",3)
    SetGlobal("bd_plot","global",293)
    CreateCreatureObject("bdbence",Player1,6,0,0)
%csr256_skie%
%route_retreat%    AddJournalEntry(%csr256_journal%,QUEST)
    SetGlobal("bd_cant_rest","myarea",0)
    SetGlobalTimer("BD_NPC_BANTER","GLOBAL",30)
END

~
  END
  // Put victory ahead of unrelated area work but below the encounter controller.
  INSERT_BYTES 0 (STRING_LENGTH ~%victory%~) WRITE_ASCIIE 0 ~%victory%~
END

DEFINE_PATCH_MACRO csr256_world_area BEGIN
  SET readable = SOURCE_SIZE >= 0xf4
  PATCH_IF readable BEGIN
    PATCH_FOR_EACH layout IN ~actors~ ~regions~ ~animations~ ~ambients~ BEGIN
      PATCH_IF ~%layout%~ STRING_EQUAL ~actors~ BEGIN READ_LONG 0x54 off READ_SHORT 0x58 n SET stride = 0x110 END
      PATCH_IF ~%layout%~ STRING_EQUAL ~regions~ BEGIN READ_LONG 0x5c off READ_SHORT 0x5a n SET stride = 0xc4 END
      PATCH_IF ~%layout%~ STRING_EQUAL ~animations~ BEGIN READ_LONG 0xb0 off READ_LONG 0xac n SET stride = 0x4c END
      PATCH_IF ~%layout%~ STRING_EQUAL ~ambients~ BEGIN READ_LONG 0x84 off READ_SHORT 0x82 n SET stride = 0xd4 END
      PATCH_IF off > SOURCE_SIZE OR n > (SOURCE_SIZE - off) / stride BEGIN SET readable = 0 END
    END
  END
  PATCH_IF readable BEGIN
    READ_LONG 0x54 off READ_SHORT 0x58 n
    FOR (i = 0; i < n; ++i) BEGIN
      SET b = off + i * 0x110
      READ_ASCII (b + 0x80) ref (8) NULL READ_ASCII b name (32) NULL
      PATCH_IF (~%ref%~ STRING_EQUAL_CASE ~BDKEGX~) OR (~%name%~ STRING_EQUAL_CASE ~BD_BARREL_HE~) BEGIN WRITE_LONG (b + 0x40) 0 END
    END
    READ_LONG 0x5c off READ_SHORT 0x5a n
    SET have_retreat = 0
    FOR (i = 0; i < n; ++i) BEGIN
      SET b = off + i * 0xc4
      READ_ASCII b name (32) NULL READ_ASCII (b + 0x7c) ref (8) NULL
      PATCH_IF ~%name%~ STRING_EQUAL_CASE ~Barrel_spot~ BEGIN SET have_retreat = 1 END
      PATCH_IF (~%name%~ STRING_EQUAL_CASE ~Barrel_spot~) OR (~%ref%~ STRING_EQUAL_CASE ~BDBOARB2~) BEGIN WRITE_ASCII (b + 0x7c) ~~ #8 END
    END
    PATCH_IF NOT have_retreat BEGIN
      // The removed controller also names a retreat destination. Recreate that
      // destination when another install omitted it; leave all other regions.
      READ_LONG 0x7c vertices READ_SHORT 0x80 vertex_count
      PATCH_IF vertices <= BUFFER_LENGTH AND vertex_count <= (BUFFER_LENGTH - vertices) / 4 BEGIN
        READ_ASCII vertices vertex_bytes (vertex_count * 4)
        SET new_vertices = BUFFER_LENGTH
        INSERT_BYTES new_vertices ((vertex_count + 3) * 4)
        WRITE_ASCIIE new_vertices ~%vertex_bytes%~ (vertex_count * 4)
        WRITE_LONG 0x7c new_vertices WRITE_SHORT 0x80 (vertex_count + 3)
        SET b = new_vertices + vertex_count * 4
        WRITE_SHORT b 1389 WRITE_SHORT (b + 2) 1899
        WRITE_SHORT (b + 4) 1414 WRITE_SHORT (b + 6) 1874
        WRITE_SHORT (b + 8) 1423 WRITE_SHORT (b + 10) 1903
        READ_ASCII off region_bytes (n * 0xc4)
        SET new_regions = BUFFER_LENGTH INSERT_BYTES new_regions ((n + 1) * 0xc4)
        WRITE_ASCIIE new_regions ~%region_bytes%~ (n * 0xc4)
        WRITE_LONG 0x5c new_regions WRITE_SHORT 0x5a (n + 1)
        SET b = new_regions + n * 0xc4
        WRITE_ASCII b ~Barrel_spot~ #32
        WRITE_SHORT (b + 0x22) 1389 WRITE_SHORT (b + 0x24) 1874
        WRITE_SHORT (b + 0x26) 1423 WRITE_SHORT (b + 0x28) 1903
        WRITE_SHORT (b + 0x2a) 3 WRITE_LONG (b + 0x2c) vertex_count
        WRITE_LONG (b + 0x64) 0xffffffff
        WRITE_SHORT (b + 0x70) 1414 WRITE_SHORT (b + 0x72) 1873
      END ELSE BEGIN PATCH_PRINT ~#256: unreadable vertex table; the missing retreat region could not be written.~ END
    END
    READ_LONG 0xb0 off READ_LONG 0xac n
    FOR (i = 0; i < n; ++i) BEGIN
      SET b = off + i * 0x4c READ_ASCII b name (32) NULL
      PATCH_IF ~%name%~ STRING_MATCHES_REGEXP ~^\(Barrel_ignited_[123]\|Fire_portal_1[abc]?\|Big_explosion\)$~ = 0 BEGIN
        WRITE_LONG (b + 0x24) 0 WRITE_LONG (b + 0x34) (LONG_AT (b + 0x34) BAND 0xfffffffe)
      END
    END
    READ_LONG 0x84 off READ_SHORT 0x82 n
    FOR (i = 0; i < n; ++i) BEGIN
      SET b = off + i * 0xd4 READ_ASCII b name (32) NULL
      PATCH_IF ~%name%~ STRING_EQUAL_CASE ~Amb_fire_portal_1~ BEGIN
        WRITE_LONG (b + 0x8c) 0 WRITE_LONG (b + 0x90) (LONG_AT (b + 0x90) BAND 0xfffffffe)
      END
    END
  END ELSE BEGIN PATCH_PRINT ~#256: unreadable BD2000 area table; this area file is unchanged.~ END
END
DEFINE_ACTION_FUNCTION csr256_world_preflight BEGIN END

DEFINE_ACTION_FUNCTION csr256_world_install BEGIN
  LAF csr_ensure_script STR_VAR script = ~BD2000~ END
  COPY_EXISTING ~BD2000.BCS~ ~override~ DECOMPILE_AND_PATCH BEGIN LPM csr256_world_script END BUT_ONLY
  ACTION_IF FILE_EXISTS_IN_GAME ~BD2000.ARE~ BEGIN
    COPY_EXISTING ~BD2000.ARE~ ~override~ LPM csr256_world_area BUT_ONLY
  END ELSE BEGIN PRINT ~#256: BD2000.ARE is absent; its scenery is unchanged.~ END
  OUTER_SPRINT csr256_controller ~~
  ACTION_FOR_EACH csr256_tier IN ~low~ ~core~ ~hard~ ~insane~ BEGIN
    OUTER_SPRINT csr256_fm ~CSR256FM~ OUTER_SPRINT csr256_cm ~CSR256CM~
    OUTER_SPRINT csr256_difficulty ~DifficultyLT(NORMAL)~
    OUTER_SPRINT csr256_e1 ~CSR26E1L~ OUTER_SPRINT csr256_e2 ~CSR26E2L~
    OUTER_SPRINT csr256_f1 ~CSR26F1L~ OUTER_SPRINT csr256_f2 ~CSR26F2L~
    ACTION_IF NOT (~%csr256_tier%~ STRING_EQUAL_CASE ~low~) BEGIN
      OUTER_SPRINT csr256_difficulty ~Difficulty(NORMAL)~
      OUTER_SPRINT csr256_e1 ~CSR26E1S~ OUTER_SPRINT csr256_e2 ~CSR26E2S~
      OUTER_SPRINT csr256_f1 ~CSR26F1S~ OUTER_SPRINT csr256_f2 ~CSR26F2S~
    END
    ACTION_IF (~%csr256_tier%~ STRING_EQUAL_CASE ~hard~) BEGIN
      OUTER_SPRINT csr256_difficulty ~Difficulty(HARD)~ OUTER_SPRINT csr256_e1 ~CSR26E1G~
    END
    ACTION_IF (~%csr256_tier%~ STRING_EQUAL_CASE ~insane~) BEGIN
      OUTER_SPRINT csr256_fm ~CSR26FMI~ OUTER_SPRINT csr256_cm ~CSR26CMI~
      OUTER_SPRINT csr256_difficulty ~DifficultyGT(HARD)~ OUTER_SPRINT csr256_e1 ~CSR26E1G~ OUTER_SPRINT csr256_f1 ~CSR26F1G~
    END
    OUTER_SPRINT csr256_controller ~%csr256_controller%
IF
  Global("CSR256_REQUEST","BD2000",1)
  Global("CSR256_STAGE","BD2000",0)
  Global("bd_plot","GLOBAL",280)
  Global("bd_bridge_plot","BD2000",2)
  %csr256_difficulty%
THEN
  RESPONSE #100
    SetGlobal("CSR256_REQUEST","BD2000",2)
    SetGlobal("CSR256_STAGE","BD2000",1)
    CreateCreature("%csr256_fm%",[1456.1860],SE)
    CreateCreature("%csr256_cm%",[1344.1920],SE)
    CreateCreature("CSR256G1",[1560.1990],SE)
    CreateCreature("CSR256G2",[1608.1920],SE)
    CreateCreature("%csr256_e1%",[1615.2035],SE)
    CreateCreature("%csr256_e2%",[1680.1965],SE)
    CreateCreature("%csr256_f1%",[1544.1944],SE)
    CreateCreature("%csr256_f2%",[1440.1990],SE)
END
~
  END
  OUTER_SPRINT csr256_controller ~%csr256_controller%
IF
  Global("CSR256_STAGE","BD2000",1)
THEN
  RESPONSE #100
    SetGlobal("CSR256_STAGE","BD2000",2)
    DisplayStringNoName(Player1,%csr256_warning%)
END
~
  <<<<<<<< .../csr256_controller.baf
%csr256_controller%
>>>>>>>>
  EXTEND_TOP ~BD2000.BCS~ ~.../csr256_controller.baf~ EVALUATE_BUFFER
END
