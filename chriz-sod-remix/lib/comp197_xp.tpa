// Skie's restored join route needs the same XP floor as native SoD recruits.
// Extend the existing personal script: saved actors pick up the fix, while
// their equipment, class, kit and other script slots remain untouched.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
DEFINE_ACTION_FUNCTION csr197_install_xp BEGIN
  LAF csr_ensure_script STR_VAR script = ~bdskie~ END
  COPY_EXISTING ~bdskie.bcs~ ~override~
    DECOMPILE_AND_PATCH BEGIN LPF csr_replace_script_blocks STR_VAR pattern = ~"BD_JOINXP"~ END END
  BUT_ONLY
  EXTEND_TOP ~bdskie.bcs~ ~chriz-sod-remix/baf/csrskixp.baf~
END
