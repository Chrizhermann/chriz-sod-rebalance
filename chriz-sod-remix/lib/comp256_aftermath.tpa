// Bence must complete his existing wrap before the door opens and the Bhaal
// crossing advances the story. Bring him to the party after victory.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
DEFINE_ACTION_FUNCTION csr256_aftermath_preflight BEGIN END

DEFINE_ACTION_FUNCTION csr256_aftermath_install BEGIN
  LAF csr_ensure_script STR_VAR script = ~BDBENCE~ END
  OUTER_SPRINT csr256_bence_init ~~
  COPY_EXISTING ~BDBENCE.BCS~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      LPF csr_replace_script_blocks STR_VAR pattern = ~^[ %TAB%]+Global("CSR256_STAGE"\|"CSR256_BENCE_TRY"~ END
      // Move the installed initialization ahead of our pending-wrap wait, with
      // all its actions intact. Its shape does not decide whether we install.
      REPLACE_EVALUATE CASE_INSENSITIVE ~^IF[%WNL% ]+\(Global("bd_ai_controls","locals",[-0-9]+)[^%WNL%]*[%WNL%]+\)\(\([ %TAB%]+[^%WNL%]*[%WNL%]+\|THEN[%WNL%]+\)*\)END~ BEGIN
        SPRINT csr256_bence_init ~%MATCH0%~
      END ~~
    END
  BUT_ONLY
  <<<<<<<< .../csr256_bence.baf
%csr256_bence_init%

IF
  AreaCheck("BD2000")
  Global("CSR256_STAGE","BD2000",3)
  Global("bd_plot","GLOBAL",293)
  CombatCounter(0)
  InMyArea(Player1)
  HPGT(Player1,0)
  Allegiance(Player1,PC)
  IsValidForPartyDialogue(Player1)
  See(Player1)
  Range(Player1,7)
  !GlobalTimerNotExpired("CSR256_BENCE_TRY","LOCALS")
THEN
  RESPONSE #100
    SetGlobalTimer("CSR256_BENCE_TRY","LOCALS",2)
    StartDialogueNoSet(Player1)
END

IF
  AreaCheck("BD2000")
  Global("CSR256_STAGE","BD2000",3)
  Global("bd_plot","GLOBAL",293)
  CombatCounter(0)
  InMyArea(Player1)
  HPGT(Player1,0)
  Allegiance(Player1,PC)
  !Range(Player1,7)
THEN
  RESPONSE #100
    MoveToObject(Player1)
END

// Suppress older starters only during this exact pending wrap. An unavailable
// or interrupted conversation is retried; no permanent attempt latch is set.
IF
  AreaCheck("BD2000")
  Global("CSR256_STAGE","BD2000",3)
  Global("bd_plot","GLOBAL",293)
THEN
  RESPONSE #100
    NoAction()
END
>>>>>>>>
  EXTEND_TOP ~BDBENCE.BCS~ ~.../csr256_bence.baf~ EVALUATE_BUFFER
END
