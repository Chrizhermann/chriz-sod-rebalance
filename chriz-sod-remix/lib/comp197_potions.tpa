// Palace Skie's stock potion tokens become the installed ordinary potions.
// Own this conversion behavior, without comparing either item's old contents.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
DEFINE_ACTION_FUNCTION csr197_install_potion_cleanup
  STR_VAR target_script = ~bdskie~
BEGIN
  ACTION_FOR_EACH csr197_potion_number IN ~10~ ~45~ BEGIN
    OUTER_SPRINT csr197_old_potion ~dw#ptn%csr197_potion_number%~
    OUTER_SPRINT csr197_new_potion ~potn%csr197_potion_number%~
    ACTION_IF FILE_EXISTS_IN_GAME ~%csr197_old_potion%.itm~ AND
              FILE_EXISTS_IN_GAME ~%csr197_new_potion%.itm~ BEGIN
      OUTER_SPRINT csr197_potion_block ~IF
  Name("BDSKIE",Myself)
  InPartyAllowDead(Myself)
  HasItem("%csr197_old_potion%",Myself)
THEN
  RESPONSE #100
    TransformItem("%csr197_old_potion%","%csr197_new_potion%")
    Continue()
END

~
      COPY_EXISTING ~%target_script%.bcs~ ~override~
        DECOMPILE_AND_PATCH BEGIN
          LPF csr_replace_script_blocks
            STR_VAR pattern = EVAL ~TransformItem("%csr197_old_potion%",~
              replacement = EVAL ~%csr197_potion_block%~
          END
        END
      BUT_ONLY
    END ELSE BEGIN
      PRINT ~SoD Remix #197: %csr197_old_potion% or %csr197_new_potion% is absent; this potion conversion is unavailable.~
    END
  END
END
