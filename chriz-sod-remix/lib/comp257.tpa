// The optional challenge owns two Insane script pointers and their AI.
// Missing owned mage resources are rebuilt with #256's unchanged factory.
INCLUDE ~chriz-sod-remix/lib/comp256_spells.tpa~
INCLUDE ~chriz-sod-remix/lib/comp256_creatures.tpa~
INCLUDE ~chriz-sod-remix/lib/comp256_ai.tpa~
OUTER_SET csr256_xp_mage = 1000
OUTER_SET csr256_home_x = 1500
OUTER_SET csr256_home_y = 1950
OUTER_SET csr256_leash = 18
LAM csr256_spells_preflight
LAF csr256_make_mages INT_VAR missing_insane_only = 1 END
LAF csr256_build_mage_ai INT_VAR challenge = 1 STR_VAR role = ~fire~ RET csr256_fire_baf = script END
LAF csr256_build_mage_ai INT_VAR challenge = 1 STR_VAR role = ~control~ RET csr256_control_baf = script END
COMPILE EVALUATE_BUFFER ~.../csr26fmx.baf~ ~.../csr26cmx.baf~
ACTION_FOR_EACH csr257_role IN ~F~ ~C~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~CSR26%csr257_role%MI.CRE~ BEGIN
    COPY_EXISTING ~CSR26%csr257_role%MI.CRE~ ~override~
      PATCH_IF SOURCE_SIZE >= 0x2d4 BEGIN
        WRITE_ASCIIE 0x248 ~CSR26%csr257_role%MX~ #8
      END ELSE BEGIN PATCH_PRINT ~#257: truncated owned mage; only this creature is unchanged.~ END
    BUT_ONLY
  END ELSE BEGIN PRINT ~#257: the mage donor is absent; only this actor cannot receive the challenge.~ END
END
