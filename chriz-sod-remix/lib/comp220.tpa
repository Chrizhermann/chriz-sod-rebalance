// The decided dig-site garrison: actor schedules and eleven relocated keepers.
INCLUDE ~chriz-sod-remix/lib/comp220_lists.tpa~

// The single lich completion award preserves the authored chapter ledger.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
OUTER_SET csr_sod_tlk_shift = 0
ACTION_IF GAME_IS ~eet~ BEGIN OUTER_SET csr_sod_tlk_shift = 200000 END
MKDIR ~weidu_external/work/chriz-sod-remix/220~
COPY ~chriz-sod-remix/baf/csr220award.baf~ ~weidu_external/work/chriz-sod-remix/220/award.baf~
  EVALUATE_BUFFER
  READ_ASCII 0 csr_award (BUFFER_LENGTH)
LAF csr_ensure_script STR_VAR script = ~bd1200~ END
COPY_EXISTING ~bd1200.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks INT_VAR in_place = 1
      STR_VAR pattern = ~SetGlobal("BD_DOD_COLDH_DEFEATED"~ replacement = EVAL ~%csr_award%~ END
  END
BUT_ONLY
