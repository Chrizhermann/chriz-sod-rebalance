// Own the approved day/night rest chances, not encounter size or creatures.
// Values reproduce the signed-off 30-area sweep on native input.
OUTER_SET csr100_shift = 0
ACTION_IF GAME_IS ~eet~ BEGIN OUTER_SET csr100_shift = 200000 END
ACTION_DEFINE_ASSOCIATIVE_ARRAY csr100_chances BEGIN
  ~bd0060~, ~1~ => 1
  ~bd0061~, ~1~ => 1
  ~bd0062~, ~1~ => 1
  ~bd0064~, ~2~ => 2
  ~bd0066~, ~1~ => 1
  ~bd0067~, ~2~ => 2
  ~bd0113~, ~2~ => 2
  ~bd0114~, ~1~ => 2
  ~bd0115~, ~1~ => 2
  ~bd0120~, ~1~ => 1
  ~bd0130~, ~1~ => 1
  ~bd1000~, ~1~ => 2
  ~bd1010~, ~1~ => 2
  ~bd1100~, ~1~ => 1
  ~bd1200~, ~1~ => 1
  ~bd2000~, ~1~ => 1
  ~bd2010~, ~1~ => 1
  ~bd4400~, ~1~ => 1
  ~bd4500~, ~1~ => 1
  ~bd5000~, ~1~ => 1
  ~bd5100~, ~1~ => 1
  ~bd5110~, ~2~ => 2
  ~bd7000~, ~1~ => 1
  ~bd7100~, ~1~ => 2
  ~bd7110~, ~1~ => 1
  ~bd7200~, ~1~ => 1
  ~bd7220~, ~1~ => 1
  ~bd7230~, ~1~ => 1
  ~bd7300~, ~1~ => 1
  ~bd7400~, ~1~ => 1
END
ACTION_PHP_EACH csr100_chances AS key => night BEGIN
  OUTER_SPRINT area ~%key_0%~
  OUTER_SET day = key_1
  ACTION_IF FILE_EXISTS_IN_GAME ~%area%.are~ BEGIN
    COPY_EXISTING ~%area%.are~ ~override~
      PATCH_IF SOURCE_SIZE >= 0x11c BEGIN
        READ_LONG 0xc0 rest
        PATCH_IF rest = 0 BEGIN
          INNER_ACTION BEGIN
            COPY - ~chriz-sod-remix/data/csr100/%area%.bin~ ~.../csr100-rest~
              FOR (at = 0x20; at < 0x48; at += 4) BEGIN
                READ_SLONG at line
                PATCH_IF line > 0 BEGIN WRITE_LONG at (line + csr100_shift) END
              END
              READ_ASCII 0 record (SOURCE_SIZE)
          END
          SET rest = BUFFER_LENGTH
          INSERT_BYTES rest 0xe4
          WRITE_ASCIIE rest ~%record%~
          WRITE_LONG 0xc0 rest
        END
        PATCH_IF rest >= 0x11c AND rest + 0xac <= BUFFER_LENGTH BEGIN
          WRITE_SHORT (rest + 0xa8) day
          WRITE_SHORT (rest + 0xaa) night
        END ELSE BEGIN PATCH_PRINT ~#100: %area% rest record is unreadable; only this area is unchanged.~ END
      END ELSE BEGIN PATCH_PRINT ~#100: %area% area header is unreadable; only this area is unchanged.~ END
    BUT_ONLY
  END ELSE BEGIN PRINT ~#100: area %area% is absent.~ END
END
