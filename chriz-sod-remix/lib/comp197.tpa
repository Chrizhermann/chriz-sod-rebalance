// Palace recruitment and retired Skie plot. Owned routes are written in full;
// unrelated bridge victory actions and the actor's installed build are kept.
INCLUDE ~chriz-sod-remix/lib/overwrite_tail.tpa~
INCLUDE ~chriz-sod-remix/lib/comp197_bridge.tpa~
LOAD_TRA ~chriz-sod-remix/languages/english/csr197skie.tra~
OUTER_SET csr197_shift = 0
ACTION_IF GAME_IS ~eet~ BEGIN OUTER_SET csr197_shift = 200000 END
OUTER_SET csr197_field_text = 66436 + csr197_shift
OUTER_SET csr197_join_text = 66437 + csr197_shift
OUTER_SET csr197_wait_text = 66438 + csr197_shift
OUTER_SET csr197_bridge_journal = 65108 + csr197_shift
ACTION_FOR_EACH script IN ~bd0102~ ~bdskie~ ~bd2000~ ~bdbence~ ~bd7100~ BEGIN LAF csr_ensure_script STR_VAR script END END
COPY_EXISTING ~bd0102.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    // Remove our previous guarded cleanup before stripping the unsafe native action.
    LPF csr_replace_script_blocks STR_VAR pattern = ~!\(InParty\|IsValidForPartyDialogue\)("bdskie")~ END
    REPLACE_TEXTUALLY CASE_INSENSITIVE ~ApplySpellRES("bddest","bdskie")~ ~~
  END
BUT_ONLY
EXTEND_TOP ~bd0102.bcs~ ~chriz-sod-remix/baf/csr197pal.baf~
COPY_EXISTING ~bdskie.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks STR_VAR pattern = ~"bd_skie_plot"\|"bd_skie_ot"~ END
  END
BUT_ONLY
COPY_EXISTING ~bd2000.bcs~ ~override~ DECOMPILE_AND_PATCH BEGIN LPF csr197_bridge_spawns END END BUT_ONLY
COPY_EXISTING ~bdbence.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks STR_VAR pattern = ~"csr_bence_ot"\|"bd_skie_plot"\(.\|[%WNL%]\)*StartDialogNoSet~ END
  END
BUT_ONLY
EXTEND_TOP ~bdbence.bcs~ ~chriz-sod-remix/baf/csr197bnc.baf~
COPY_EXISTING ~bd7100.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr197-sweep.baf~ ~.../csr197-read~ READ_ASCII 0 sweep (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~ActionOverride("bdskie",DestroySelf())~ replacement = EVAL ~%sweep%~ END
  END
BUT_ONLY
ACTION_IF FILE_EXISTS_IN_GAME ~bd4000.are~ BEGIN
  COPY_EXISTING ~bd4000.are~ ~override~
    SET readable = SOURCE_SIZE >= 0x5a
    PATCH_IF readable BEGIN READ_LONG 0x54 off READ_SHORT 0x58 count SET readable = off + count * 272 <= SOURCE_SIZE END
    PATCH_IF readable BEGIN
      FOR (i = 0; i < count; ++i) BEGIN
        SET at = off + i * 272 READ_ASCII at name (32) NULL
        PATCH_IF ~%name%~ STRING_EQUAL_CASE ~Skie~ BEGIN WRITE_LONG (at + 0x40) 0 END
      END
    END ELSE BEGIN PATCH_PRINT ~#197: unreadable camp actor table; only this area is unchanged.~ END
  BUT_ONLY
END ELSE BEGIN PRINT ~#197: camp area is absent; recruitment changes still apply.~ END
INCLUDE ~chriz-sod-remix/lib/comp197_seed.tpa~
INCLUDE ~chriz-sod-remix/lib/comp197_meeting.tpa~
INCLUDE ~chriz-sod-remix/lib/comp197_xp.tpa~
LAF csr197_install_xp END
INCLUDE ~chriz-sod-remix/lib/comp197_dialogue.tpa~
LAF csr197_install_dialogue_route END
INCLUDE ~chriz-sod-remix/lib/comp197_potions.tpa~
LAF csr197_install_potion_cleanup END
