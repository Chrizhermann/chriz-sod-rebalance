// Restore the staged Ymori encounter and the corrected 23,100 party-XP award.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
ACTION_IF FILE_EXISTS_IN_GAME ~bdymori.cre~ BEGIN
  COPY_EXISTING ~bdymori.cre~ ~override~
    PATCH_IF SOURCE_SIZE >= 0x24 BEGIN
      READ_LONG 0x20 state WRITE_LONG 0x20 (state BOR 0x80000)
    END ELSE BEGIN PATCH_PRINT ~#235: Ymori's creature header is unreadable; only its staging bit is unavailable.~ END
  BUT_ONLY
END ELSE BEGIN PRINT ~#235: Ymori's creature donor is absent; the area record and award are still written.~ END
ACTION_IF FILE_EXISTS_IN_GAME ~bd2000.are~ BEGIN
  COPY_EXISTING ~bd2000.are~ ~override~
    SET readable = SOURCE_SIZE >= 0x5a
    PATCH_IF readable BEGIN
      READ_LONG 0x54 off READ_SHORT 0x58 count
      SET readable = off + count * 272 <= SOURCE_SIZE
    END
    PATCH_IF readable BEGIN
      SET target = (0 - 1)
      FOR (i = 0; i < count; ++i) BEGIN
        READ_ASCII (off + i * 272) name (32) NULL
        PATCH_IF ~%name%~ STRING_EQUAL_CASE ~Wight~ AND target < 0 BEGIN SET target = i END
      END
      PATCH_IF target < 0 AND count < 65535 BEGIN
        INNER_ACTION BEGIN COPY - ~chriz-sod-remix/data/csr235-actor.bin~ ~.../csr235-read~ READ_ASCII 0 actor (SOURCE_SIZE) END
        READ_ASCII off entries (count * 272) SET off = BUFFER_LENGTH
        INSERT_BYTES off ((count + 1) * 272) WRITE_ASCIIE off ~%entries%%actor%~
        SET target = count SET count += 1 WRITE_LONG 0x54 off WRITE_SHORT 0x58 count
      END
      PATCH_IF target >= 0 BEGIN
        SET at = off + target * 272 WRITE_LONG (at + 0x40) 0x00ffffff
        READ_LONG (at + 0x88) embedded READ_LONG (at + 0x8c) size
        PATCH_IF size >= 0x24 AND embedded + size <= SOURCE_SIZE BEGIN
          READ_LONG (embedded + 0x20) state WRITE_LONG (embedded + 0x20) (state BOR 0x80000)
        END
      END ELSE BEGIN PATCH_PRINT ~#235: BD2000 has no representable actor slot for Ymori.~ END
    END ELSE BEGIN PATCH_PRINT ~#235: BD2000's actor table is unreadable; only its actor record is unavailable.~ END
  BUT_ONLY
END ELSE BEGIN PRINT ~#235: BD2000 is absent; its actor record is unavailable.~ END
OUTER_SET csr_xp_chunk_230 = 23100
LAF csr_ensure_script STR_VAR script = ~bd2000~ END
COPY_EXISTING ~bd2000.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr230xp.baf~ ~.../csr235-read~ READ_ASCII 0 authored (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"CSR_RN_CHUNK"~ replacement = EVAL ~%authored%~ END
  END
BUT_ONLY
