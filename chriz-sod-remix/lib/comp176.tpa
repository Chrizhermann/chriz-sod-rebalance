// Own the once-only return route and its complete reward action. Rebuild both
// states even if their replies, triggers, text or actions were changed or removed.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
LOAD_TRA ~chriz-sod-remix/languages/english/comp180.tra~
LAF csr_ensure_dlg_states INT_VAR count = 3 STR_VAR dialog = ~csrcele~ END
COMPILE ~chriz-sod-remix/dlg/csr175.d~
  USING ~chriz-sod-remix/languages/english/comp180.tra~
