COPY_EXISTING ~BD0108.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks STR_VAR pattern = ~Global("BD_MINSC",[^%WNL%]*%MNL%?%LNL%  InPartyAllowDead\|Global("BD_DYNAHEIR",[^%WNL%]*%MNL%?%LNL%  InPartyAllowDead~ replacement = EVAL ~%sites%~ END
  END
BUT_ONLY

