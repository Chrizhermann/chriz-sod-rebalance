// #110 owns the party-retention gates at the native recruitment sites.
LAF csr_ensure_script STR_VAR script = ~BD0101~ END
COPY - ~chriz-sod-remix/baf/skip0101.baf~ ~.../csr110-read~ READ_ASCII 0 sites (SOURCE_SIZE)
COPY_EXISTING ~BD0101.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks STR_VAR pattern = ~Global("bd_viconia_spawn",[^%WNL%]*%MNL%?%LNL%  InPartyAllowDead~ replacement = EVAL ~%sites%~ END
  END
BUT_ONLY

