IF %csr290_weight% ~~ THEN BEGIN 203
  SAY #%csr290_s44330%
  IF ~~ THEN DO ~StartCutSceneMode()
AddJournalEntry(%csr290_s59855%,INFO)
AddJournalEntry(%csr290_s59856%,QUEST_DONE)
StartCutSceneEx("bdcut61",TRUE)
~ EXIT
END
END
~~~~~
  COMPILE EVALUATE_BUFFER ~.../csr290-fallback.d~
END ELSE BEGIN
  COPY_EXISTING - ~BDCORWIJ.dlg~ ~override~ READ_LONG 12 so READ_LONG (so + 203 * 16 + 8) nt
  ACTION_IF nt <= 0 BEGIN
    OUTER_SPRINT csr290_transitions ~~~~~%csr290_transitions%
EXTEND_BOTTOM ~BDCORWIJ~ 203
  IF ~~ THEN DO ~StartCutSceneMode()
AddJournalEntry(%csr290_s59855%,INFO)
AddJournalEntry(%csr290_s59856%,QUEST_DONE)
StartCutSceneEx("bdcut61",TRUE)
~ EXIT
END
~~~~~
  END
END
COMPILE EVALUATE_BUFFER ~.../csr290-transitions.d~
