OUTER_SET csr115_s69603 = 69603 + csr115_shift
LOAD_TRA ~chriz-sod-remix/languages/english/csr115.tra~
LOAD_TRA ~chriz-sod-remix/languages/english/csr115fl.tra~
LOAD_TRA ~chriz-sod-remix/languages/english/csr115script.tra~

DEFINE_PATCH_FUNCTION csr115_write_blocks
  STR_VAR file = ~~ pattern = ~~
BEGIN
  INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr115/%file%.baf~ ~.../csr115-read~ READ_ASCII 0 csr115_blocks (SOURCE_SIZE) END
  LPF csr_replace_script_blocks INT_VAR in_place = 1
    STR_VAR pattern = EVAL ~%pattern%~ replacement = EVAL ~%csr115_blocks%~ END
END

LAF csr_ensure_script STR_VAR script = ~bd0103~ END
COPY_EXISTING ~bd0103.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr115_write_blocks STR_VAR file = ~history~ pattern = ~Global("csr_kh_carry","GLOBAL",0)\|Global("csr_jh_carry","GLOBAL",0)~ END
  END
BUT_ONLY

LAF csr_ensure_script STR_VAR script = ~bd1000~ END
COPY_EXISTING ~bd1000.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr115_write_blocks STR_VAR file = ~history~ pattern = ~Global("csr_kh_carry","GLOBAL",0)\|Global("csr_jh_carry","GLOBAL",0)~ END
  END
BUT_ONLY

LAF csr_ensure_script STR_VAR script = ~bd7100~ END
COPY_EXISTING ~bd7100.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr115_write_blocks STR_VAR file = ~history~ pattern = ~Global("csr_kh_carry","GLOBAL",0)\|Global("csr_jh_carry","GLOBAL",0)~ END
  END
BUT_ONLY

LAF csr_ensure_script STR_VAR script = ~bd2100~ END
COPY_EXISTING ~bd2100.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr115_write_blocks STR_VAR file = ~route~ pattern = ~SetGlobal("csr_kh_fort"~ END
    LPF csr115_write_blocks STR_VAR file = ~history~ pattern = ~Global("csr_kh_carry","GLOBAL",0)\|Global("csr_jh_carry","GLOBAL",0)~ END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr115jn.baf~ ~.../csr115-read~ READ_ASCII 0 csr115_journal (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"csr_kh_journal_done"~ replacement = EVAL ~%csr115_journal%~ END
  END
BUT_ONLY

LAF csr_ensure_script STR_VAR script = ~bd2000~ END
COPY_EXISTING ~bd2000.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    SET csr115_has256 = MOD_IS_INSTALLED ~chriz-sod-remix/setup-chriz-sod-remix.tp2~ 256 OR (INDEX_BUFFER (~"CSR256_STAGE"~) >= 0)
    LPF csr115_write_blocks STR_VAR file = ~recruit~ pattern = ~^IF%MNL%?%LNL%  Global("bd_khal_spawn"\|ChangeAIScript("bdfort",CLASS)~ END
    LPF csr115_write_blocks STR_VAR file = ~surrender~ pattern = ~Global("bd_bridgefort_plot","global",6)\|SetGlobal("bd_bridgefort_plot","global",7)~ END
    LPF csr115_write_blocks STR_VAR file = ~command~ pattern = ~SetGlobal("bd_bridgefort_plot","global",3[12])~ END
    PATCH_IF NOT csr115_has256 BEGIN
    LPF csr115_write_blocks STR_VAR file = ~victory~ pattern = ~"bd_elemental"\|"bdsumfir"~ END
    END
    LPF csr115_write_blocks STR_VAR file = ~route~ pattern = ~SetGlobal("csr_kh_fort"~ END
    LPF csr115_write_blocks STR_VAR file = ~history~ pattern = ~Global("csr_kh_carry","GLOBAL",0)\|Global("csr_jh_carry","GLOBAL",0)~ END
    PATCH_IF csr115_has256 BEGIN LPM csr256_world_script END
    INNER_ACTION BEGIN COPY - ~chriz-sod-remix/baf/csr115jn.baf~ ~.../csr115-read~ READ_ASCII 0 csr115_journal (SOURCE_SIZE) END
    LPF csr_replace_script_blocks INT_VAR in_place = 1 STR_VAR pattern = ~"csr_kh_journal_done"~ replacement = EVAL ~%csr115_journal%~ END
  END
BUT_ONLY

LAF csr_ensure_script STR_VAR script = ~bdcut24~ END
COPY_EXISTING ~bdcut24.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr115_write_blocks STR_VAR file = ~arrival~ pattern = ~"bd_bridgefort_plot"~ END
  END
BUT_ONLY

