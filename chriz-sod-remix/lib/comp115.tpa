// #115 owns its carryover gates, fort staging and command routes.
// Full blocks are written even when the original blocks have been removed.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
INCLUDE ~chriz-sod-remix/lib/comp256_world.tpa~
OUTER_SET csr115_ch13 = 9
OUTER_SET csr115_shift = 0
ACTION_IF GAME_IS ~eet~ BEGIN OUTER_SET csr115_ch13 = 13 OUTER_SET csr115_shift = 200000 END
OUTER_SET csr115_s36852 = 36852 + csr115_shift
