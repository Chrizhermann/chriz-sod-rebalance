COPY_EXISTING ~bdkhalid.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr115_write_blocks STR_VAR file = ~reunion~ pattern = ~"bd_mdd206"~ END
    LPF csr115_write_blocks STR_VAR file = ~bio~ pattern = ~"bd_add_new_bio"\|"csr115_bio"~ END
  END
BUT_ONLY

LAF csr_ensure_script STR_VAR script = ~bdvoghil~ END
COPY_EXISTING ~bdvoghil.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr115_write_blocks STR_VAR file = ~rescue~ pattern = ~Global("bd_jaheira_join","global",0)~ END
  END
BUT_ONLY

LAF csr_ensure_script STR_VAR script = ~bdban037~ END
COPY_EXISTING ~bdban037.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr115_write_blocks STR_VAR file = ~ban037~ pattern = ~Switch("bd_pbdd037"~ END
  END
BUT_ONLY

LAF csr_ensure_script STR_VAR script = ~bdban103~ END
COPY_EXISTING ~bdban103.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr115_write_blocks STR_VAR file = ~ban103~ pattern = ~Switch("bd_pbdd103"~ END
  END
BUT_ONLY

// These eight cutscenes and their dispatchers are private, complete resources.
ACTION_FOR_EACH csr115_suffix IN ~aa~ ~ab~ ~ac~ ~ad~ ~ae~ ~ca~ ~cb~ ~cc~ BEGIN
  COMPILE EVALUATE_BUFFER ~chriz-sod-remix/baf/csr115/cs115s%csr115_suffix%.baf~
  COPY ~.../csr115-dispatch.baf~ ~override/bdc205%csr115_suffix%.bcs~ EVALUATE_BUFFER COMPILE_BAF_TO_BCS
END
ACTION_IF FILE_EXISTS_IN_GAME ~BDBFORT.CRE~ BEGIN
  COPY_EXISTING - ~BDBFORT.CRE~ ~override~ SET csr115_actor_readable = SOURCE_SIZE >= 0x2d4
  ACTION_IF csr115_actor_readable BEGIN
    COPY_EXISTING ~BDBFORT.CRE~ ~override/CSR115AD.CRE~
      WRITE_ASCII 0x280 ~csr115ad~ #32 WRITE_ASCII 0x2cc ~CSR115AD~ #8
      SAY NAME1 @11590 SAY NAME2 @11590
  END ELSE BEGIN PRINT ~#115: unreadable soldier donor; the scene actor cannot be copied.~ END
END ELSE BEGIN PRINT ~#115: soldier donor is absent; the other continuity resources are written.~ END
INCLUDE ~chriz-sod-remix/lib/csr115_dialog.tpa~
LAF csr115_dialog_apply END
