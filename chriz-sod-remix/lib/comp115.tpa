OUTER_SET csr115_s59470 = 59470 + csr115_shift
OUTER_SET csr115_s59471 = 59471 + csr115_shift
OUTER_SET csr115_s59472 = 59472 + csr115_shift
OUTER_SET csr115_s59473 = 59473 + csr115_shift
OUTER_SET csr115_s59474 = 59474 + csr115_shift
OUTER_SET csr115_s59772 = 59772 + csr115_shift
