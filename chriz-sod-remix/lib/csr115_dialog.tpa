// Component 115 writes its owned states in full. Only graph addresses and
// the mod's own appended state identities are read from the installed resources.
INCLUDE ~chriz-sod-remix/lib/overwrite_2da.tpa~

DEFINE_ACTION_FUNCTION csr115_tail
  INT_VAR count = 0 text = 0
  STR_VAR dialog = ~~
  RET base
BEGIN
  LAF csr_ensure_dlg_states INT_VAR count = 0 STR_VAR dialog = EVAL ~%dialog%~ END
  COPY_EXISTING - ~%dialog%.dlg~ ~override~
    READ_LONG 0x08 n READ_LONG 0x0c off
    SET base = n
    FOR (i = 0; i < n; ++i) BEGIN
      // Locate our own previously written state so a second tail replaces it.
      PATCH_IF LONG_AT (off + i * 16) = text BEGIN SET base = i SET i = n END
    END
  // Persist our state addresses separately from dialogue wording. Reinstalling
  // overwrites the same states even after a player changes every owned line.
  ACTION_IF FILE_EXISTS_IN_GAME ~CSR115S.2DA~ BEGIN
    COPY_EXISTING - ~CSR115S.2DA~ ~override~
      LPF csr_get_2da_cell STR_VAR row = EVAL ~%dialog%~ column = ~BASE~ RET value found END
      PATCH_IF found AND IS_AN_INT ~%value%~ BEGIN SET base = %value% END
  END ELSE BEGIN COPY ~.../csr115-state-addresses.2da~ ~override/CSR115S.2DA~ END
  COPY_EXISTING ~CSR115S.2DA~ ~override~
    LPF csr_set_2da_cell STR_VAR row = EVAL ~%dialog%~ column = ~BASE~ value = EVAL ~%base%~ END
  LAF csr_ensure_dlg_states INT_VAR count = base + count STR_VAR dialog = EVAL ~%dialog%~ END
END

DEFINE_ACTION_FUNCTION csr115_dialog_apply BEGIN
  LOAD_TRA ~chriz-sod-remix/languages/english/csr115.tra~
  OUTER_SET csr115_ch11 = 7
  ACTION_IF GAME_IS ~eet~ BEGIN OUTER_SET csr115_ch11 = 11 END
  OUTER_SET csr115_have_party_link = 0
  OUTER_SPRINT csr115_kh_j ~BDKHALIJ~
  ACTION_IF GAME_IS ~eet~ BEGIN OUTER_SPRINT csr115_kh_j ~KHALIJ~ END
  ACTION_IF FILE_EXISTS_IN_GAME ~BDDIALOG.2DA~ BEGIN
    COPY_EXISTING - ~BDDIALOG.2DA~ ~override~
      SET line = 0 SET column = (0 - 1)
      REPLACE_EVALUATE ~[^%WNL%]+~ BEGIN
        SPRINT source ~%MATCH0%~ SET tokens = 0
        INNER_PATCH ~%source%~ BEGIN
          REPLACE_TEXTUALLY ~//.*$~ ~~
          REPLACE_EVALUATE ~[^ %TAB%]+~ BEGIN SPRINT $word(~%tokens%~) ~%MATCH0%~ SET tokens += 1 END ~%MATCH0%~
        END
        PATCH_IF tokens > 0 BEGIN
          PATCH_IF line = 2 BEGIN
            FOR (i = 0; i < tokens; ++i) BEGIN
              PATCH_IF $word(~%i%~) STRING_EQUAL_CASE ~JOIN_DIALOG_FILE~ BEGIN SET column = i + 1 END
            END
          END ELSE PATCH_IF line > 2 AND column >= 0 AND column < tokens BEGIN
            PATCH_IF $word(~0~) STRING_EQUAL_CASE ~KHALID~ BEGIN SPRINT csr115_kh_j $word(~%column%~) SET csr115_have_party_link = 1 END
          END
          SET line += 1
        END
      END ~%source%~
  END
  // Supply a missing join-dialogue binding.
  ACTION_IF (~%csr115_kh_j%~ STRING_EQUAL ~***~) OR (~%csr115_kh_j%~ STRING_EQUAL ~0~) BEGIN
    OUTER_SET csr115_have_party_link = 0
    OUTER_SPRINT csr115_kh_j ~BDKHALIJ~
    ACTION_IF GAME_IS ~eet~ BEGIN OUTER_SPRINT csr115_kh_j ~KHALIJ~ END
  END
  ACTION_IF NOT csr115_have_party_link BEGIN
    LAF csr_ensure_bddialog END
    COPY_EXISTING ~BDDIALOG.2DA~ ~override~
      LPF csr_set_2da_cell STR_VAR row = ~KHALID~ column = ~JOIN_DIALOG_FILE~ value = EVAL ~%csr115_kh_j%~ END
  END
  LAF csr_ensure_dlg_states STR_VAR dialog = EVAL ~%csr115_kh_j%~ END
  OUTER_SET csr115_kh_delta = 0
  OUTER_SET csr115_have_quest = 0
  COPY_EXISTING - ~%csr115_kh_j%.dlg~ ~override~
    READ_LONG 0x08 csr115_party_count READ_LONG 0x0c off READ_LONG 0x18 triggers
    SET csr115_kh_delta = csr115_party_count - 174
    FOR (i = 0; i < csr115_party_count; ++i) BEGIN
      READ_SLONG (off + i * 16 + 12) trigger
      PATCH_IF trigger >= 0 BEGIN
        READ_LONG (triggers + trigger * 8) pos READ_LONG (triggers + trigger * 8 + 4) len
        READ_ASCII pos script (len)
        PATCH_IF ~%script%~ STRING_CONTAINS_REGEXP ~Global("BD_SDD223","GLOBAL",0)~ = 0 BEGIN
          SET csr115_kh_delta = i - 233 SET csr115_have_quest = 1 SET i = csr115_party_count
        END ELSE PATCH_IF ~%script%~ STRING_CONTAINS_REGEXP ~Global("bd_mdd206","global",1)~ = 0 BEGIN
          // An independent native entry supplies the same merge address if
          // the gift entry itself was removed. No text identity is needed.
          SET csr115_kh_delta = i - 190
        END
      END
    END
  OUTER_SPRINT csr115_jhd1166 ~BDJAHEIR~ OUTER_SET csr115_jhs1166 = 19
  OUTER_SPRINT csr115_jhd1167 ~BDJAHEIR~ OUTER_SET csr115_jhs1167 = 20
  OUTER_SPRINT csr115_jhd1176 ~BDJAHEIR~ OUTER_SET csr115_jhs1176 = 45
  LAF csr_ensure_dlg_states INT_VAR count = 126 STR_VAR dialog = ~BDKHALID~ END
  COPY_EXISTING - ~BDKHALID.dlg~ ~override~
    READ_LONG 0x0c so READ_LONG 0x14 tr
    PATCH_FOR_EACH key IN 1166 1167 1176 BEGIN
      SET state = key = 1176 ? 23 : 11
      SET transition = key = 1167 ? 1 : 0
      READ_LONG (so + state * 16 + 4) first READ_LONG (so + state * 16 + 8) n
      PATCH_IF transition < n BEGIN
        READ_ASCII (tr + (first + transition) * 32 + 20) dest (8) NULL
        READ_LONG (tr + (first + transition) * 32 + 28) target
        PATCH_IF NOT (LONG_AT (tr + (first + transition) * 32) BAND 8) BEGIN
          SPRINT EVAL ~csr115_jhd%key%~ ~%dest%~ SET EVAL ~csr115_jhs%key%~ = target
        END
      END
    END
  LAF csr_ensure_dlg_states INT_VAR count = 13 STR_VAR dialog = ~bdbfort~ END
  LAF csr_ensure_dlg_states INT_VAR count = 104 STR_VAR dialog = ~bdjaheir~ END
  LAF csr_ensure_dlg_states INT_VAR count = 32 STR_VAR dialog = ~bdbarghe~ END
  LAF csr_ensure_dlg_states INT_VAR count = 50 STR_VAR dialog = ~bdjegg~ END
  LAF csr_ensure_dlg_states INT_VAR count = 58 STR_VAR dialog = ~bdneera~ END
  LAF csr_ensure_dlg_states INT_VAR count = 10 STR_VAR dialog = ~bdvoghil~ END
  LAF csr_ensure_dlg_states INT_VAR count = 3 STR_VAR dialog = ~bdwynan~ END
  LAF csr_ensure_dlg_states INT_VAR count = 2 STR_VAR dialog = ~csr115ad~ END
  OUTER_SET csr115_kh_174 = 174 + csr115_kh_delta
  OUTER_SET csr115_kh_175 = 175 + csr115_kh_delta
  OUTER_SET csr115_kh_176 = 176 + csr115_kh_delta
  OUTER_SET csr115_kh_177 = 177 + csr115_kh_delta
  OUTER_SET csr115_kh_178 = 178 + csr115_kh_delta
  OUTER_SET csr115_kh_179 = 179 + csr115_kh_delta
