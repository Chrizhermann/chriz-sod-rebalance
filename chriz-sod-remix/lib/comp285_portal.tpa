// Own the downstairs activation, switch sound and map label. Keep gathering
// checks and the upper-arrival scripts outside this component's ownership.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~

DEFINE_ACTION_FUNCTION csr285_portal_preflight BEGIN
  // Callable entry point retained for component consumers.
END

DEFINE_ACTION_FUNCTION csr285_portal_install BEGIN
  OUTER_SET csr285_portal_x = 1354
  OUTER_SET csr285_portal_y = 1114
  ACTION_IF FILE_EXISTS_IN_GAME ~bd4600.are~ BEGIN
    COPY_EXISTING ~bd4600.are~ ~override~
      SET writable = SOURCE_SIZE >= 0xf4
      PATCH_IF writable BEGIN
        READ_LONG 0xa4 dc READ_LONG 0xa8 doff
        READ_LONG 0xc4 noff READ_LONG 0xc8 nc
        READ_LONG 0x7c voff READ_SHORT 0x80 vc
        SET writable = doff + dc * 0xc8 <= SOURCE_SIZE AND noff + nc * 0x34 <= SOURCE_SIZE
          AND voff + vc * 4 <= SOURCE_SIZE
      END
      PATCH_IF writable BEGIN
        SET door = (0 - 1)
        FOR (i = 0; i < dc; ++i) BEGIN
          READ_ASCII (doff + i * 0xc8) name (32) NULL
          READ_ASCII (doff + i * 0xc8 + 0x80) script (8) NULL
          PATCH_IF ~%name%~ STRING_EQUAL_CASE ~Door01~ OR ~%script%~ STRING_EQUAL_CASE ~BDELEV01~ BEGIN
            SET door = doff + i * 0xc8
            WRITE_ASCII (door + 0x58) ~~ #16
            WRITE_ASCII (door + 0x80) ~BDELEV01~ #8
            READ_SHORT (door + 0x74) csr285_portal_x
            READ_SHORT (door + 0x76) csr285_portal_y
          END
        END
        PATCH_IF door < 0 BEGIN
          // Append a replacement table so unrelated sections keep their offsets.
          READ_ASCII doff old_doors (dc * 0xc8)
          SET new_doors = BUFFER_LENGTH
          INSERT_BYTES new_doors ((dc + 1) * 0xc8)
          WRITE_ASCIIE new_doors ~%old_doors%~
          SET door = new_doors + dc * 0xc8
          WRITE_LONG 0xa8 new_doors WRITE_LONG 0xa4 (dc + 1)
          WRITE_ASCII door ~Door01~ #32
          WRITE_ASCII (door + 0x20) ~DOOR01~ #8
          WRITE_LONG (door + 0x28) 516
          WRITE_LONG (door + 0x2c) vc WRITE_LONG (door + 0x34) vc
          WRITE_SHORT (door + 0x30) 17 WRITE_SHORT (door + 0x32) 17
          PATCH_FOR_EACH rectangle IN 0x38 0x40 BEGIN
            WRITE_SHORT (door + rectangle) 1412 WRITE_SHORT (door + rectangle + 2) 1043
            WRITE_SHORT (door + rectangle + 4) 1448 WRITE_SHORT (door + rectangle + 6) 1085
          END
          WRITE_SHORT (door + 0x68) 8 WRITE_SHORT (door + 0x70) 1
          WRITE_ASCII (door + 0x80) ~BDELEV01~ #8
          PATCH_FOR_EACH point IN 0x74 0x90 0x94 BEGIN
            WRITE_SHORT (door + point) csr285_portal_x WRITE_SHORT (door + point + 2) csr285_portal_y
          END
          READ_ASCII voff old_vertices (vc * 4)
          SET new_vertices = BUFFER_LENGTH
          INSERT_BYTES new_vertices ((vc + 17) * 4)
          WRITE_ASCIIE new_vertices ~%old_vertices%~
          WRITE_LONG 0x7c new_vertices WRITE_SHORT 0x80 (vc + 17)
          DEFINE_ASSOCIATIVE_ARRAY polygon BEGIN
            0,1412 => 1069 1,1432 => 1085 2,1447 => 1074 3,1447 => 1071
            4,1446 => 1069 5,1442 => 1067 6,1442 => 1061 7,1448 => 1058
            8,1448 => 1056 9,1430 => 1043 10,1428 => 1044 11,1419 => 1050
            12,1419 => 1052 13,1420 => 1053 14,1420 => 1060 15,1415 => 1064 16,1412 => 1067
          END
          PHP_EACH polygon AS vertex => y BEGIN
            WRITE_SHORT (new_vertices + (vc + vertex_0) * 4) vertex_1
            WRITE_SHORT (new_vertices + (vc + vertex_0) * 4 + 2) y
          END
        END
        SET note = (0 - 1)
        FOR (i = 0; i < nc; ++i) BEGIN
          READ_SHORT (noff + i * 0x34) x READ_SHORT (noff + i * 0x34 + 2) y
          PATCH_IF x = 1340 AND y = 1150 BEGIN
            SET note = noff + i * 0x34
            SAY (note + 4) @28501
          END
        END
        PATCH_IF note < 0 BEGIN
          READ_ASCII noff old_notes (nc * 0x34)
          SET new_notes = BUFFER_LENGTH
          INSERT_BYTES new_notes ((nc + 1) * 0x34)
          WRITE_ASCIIE new_notes ~%old_notes%~
          SET note = new_notes + nc * 0x34
          WRITE_LONG 0xc4 new_notes WRITE_LONG 0xc8 (nc + 1)
          WRITE_SHORT note 1340 WRITE_SHORT (note + 2) 1150
          SAY (note + 4) @28501
          WRITE_SHORT (note + 8) 1 WRITE_SHORT (note + 10) 2
        END
      END ELSE BEGIN
        PATCH_PRINT ~#285: BD4600 area tables cannot be written; portal script is still installed.~
      END
    BUT_ONLY
  END ELSE BEGIN
    PRINT ~#285: BD4600 is absent; portal script is still installed.~
  END
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~bdelev01.bcs~ BEGIN
    MKDIR ~weidu_external/chriz-sod-remix~
    COPY ~.../csr285-empty-portal.baf~ ~weidu_external/chriz-sod-remix/bdelev01.baf~
    COMPILE ~weidu_external/chriz-sod-remix/bdelev01.baf~
  END
  COPY_EXISTING ~bdelev01.bcs~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      LPF csr_replace_script_blocks INT_VAR append = 1
        STR_VAR pattern = ~SetGlobal("bd_hellevator"\|StartCutSceneEx("bdcut5[56]"~
          replacement = ~IF
  Global("bd_hellevator","global",0)
  OR(2)
    Opened([PC])
    Closed([PC])
THEN
  RESPONSE #100
    StartCutSceneMode()
    ClearAllActions()
    SetGlobal("bd_hellevator","global",5)
    SetGlobal("bd_plot","global",560)
    CreateVisualEffect("DDOORH",[%csr285_portal_x%.%csr285_portal_y%])
    Wait(1)
    StartCutSceneEx("bdcut56",FALSE)
END

~ END
    END
  BUT_ONLY
END

