INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
INCLUDE ~chriz-sod-remix/lib/overwrite_2da.tpa~
// ============================================================
// Components 292-294 library — Imoen's handover into Shadows of Amn
// ============================================================
// Design (DECIDED 2026-10-17): docs/design/wave1/12-imoen-soa-handover.md.
// Shared by the component body (lib/comp292.tpa) and component 910, which
// hosts the same preparation in its skip helper when 910 is installed later.
//
// Every generated block uses these GLOBALs:
//   CSR_IMSOA_PREP   0 idle, 1 bring her here, 2 import, 6 bank, 3 choice 1:
//                    strip, 4 (choice 1: read) remove her, 5 she leaves the
//                    area, 7 choice 1: stand-in, 9 finished
//   CSR_IMSOA_TIMER  real-time step timeout
//   CSR_IMSOA_FAILED 1 she could not be brought here: her gear was not handed
//                    over, SoA banks it on arrival; 3 reported in SoA;
//                    4 "Imoen2" was no longer her (another script had replaced
//                    her), so SoA's own Imoen takes her place; 5 she could not
//                    leave the party, so the host's transition handed her over
//                    like any companion (EET carries her into SoA as she is)
//   CSR_IMSOA_D<ab>  choice 1: tome boost per ability score
//   CSR_IMSOA_BOOST  choice 1: 1 pending, 2 applied to SoA's Imoen, 3 not
//                    applied (the arriving Imoen is still hers, see comp292.tpa)
//   CSR_IMSOA_STANDIN choice 1: 1 once the stand-in has been given its actions
//   CSR_IMSOA_FB     SoA gear fallback progress
//   CSR_IMSOA_DUAL   choice 3: SoA conversion progress
//
// How EET treats a removed Imoen (lab, 2026-10-17): DestroySelf() takes her out
// of her area, but she stays in EET's list of global creatures, still marked as
// having been in the party, and does nothing until she is moved. MoveGlobal()
// to any other area brings her back with her queued actions. EET's AR0602 does
// exactly that for every Imoen who has been in the party and is not dead, so
// destroying her never makes EET create IMOEN10 (that needs !BeenInParty), and
// any action still queued on her runs when she arrives in Shadows of Amn: two
// leftover DestroySelf() actions removed her again there, and SoA's opening
// scene then waited for her forever. So nothing here queues an action on her
// that could outlive the step that needs it.
// An Imoen left alive in the area the transition starts from fares worse: the
// actions AR0602 queues on her before its MoveGlobal() (her SoA dialog and
// scripts) were lost in the lab, so she kept SoD's dialog and her BG1 script,
// and SoA's XP ladder never ran. So every choice ends with her removing
// herself, and EET brings her back the way it brings any companion.

// The six ability scores: STATS.IDS symbol (also the global suffix) => CRE
// offset of the base score.
ACTION_DEFINE_ASSOCIATIVE_ARRAY csr292_abilities BEGIN
  STR => 0x238
  INT => 0x23a
  WIS => 0x23b
  DEX => 0x23c
  CON => 0x23d
  CHR => 0x23e
END

// Component 910's helper receives the preparation through this template.
<<<<<<<< .../csr292skip.baf
%csr292_prep%
>>>>>>>>

// ------------------------------------------------------------
// Imoen's own BG1 chassis ability scores (the tome-boost baseline), returned
// as the array csr292_refs: ability symbol => score.
// ------------------------------------------------------------
DEFINE_ACTION_FUNCTION csr292_chassis_scores
  RET_ARRAY csr292_refs
BEGIN
  ACTION_DEFINE_ASSOCIATIVE_ARRAY csr292_refs BEGIN
    STR => 9 INT => 17 WIS => 11 DEX => 18 CON => 16 CHR => 16
  END
  ACTION_DEFINE_ASSOCIATIVE_ARRAY csr292_offsets BEGIN
    STR => 0x238 INT => 0x23a WIS => 0x23b DEX => 0x23c CON => 0x23d CHR => 0x23e
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~imoen2.cre~ BEGIN
    COPY_EXISTING - ~imoen2.cre~ ~override~
      PATCH_IF SOURCE_SIZE >= 0x23f BEGIN
        PHP_EACH csr292_offsets AS name => off BEGIN
          READ_BYTE off value DEFINE_ASSOCIATIVE_ARRAY csr292_refs BEGIN ~%name%~ => ~%value%~ END
        END
      END ELSE BEGIN PATCH_PRINT ~#292: Imoen's chassis is unreadable; native ability baselines apply.~ END
  END ELSE BEGIN PRINT ~#292: Imoen's chassis is absent; native ability baselines apply.~ END
END

// ------------------------------------------------------------
// Imoen must not start a conversation while she is handed over. LeaveParty()
// gives her the SoD campaign's post-party dialog (BDDIALOG.2DA
// POST_DIALOG_FILE; component 160 points it at csrimoen) and she opens it at
// once. csrimoen then offers to rejoin the party (lab, 2026-10-17), which in
// the middle of the preparation hands her over twice or removes a party
// member. Read only: returns that dialog and the states that can open a
// conversation (those with a trigger) as "first" and the space-separated
// "rest"; all empty when she has no post-party dialog in this game.
// ------------------------------------------------------------
DEFINE_ACTION_FUNCTION csr292_post_dialog RET dialog first rest source BEGIN
  OUTER_SPRINT dialog ~~ OUTER_SPRINT first ~~ OUTER_SPRINT rest ~~ OUTER_SPRINT source ~~
  ACTION_IF FILE_EXISTS_IN_GAME ~bddialog.2da~ BEGIN
    COPY_EXISTING - ~bddialog.2da~ ~override~
      LPF csr_get_2da_cell STR_VAR row = ~IMOEN2~ column = ~POST_DIALOG_FILE~ RET dialog = value END
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~%dialog%.dlg~ BEGIN
    COPY_EXISTING - ~%dialog%.dlg~ ~override~
      SET readable = SOURCE_SIZE >= 0x20
      PATCH_IF readable BEGIN
        READ_LONG 8 count READ_LONG 12 off READ_LONG 24 to READ_LONG 28 tc
        SET readable = off + count * 16 <= SOURCE_SIZE AND to + tc * 8 <= SOURCE_SIZE
      END
      PATCH_IF readable BEGIN
        FOR (i = 0; i < count; ++i) BEGIN
          READ_SLONG (off + i * 16 + 12) t
          PATCH_IF t >= 0 AND t < tc BEGIN
            READ_LONG (to + t * 8) pos READ_LONG (to + t * 8 + 4) len
            PATCH_IF pos + len <= SOURCE_SIZE BEGIN
              READ_ASCII pos trigger (len)
              INNER_PATCH_SAVE trigger ~%trigger%~ BEGIN
                REPLACE_TEXTUALLY ~OR(2)[ %TAB%%WNL%]*GlobalLT("CSR_IMSOA_PREP","GLOBAL",1)[ %TAB%%WNL%]*GlobalGT("CSR_IMSOA_PREP","GLOBAL",8)~ ~~
              END
              SPRINT source ~~~~~%source%
REPLACE_STATE_TRIGGER ~%dialog%~ %i% ~OR(2) GlobalLT("CSR_IMSOA_PREP","GLOBAL",1) GlobalGT("CSR_IMSOA_PREP","GLOBAL",8)
%trigger%~
~~~~~
              PATCH_IF ~%first%~ STRING_EQUAL ~~ BEGIN SPRINT first ~%i%~ END ELSE BEGIN SPRINT rest ~%rest% %i%~ END
            END
          END
        END
      END ELSE BEGIN PATCH_PRINT ~#292: Imoen's post-party dialogue table is unreadable; only its entry gates are unavailable.~ END
  END ELSE BEGIN PRINT ~#292: Imoen has no available post-party dialogue to gate.~ END
END

// ------------------------------------------------------------
// The effective EET import rules of one transition carrier script, as SoD-end
// skim blocks for Imoen. EET_end generates one rule per importable item:
//   IF Global("K#FrameDelay","LOCALS",0) PartyHasItem(X)
//   THEN TakePartyItem(X) DestroyItem(X) AddStoreItem("K#IMPORT",X,1,1)
//        Continue() END
// Each item gets one block: one copy into the same bag store when she carries
// it and the party does not (at most one copy, as EET imports for the party),
// and her own copy is destroyed as EET destroys the party's, so it is not also
// banked. The bank follows in a later pass (her DestroyItem must come first).
// AddStoreItem identifies each imported item even if a prior mod changed the
// surrounding rule. The original carrier is never rewritten.
// ------------------------------------------------------------
DEFINE_ACTION_FUNCTION csr292_skim_blocks
  STR_VAR
    script = ~~
    gate = ~~
  RET blocks count
BEGIN
  ACTION_CLEAR_ARRAY csr292_items
  OUTER_SET count = 0
  OUTER_SET csr292_rules = 0
  OUTER_SET csr292_odd = 0
  OUTER_SPRINT blocks ~~
  ACTION_IF FILE_EXISTS_IN_GAME ~%script%~ BEGIN
    COPY_EXISTING - ~%script%~ ~override~
      DECOMPILE_BCS_TO_BAF
      REPLACE_EVALUATE CASE_INSENSITIVE ~AddStoreItem("K#IMPORT","\([^"]+\)"~ BEGIN
        SPRINT item ~%MATCH1%~ TO_UPPER item
        DEFINE_ASSOCIATIVE_ARRAY csr292_items BEGIN ~%item%~ => 1 END
      END ~%MATCH0%~
  END ELSE BEGIN PRINT ~#292: the import-rule donor is absent; Imoen's gear uses the ordinary bank.~ END
  ACTION_PHP_EACH csr292_items AS csr292_item => csr292_ignored BEGIN
    OUTER_SPRINT blocks ~%blocks%
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",2)
  HasItem("%csr292_item%","IMOEN2")
  !PartyHasItem("%csr292_item%")
THEN
  RESPONSE #100
    AddStoreItem("K#IMPORT","%csr292_item%",1,1)
    ActionOverride("IMOEN2",DestroyItem("%csr292_item%"))
    Continue()
END
~
    OUTER_SET count += 1
  END
END

// ------------------------------------------------------------
// Choice 1: read her ability scores after the strip and store each increase
// over the BG1 chassis. One block per possible higher score.
// ------------------------------------------------------------
DEFINE_ACTION_FUNCTION csr292_read_blocks
  STR_VAR gate = ~~
  RET blocks
BEGIN
  LAF csr292_chassis_scores RET_ARRAY csr292_refs END
  OUTER_SPRINT blocks ~~
  ACTION_PHP_EACH csr292_refs AS csr292_name => csr292_ref BEGIN
    OUTER_FOR (csr292_v = csr292_ref + 1; csr292_v <= 25; ++csr292_v) BEGIN
      OUTER_SET csr292_d = csr292_v - csr292_ref
      OUTER_SPRINT blocks ~%blocks%
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",4)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
  CheckStat("IMOEN2",%csr292_v%,%csr292_name%)
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_D%csr292_name%","GLOBAL",%csr292_d%)
    Continue()
END
~
    END
  END
END

// ------------------------------------------------------------
// The complete SoD-end preparation for one host.
//   gate:   the host's own trigger lines (two-space indented)
//   bank:   the container in the host's area that receives her gear
//   script: the host's carrier script, whose import rules are mirrored
// ------------------------------------------------------------
DEFINE_ACTION_FUNCTION csr292_prep_text
  INT_VAR choice = 0
  STR_VAR
    gate = ~~
    bank = ~~
    script = ~~
  RET text
BEGIN
  LAF csr292_skim_blocks STR_VAR script = EVAL ~%script%~ gate = EVAL ~%gate%~ RET csr292_skims = blocks csr292_skim_count = count END
  OUTER_SET csr292_after_bank = (choice = 1) ? 3 : 4
  OUTER_SPRINT csr292_choice1 ~~
  OUTER_SPRINT csr292_standin ~~
  OUTER_SPRINT csr292_left ~SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)~
  OUTER_SPRINT csr292_late ~SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)~
  ACTION_IF (choice = 1) BEGIN
    LAF csr292_read_blocks STR_VAR gate = EVAL ~%gate%~ RET csr292_reads = blocks END
    // After the read she leaves her area (below). A stand-in made from
    // IMOEN10.CRE, whose script name is Imoen2 too, then appears here; "IMOEN2"
    // now finds it first because it is in this area (lab), and
    // MakeGlobalOverride() replaces her in EET's global list with it. It never
    // joined the party, so once it leaves the area as well, EET's AR0602 finds
    // no Imoen who has been in the party and creates its own IMOEN10, which then
    // replaces the stand-in. Actions are queued on the stand-in only once it is
    // seen in the area, so a failed creation leaves nothing queued on her. Every
    // timeout still ends the preparation with the boosts pending: SoA applies
    // them only to an Imoen without her SoD mark (K#PartySoD), and reports it if
    // she is still hers.
    OUTER_SPRINT csr292_choice1 ~
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",3)
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    ApplySpellRES("CSRIMSTR","IMOEN2")
    RealSetGlobalTimer("CSR_IMSOA_TIMER","GLOBAL",2)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",4)
    SetInterrupt(TRUE)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",4)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    Continue()
END
%csr292_reads%~
    OUTER_SPRINT csr292_left ~CreateCreatureObject("CSRIMST",Myself,0,0,0)
    RealSetGlobalTimer("CSR_IMSOA_TIMER","GLOBAL",3)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",7)~
    OUTER_SPRINT csr292_late ~SetGlobal("CSR_IMSOA_BOOST","GLOBAL",1)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)~
    OUTER_SPRINT csr292_standin ~
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",7)
  Global("CSR_IMSOA_STANDIN","GLOBAL",0)
  InMyArea("IMOEN2")
  !InPartyAllowDead("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_STANDIN","GLOBAL",1)
    ActionOverride("IMOEN2",MakeGlobalOverride())
    ActionOverride("IMOEN2",DestroySelf())
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",7)
  Global("CSR_IMSOA_STANDIN","GLOBAL",1)
  !InMyArea("IMOEN2")
  !BeenInParty("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_BOOST","GLOBAL",1)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",7)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
THEN
  RESPONSE #100
    ClearActions("IMOEN2")
    SetGlobal("CSR_IMSOA_BOOST","GLOBAL",1)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END~
  END
  // Every choice: two seconds after the bank she removes herself, as the
  // carrier removes every companion (never while in the party: that leaves an
  // empty portrait, lab 2026-10-17). EET's AR0602 then brings her back with all
  // of its own actions, or, for choice 1, finds only the stand-in. Should she be
  // back in the party by then, the host's transition hands her over like any
  // companion (CSR_IMSOA_FAILED 5). The timeout clears what is still queued on
  // her and lets the transition go ahead.
  OUTER_SPRINT csr292_tail ~%csr292_choice1%
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",4)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
  InPartyAllowDead("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_FAILED","GLOBAL",5)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
    SetInterrupt(TRUE)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",4)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
  !InPartyAllowDead("IMOEN2")
THEN
  RESPONSE #100
    ActionOverride("IMOEN2",DestroySelf())
    RealSetGlobalTimer("CSR_IMSOA_TIMER","GLOBAL",3)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",5)
    SetInterrupt(TRUE)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",5)
  !InMyArea("IMOEN2")
THEN
  RESPONSE #100
    %csr292_left%
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",5)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
THEN
  RESPONSE #100
    ClearActions("IMOEN2")
    %csr292_late%
END
%csr292_standin%~
  // Only an Imoen who has been in the party and is alive is handled. Anyone
  // else is EET's business: a never-recruited csrimo means EET creates IMOEN10.
  // A dead Imoen is left untouched; EET's AR0602 has no case for her, and SoA's
  // opening scene then never gives control back (lab, 2026-10-17; open design
  // question, see the design doc). The final block holds every rule below the
  // preparation (the host's own transition) until it has finished.
  //
  // Before she leaves the party she is marked as a SoD party member
  // (K#PartySoD), exactly as EET's own SoD epilogue marks her (BD6200, chapter
  // 13), which the remix's ending replaces: EET's IMOEN_ removes an unmarked
  // BG1 Imoen once she is out of the party after BG1 (lab, 2026-10-17). The
  // mark is verified on her before LeaveParty. An Imoen elsewhere gets the mark
  // queued ahead of the move, so it is the first thing she does on arrival.
  // Her post-party dialog cannot open while the preparation runs (see
  // csr292_post_dialog); should she still be back in the party before her gear
  // is handed over, the preparation returns to that step until its time runs out.
  OUTER_SPRINT text ~// chriz-sod-remix 292-294: Imoen's SoD-end handover preparation.
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",0)
  OR(2)
    !BeenInParty("IMOEN2")
    StateCheck("IMOEN2",STATE_REALLY_DEAD)
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",0)
  BeenInParty("IMOEN2")
  !StateCheck("IMOEN2",STATE_REALLY_DEAD)
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",1)
    RealSetGlobalTimer("CSR_IMSOA_TIMER","GLOBAL",15)
    SetInterrupt(TRUE)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  InMyArea("IMOEN2")
  StateCheck("IMOEN2",STATE_REALLY_DEAD)
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
  InPartyAllowDead("IMOEN2")
THEN
  RESPONSE #100
    ClearActions("IMOEN2")
    SetGlobal("CSR_IMSOA_FAILED","GLOBAL",5)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
  !InPartyAllowDead("IMOEN2")
  BeenInParty("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_FAILED","GLOBAL",1)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
  !BeenInParty("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_FAILED","GLOBAL",4)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  InMyArea("IMOEN2")
  NextTriggerObject("IMOEN2")
  !Global("K#PartySoD","LOCALS",1)
THEN
  RESPONSE #100
    ActionOverride("IMOEN2",SetGlobal("K#PartySoD","LOCALS",1))
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  !InPartyAllowDead("IMOEN2")
  InMyArea("IMOEN2")
  NextTriggerObject("IMOEN2")
  Global("K#PartySoD","LOCALS",1)
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",2)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  InPartyAllowDead("IMOEN2")
  InMyArea("IMOEN2")
  NextTriggerObject("IMOEN2")
  Global("K#PartySoD","LOCALS",1)
THEN
  RESPONSE #100
    ActionOverride("IMOEN2",LeaveParty())
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  !InMyArea("IMOEN2")
THEN
  RESPONSE #100
    ActionOverride("IMOEN2",SetGlobal("K#PartySoD","LOCALS",1))
    MoveGlobalObject("IMOEN2",Myself)
END
IF
%gate%
  OR(2)
    Global("CSR_IMSOA_PREP","GLOBAL",2)
    Global("CSR_IMSOA_PREP","GLOBAL",6)
  InPartyAllowDead("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",1)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",2)
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    Continue()
END
%csr292_skims%
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",2)
THEN
  RESPONSE #100
    RealSetGlobalTimer("CSR_IMSOA_TIMER","GLOBAL",1)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",6)
    SetInterrupt(TRUE)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",6)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    ActionOverride("%bank%",TakeCreatureItems("IMOEN2",0))
    SmallWait(4)
    RealSetGlobalTimer("CSR_IMSOA_TIMER","GLOBAL",2)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",%csr292_after_bank%)
    SetInterrupt(TRUE)
END
%csr292_tail%
IF
%gate%
  !Global("CSR_IMSOA_PREP","GLOBAL",9)
THEN
  RESPONSE #100
    NoAction()
END
~
END

// ------------------------------------------------------------
// Host 1: component 290's carrier clone. The preparation goes directly after
// its safety guard, which must stay the first block (component 291 checks it),
// and before every transition rule; until it finishes, the carrier waits.
// ------------------------------------------------------------
DEFINE_ACTION_FUNCTION csr292_host_ending INT_VAR choice = 0 BEGIN
  LAF csr_ensure_script STR_VAR script = ~CSRETBGT~ END
  OUTER_SET bank_found = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~bd4300.are~ BEGIN
    COPY_EXISTING - ~bd4300.are~ ~override~
      PATCH_IF SOURCE_SIZE >= 0x76 BEGIN
        READ_LONG 0x70 off READ_SHORT 0x74 count
        PATCH_IF off + count * 192 <= SOURCE_SIZE BEGIN
          FOR (i = 0; i < count; ++i) BEGIN
            READ_ASCII (off + i * 192) name (32) NULL
            INNER_PATCH_SAVE name ~%name%~ BEGIN REPLACE_TEXTUALLY ~ ~ ~~ END
            PATCH_IF ~%name%~ STRING_EQUAL_CASE ~K#ImportContainer~ BEGIN SET bank_found = 1 END
          END
        END
      END
  END
  ACTION_IF NOT bank_found BEGIN INCLUDE ~chriz-sod-remix/lib/comp290_bank.tpa~ END
  COPY_EXISTING ~CSRETBGT.bcs~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      LPF csr_replace_script_blocks STR_VAR pattern = ~"CSR_IMSOA_\|"CSR_ENDING_FAILED"~ replacement = ~~ END
    END
  BUT_ONLY
  LAF csr292_prep_text INT_VAR choice STR_VAR gate = ~  Global("K#FrameDelay","LOCALS",0)~ bank = ~K#ImportContainer~ script = ~CSRETBGT.BCS~ RET csr292_prep = text END
  EXTEND_TOP ~CSRETBGT.bcs~ ~.../csr292skip.baf~ EVALUATE_BUFFER
  EXTEND_TOP ~CSRETBGT.bcs~ ~chriz-sod-remix/baf/csr290guard.baf~ USING ~chriz-sod-remix/languages/english/csr290guard.tra~
END

DEFINE_ACTION_FUNCTION csr292_host_skip INT_VAR choice = 0 BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~csrskask.bcs~ BEGIN
    COPY_EXISTING ~csrskask.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        LPF csr_replace_script_blocks STR_VAR pattern = ~"CSR_IMSOA_~ replacement = ~~ END
      END
    BUT_ONLY
    LAF csr292_prep_text INT_VAR choice
      STR_VAR gate = ~  Global("CSR_SKIP_PHASE","GLOBAL",1)
  Global("CSR_SKIP_FAILED","GLOBAL",0)~ bank = ~PlayerChest00~ script = ~K#TELBGT.BCS~ RET csr292_prep = text END
    EXTEND_TOP ~csrskask.bcs~ ~.../csr292skip.baf~ EVALUATE_BUFFER
  END
END
