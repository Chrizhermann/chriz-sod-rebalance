// ============================================================
// Components 292-294 library — Imoen's handover into Shadows of Amn
// ============================================================
// Design (DECIDED 2026-10-17): docs/design/wave1/12-imoen-soa-handover.md.
// Shared by the component body (lib/comp292.tpa) and component 910, which
// hosts the same preparation in its skip helper when 910 is installed later.
//
// Every generated block uses these GLOBALs:
//   CSR_IMSOA_PREP   0 idle, 1 bring her here, 2 import + bank, 3-5 choice 1
//                    (strip, read, remove her), 9 finished
//   CSR_IMSOA_TIMER  real-time step timeout
//   CSR_IMSOA_FAILED 1 she could not be brought here: her gear was not handed
//                    over, SoA banks it on arrival; 2 choice 1 could not confirm
//                    her removal (gear already handed over); 3 reported in SoA;
//                    4 she no longer existed (another script removed her), so
//                    SoA's own Imoen takes her place; 5 she could not leave
//                    the party, so the host's transition handled her like any
//                    companion and SoA's own Imoen takes her place
//   CSR_IMSOA_D<ab>  choice 1: tome boost per ability score
//   CSR_IMSOA_BOOST  choice 1: 1 boosts pending, 2 applied
//   CSR_IMSOA_FB     SoA gear fallback progress
//   CSR_IMSOA_DUAL   choice 3: SoA conversion progress

// The six ability scores: STATS.IDS symbol (also the global suffix) => CRE
// offset of the base score.
ACTION_DEFINE_ASSOCIATIVE_ARRAY csr292_abilities BEGIN
  STR => 0x238
  INT => 0x23a
  WIS => 0x23b
  DEX => 0x23c
  CON => 0x23d
  CHR => 0x23e
END

// Component 910's helper receives the preparation through this template.
<<<<<<<< .../csr292skip.baf
%csr292_prep%
>>>>>>>>

// ------------------------------------------------------------
// Imoen's own BG1 chassis ability scores (the tome-boost baseline), returned
// as the array csr292_refs: ability symbol => score.
// ------------------------------------------------------------
DEFINE_ACTION_FUNCTION csr292_chassis_scores
  RET_ARRAY csr292_refs
BEGIN
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~imoen2.cre~ BEGIN
    FAIL ~chriz-sod-remix 292-294: imoen2.cre (Imoen's BG1 chassis) is missing; cannot measure her tome boosts.~
  END
  // A function body does not see the caller's arrays: its own offset table.
  ACTION_DEFINE_ASSOCIATIVE_ARRAY csr292_offsets BEGIN
    STR => 0x238  INT => 0x23a  WIS => 0x23b  DEX => 0x23c  CON => 0x23d  CHR => 0x23e
  END
  ACTION_CLEAR_ARRAY csr292_refs
  COPY_EXISTING - ~imoen2.cre~ ~override~
    READ_ASCII 0 csr292_sig (8)
    PATCH_IF NOT (~%csr292_sig%~ STRING_EQUAL_CASE ~CRE V1.0~) BEGIN
      PATCH_FAIL ~chriz-sod-remix 292-294: imoen2.cre is not a CRE V1.0 file.~
    END
    PATCH_PHP_EACH csr292_offsets AS csr292_name => csr292_off BEGIN
      READ_BYTE csr292_off csr292_value
      // A zero or out-of-range score would turn every real score into a boost.
      PATCH_IF ((csr292_value < 1) OR (csr292_value > 25)) BEGIN
        PATCH_FAIL ~chriz-sod-remix 292-294: imoen2.cre has an invalid %csr292_name% score (%csr292_value%).~
      END
      DEFINE_ASSOCIATIVE_ARRAY csr292_refs BEGIN ~%csr292_name%~ => ~%csr292_value%~ END
    END
  BUT_ONLY
END

// ------------------------------------------------------------
// The effective EET import rules of one transition carrier script, as SoD-end
// skim blocks for Imoen. EET_end generates one rule per importable item:
//   IF Global("K#FrameDelay","LOCALS",0) PartyHasItem(X)
//   THEN TakePartyItem(X) DestroyItem(X) AddStoreItem("K#IMPORT",X,1,1)
//        Continue() END
// Each item gets one block: one copy into the same bag store when she carries
// it and the party does not (at most one copy, as EET imports for the party).
// Every K#IMPORT addition in the script must belong to such a rule; another
// shape cannot be mirrored faithfully and stops the install.
// ------------------------------------------------------------
DEFINE_ACTION_FUNCTION csr292_skim_blocks
  STR_VAR
    script = ~~
    gate = ~~
  RET blocks count
BEGIN
  ACTION_CLEAR_ARRAY csr292_items
  OUTER_SET count = 0
  OUTER_SET csr292_rules = 0
  OUTER_SET csr292_odd = 0
  OUTER_SPRINT blocks ~~
  COPY_EXISTING - ~%script%~ ~override~
    DECOMPILE_BCS_TO_BAF
    REPLACE_TEXTUALLY ~//[^%LNL%%MNL%]*~ ~~
    REPLACE_TEXTUALLY ~[ %TAB%%LNL%%MNL%]+~ ~~
    COUNT_REGEXP_INSTANCES CASE_INSENSITIVE EXACT_MATCH ~AddStoreItem("K#IMPORT",~ csr292_adds
    REPLACE_EVALUATE CASE_INSENSITIVE
      ~IFGlobal("K#FrameDelay","LOCALS",0)PartyHasItem("\([^"]+\)")THENRESPONSE#100TakePartyItem("\([^"]+\)")DestroyItem("\([^"]+\)")AddStoreItem("K#IMPORT","\([^"]+\)",1,1)Continue()END~
    BEGIN
      SPRINT csr292_item ~%MATCH1%~
      TO_UPPER csr292_item
      PATCH_IF ((~%MATCH2%~ STRING_EQUAL_CASE ~%csr292_item%~) AND
                (~%MATCH3%~ STRING_EQUAL_CASE ~%csr292_item%~) AND
                (~%MATCH4%~ STRING_EQUAL_CASE ~%csr292_item%~)) BEGIN
        SET csr292_rules += 1
        DEFINE_ASSOCIATIVE_ARRAY csr292_items BEGIN ~%csr292_item%~ => 1 END
      END ELSE BEGIN
        SET csr292_odd += 1
      END
    END ~~
    PATCH_IF ((csr292_odd != 0) OR (csr292_rules != csr292_adds)) BEGIN
      PATCH_FAIL ~chriz-sod-remix 292-294: %script% has %csr292_adds% K#IMPORT additions but only %csr292_rules% recognised EET import rules; refusing to guess how Imoen's items would be imported.~
    END
  BUT_ONLY
  ACTION_PHP_EACH csr292_items AS csr292_item => csr292_ignored BEGIN
    OUTER_SPRINT blocks ~%blocks%
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",2)
  HasItem("%csr292_item%","IMOEN2")
  !PartyHasItem("%csr292_item%")
THEN
  RESPONSE #100
    AddStoreItem("K#IMPORT","%csr292_item%",1,1)
    Continue()
END
~
    OUTER_SET count += 1
  END
END

// ------------------------------------------------------------
// Choice 1: read her ability scores after the strip and store each increase
// over the BG1 chassis. One block per possible higher score.
// ------------------------------------------------------------
DEFINE_ACTION_FUNCTION csr292_read_blocks
  STR_VAR gate = ~~
  RET blocks
BEGIN
  LAF csr292_chassis_scores RET_ARRAY csr292_refs END
  OUTER_SPRINT blocks ~~
  ACTION_PHP_EACH csr292_refs AS csr292_name => csr292_ref BEGIN
    OUTER_FOR (csr292_v = csr292_ref + 1; csr292_v <= 25; ++csr292_v) BEGIN
      OUTER_SET csr292_d = csr292_v - csr292_ref
      OUTER_SPRINT blocks ~%blocks%
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",4)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
  CheckStat("IMOEN2",%csr292_v%,%csr292_name%)
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_D%csr292_name%","GLOBAL",%csr292_d%)
    Continue()
END
~
    END
  END
END

// ------------------------------------------------------------
// The complete SoD-end preparation for one host.
//   gate:   the host's own trigger lines (two-space indented)
//   bank:   the container in the host's area that receives her gear
//   script: the host's carrier script, whose import rules are mirrored
// ------------------------------------------------------------
DEFINE_ACTION_FUNCTION csr292_prep_text
  INT_VAR choice = 0
  STR_VAR
    gate = ~~
    bank = ~~
    script = ~~
  RET text
BEGIN
  ACTION_IF ((choice < 1) OR (choice > 3)) BEGIN
    FAIL ~chriz-sod-remix 292-294: internal error, unknown Imoen choice %choice%.~
  END
  LAF csr292_skim_blocks STR_VAR script = EVAL ~%script%~ gate = EVAL ~%gate%~ RET csr292_skims = blocks csr292_skim_count = count END
  OUTER_SET csr292_after_bank = (choice = 1) ? 3 : 9
  OUTER_SPRINT csr292_choice1 ~~
  ACTION_IF (choice = 1) BEGIN
    LAF csr292_read_blocks STR_VAR gate = EVAL ~%gate%~ RET csr292_reads = blocks END
    OUTER_SPRINT csr292_choice1 ~
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",3)
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    ApplySpellRES("CSRIMSTR","IMOEN2")
    RealSetGlobalTimer("CSR_IMSOA_TIMER","GLOBAL",2)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",4)
    SetInterrupt(TRUE)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",4)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    Continue()
END
%csr292_reads%
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",4)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
THEN
  RESPONSE #100
    ActionOverride("IMOEN2",DestroySelf())
    RealSetGlobalTimer("CSR_IMSOA_TIMER","GLOBAL",3)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",5)
    SetInterrupt(TRUE)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",5)
  !BeenInParty("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_BOOST","GLOBAL",1)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",5)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_FAILED","GLOBAL",2)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",5)
THEN
  RESPONSE #100
    ActionOverride("IMOEN2",DestroySelf())
END
~
  END
  // Only an Imoen who has been in the party and is alive is handled. Anyone
  // else is EET's business: a never-recruited csrimo means EET creates IMOEN10;
  // a dead Imoen keeps EET's own handling. The final block holds every rule
  // below the preparation (the host's own transition) until it has finished.
  //
  // Before she leaves the party she is marked as a SoD party member
  // (K#PartySoD), exactly as EET's own SoD epilogue marks her (BD6200, chapter
  // 13), which the remix's ending replaces: EET's IMOEN_ removes an unmarked
  // BG1 Imoen once she is out of the party after BG1 (lab, 2026-10-17). The
  // mark is verified on her before LeaveParty. An Imoen elsewhere gets the mark
  // queued ahead of the move, so it is the first thing she does on arrival.
  OUTER_SPRINT text ~// chriz-sod-remix 292-294: Imoen's SoD-end handover preparation.
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",0)
  OR(2)
    !BeenInParty("IMOEN2")
    StateCheck("IMOEN2",STATE_REALLY_DEAD)
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",0)
  BeenInParty("IMOEN2")
  !StateCheck("IMOEN2",STATE_REALLY_DEAD)
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",1)
    RealSetGlobalTimer("CSR_IMSOA_TIMER","GLOBAL",15)
    SetInterrupt(TRUE)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  InMyArea("IMOEN2")
  StateCheck("IMOEN2",STATE_REALLY_DEAD)
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
  InPartyAllowDead("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_FAILED","GLOBAL",5)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
  !InPartyAllowDead("IMOEN2")
  BeenInParty("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_FAILED","GLOBAL",1)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  RealGlobalTimerExpired("CSR_IMSOA_TIMER","GLOBAL")
  !BeenInParty("IMOEN2")
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_FAILED","GLOBAL",4)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",9)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  InMyArea("IMOEN2")
  NextTriggerObject("IMOEN2")
  !Global("K#PartySoD","LOCALS",1)
THEN
  RESPONSE #100
    ActionOverride("IMOEN2",SetGlobal("K#PartySoD","LOCALS",1))
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  !InPartyAllowDead("IMOEN2")
  InMyArea("IMOEN2")
  NextTriggerObject("IMOEN2")
  Global("K#PartySoD","LOCALS",1)
THEN
  RESPONSE #100
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",2)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  InPartyAllowDead("IMOEN2")
  InMyArea("IMOEN2")
  NextTriggerObject("IMOEN2")
  Global("K#PartySoD","LOCALS",1)
THEN
  RESPONSE #100
    ActionOverride("IMOEN2",LeaveParty())
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",1)
  !InMyArea("IMOEN2")
THEN
  RESPONSE #100
    ActionOverride("IMOEN2",SetGlobal("K#PartySoD","LOCALS",1))
    MoveGlobalObject("IMOEN2",Myself)
END
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",2)
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    Continue()
END
%csr292_skims%
IF
%gate%
  Global("CSR_IMSOA_PREP","GLOBAL",2)
THEN
  RESPONSE #100
    ActionOverride("%bank%",TakeCreatureItems("IMOEN2",0))
    SmallWait(4)
    SetGlobal("CSR_IMSOA_PREP","GLOBAL",%csr292_after_bank%)
    SetInterrupt(TRUE)
END
%csr292_choice1%
IF
%gate%
  !Global("CSR_IMSOA_PREP","GLOBAL",9)
THEN
  RESPONSE #100
    NoAction()
END
~
END

// ------------------------------------------------------------
// Host 1: component 290's carrier clone. The preparation goes directly after
// its safety guard, which must stay the first block (component 291 checks it),
// and before every transition rule; until it finishes, the carrier waits.
// ------------------------------------------------------------
DEFINE_ACTION_FUNCTION csr292_host_ending
  INT_VAR choice = 0
BEGIN
  ACTION_FOR_EACH csr292_res IN ~CSRETBGT.BCS~ ~BD4300.ARE~ BEGIN
    ACTION_IF NOT FILE_EXISTS_IN_GAME ~%csr292_res%~ BEGIN
      FAIL ~chriz-sod-remix 292-294: component 290 resource %csr292_res% is missing.~
    END
  END
  // The bank container 290 added to BD4300.
  OUTER_SET csr292_banks = 0
  COPY_EXISTING - ~BD4300.ARE~ ~override~
    READ_LONG 0x70 csr292_co
    READ_SHORT 0x74 csr292_cn
    FOR (csr292_i = 0; csr292_i < csr292_cn; ++csr292_i) BEGIN
      READ_ASCII (csr292_co + csr292_i * 0xc0) csr292_name (32) NULL
      PATCH_IF (~%csr292_name%~ STRING_EQUAL_CASE ~K#ImportContainer~) BEGIN
        SET csr292_banks += 1
      END
    END
  BUT_ONLY
  ACTION_IF (csr292_banks != 1) BEGIN
    FAIL ~chriz-sod-remix 292-294: expected component 290's one K#ImportContainer in BD4300, found %csr292_banks%.~
  END
  LAF csr292_prep_text
    INT_VAR choice
    STR_VAR
      gate = ~  Global("K#FrameDelay","LOCALS",0)~
      bank = ~K#ImportContainer~
      script = ~CSRETBGT.BCS~
    RET csr292_prep = text
  END
  // Same guard expressions as component 291 (original or corrected guard).
  OUTER_SPRINT csr292_nl ~%MNL%?%LNL%~
  OUTER_SPRINT csr292_guard ~^IF%csr292_nl%  OR(2)%csr292_nl%    !AreaCheck("BD4300")%csr292_nl%    !Exists("K#ImportContainer")[^%WNL%]*%csr292_nl%THEN%csr292_nl%  RESPONSE #100%csr292_nl%    DisplayStringNoName(Player1,[0-9]+)[^%WNL%]*%csr292_nl%    FadeFromColor(\[1\.0\],0)%csr292_nl%\(    SetCutSceneLite(FALSE)%csr292_nl%\)?    EndCutSceneMode()%csr292_nl%    SetGlobal("CSR_ENDING_FAILED","GLOBAL",1)%csr292_nl%    DestroySelf()%csr292_nl%END~
  COPY_EXISTING ~CSRETBGT.BCS~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      COUNT_REGEXP_INSTANCES CASE_SENSITIVE EXACT_MATCH ~CSR_IMSOA_PREP~ csr292_done
      PATCH_IF (csr292_done != 0) BEGIN
        PATCH_FAIL ~chriz-sod-remix 292-294: CSRETBGT.BCS already contains an Imoen handover preparation.~
      END
      COUNT_REGEXP_INSTANCES ~%csr292_guard%~ csr292_guards
      READ_ASCII 0 csr292_script (BUFFER_LENGTH)
      PATCH_IF ((csr292_guards != 1) OR (INDEX(~%csr292_guard%~ ~%csr292_script%~) != 0)) BEGIN
        PATCH_FAIL ~chriz-sod-remix 292-294: component 290's safety guard is not the single first block of CSRETBGT.BCS; refusing to place the Imoen preparation.~
      END
      REPLACE_TEXTUALLY ~\(%csr292_guard%\)~ ~\1
%csr292_prep%~
    END
  BUT_ONLY
END

// ------------------------------------------------------------
// Host 2: component 910's skip helper (phase 1, before its own Imoen rules,
// which find nothing left to move afterwards). 910's bank chest is moved on
// to BD6100 by 910 itself; its carrier there is EET's K#TELBGT.
// ------------------------------------------------------------
DEFINE_ACTION_FUNCTION csr292_host_skip
  INT_VAR choice = 0
BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~csrskask.bcs~ BEGIN
    COPY_EXISTING - ~csrskask.bcs~ ~override~
      DECOMPILE_BCS_TO_BAF
      COUNT_REGEXP_INSTANCES CASE_SENSITIVE EXACT_MATCH ~CSR_IMSOA_PREP~ csr292_done
      COUNT_REGEXP_INSTANCES CASE_SENSITIVE EXACT_MATCH ~Global("CSR_SKIP_PHASE","GLOBAL",1)~ csr292_phase1
      PATCH_IF (csr292_done != 0) BEGIN
        PATCH_FAIL ~chriz-sod-remix 292-294: csrskask.bcs already contains an Imoen handover preparation.~
      END
      PATCH_IF (csr292_phase1 = 0) BEGIN
        PATCH_FAIL ~chriz-sod-remix 292-294: csrskask.bcs has no skip phase 1; unsupported component 910 helper.~
      END
    BUT_ONLY
    LAF csr292_prep_text
      INT_VAR choice
      STR_VAR
        gate = ~  Global("CSR_SKIP_PHASE","GLOBAL",1)
  Global("CSR_SKIP_FAILED","GLOBAL",0)~
        bank = ~PlayerChest00~
        script = ~K#TELBGT.BCS~
      RET csr292_prep = text
    END
    EXTEND_TOP ~csrskask.bcs~ ~.../csr292skip.baf~ EVALUATE_BUFFER
  END
END
