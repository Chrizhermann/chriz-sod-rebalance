// Decided encounter cuts and the chapter award. Actor addresses are labels
// plus native occurrences; builds, coordinates and schedules are not preconditions.
INCLUDE ~chriz-sod-remix/lib/comp270_lists.tpa~

INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
OUTER_SET csr_sod_tlk_shift = 0
ACTION_IF GAME_IS ~eet~ BEGIN OUTER_SET csr_sod_tlk_shift = 200000 END
OUTER_SET csr270_str258042 = csr_sod_tlk_shift + 58042
OUTER_SET csr270_str258043 = csr_sod_tlk_shift + 58043
OUTER_SET csr270_str261936 = csr_sod_tlk_shift + 61936
OUTER_SET csr270_str261937 = csr_sod_tlk_shift + 61937
MKDIR ~weidu_external/work/chriz-sod-remix/270~
COPY ~chriz-sod-remix/baf/csr270award.baf~ ~weidu_external/work/chriz-sod-remix/270/award.baf~
  EVALUATE_BUFFER
  READ_ASCII 0 csr_award (BUFFER_LENGTH)
LAF csr_ensure_script STR_VAR script = ~bd5300~ END
COPY_EXISTING ~bd5300.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    LPF csr_replace_script_blocks INT_VAR in_place = 1
      STR_VAR pattern = ~Switch("bd_sdd350_ihj","bd5300")\|^[ %TAB%]+Dead("bdkherr")~ replacement = EVAL ~%csr_award%~ END
  END
BUT_ONLY
