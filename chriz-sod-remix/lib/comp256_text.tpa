// Own Phossey's explanation text and the complete Bwoosh description.
// Foreign dialogue transitions, item mechanics and shared TLK strings stay intact.
INCLUDE ~chriz-sod-remix/lib/overwrite.tpa~
DEFINE_ACTION_FUNCTION csr256_text_preflight BEGIN
END
DEFINE_ACTION_FUNCTION csr256_text_install BEGIN
  LAF csr_ensure_dlg_states INT_VAR count = 4 STR_VAR dialog = ~BDPHOSSE~ END
  COPY_EXISTING ~BDPHOSSE.DLG~ ~override~
    READ_LONG 0xc state_offset
    SAY (state_offset + 3 * 16) @25602
  BUT_ONLY
  ACTION_IF FILE_EXISTS_IN_GAME ~BDBWOOSH.ITM~ BEGIN
    COPY_EXISTING ~BDBWOOSH.ITM~ ~override~
      PATCH_IF SOURCE_SIZE >= 0x72 BEGIN
        READ_LONG 0x4c csr256_bwoosh_weight
        SPRINT csr256_bwoosh_description @25603
        SAY_EVALUATED 0x54 ~%csr256_bwoosh_description%~
      END ELSE BEGIN PATCH_PRINT ~#256: Bwoosh item header is unreadable; only this description is unchanged.~ END
    BUT_ONLY
  END ELSE BEGIN PRINT ~#256: Bwoosh item is absent.~ END
END
