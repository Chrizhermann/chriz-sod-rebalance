OUTER_SET csr291_s65677 = 65677 + csr291_shift
OUTER_SET csr291_s65678 = 65678 + csr291_shift
<<<<<<<< .../csr291-fallback.d
%csr291_fallback%
>>>>>>>>
<<<<<<<< .../csr291-transitions.d
%csr291_transitions%
>>>>>>>>
LAF csr_ensure_dlg_states INT_VAR count = 4 STR_VAR dialog = ~BDDAZZO~ RET csr291_old_BDDAZZO = existing_states END
OUTER_SPRINT csr291_transitions ~~
ACTION_IF csr291_old_BDDAZZO <= 2 BEGIN
  LAF csr_dlg_state_weight INT_VAR state = 2 STR_VAR dialog = ~BDDAZZO~ RET csr291_weight = clause END
  OUTER_SPRINT csr291_fallback ~~~~~
REPLACE ~BDDAZZO~
IF %csr291_weight% ~~ THEN BEGIN 2
  SAY #%csr291_s65677%
  IF ~~ THEN DO ~StartCutSceneMode()
StartCutSceneEx("bdcut60",FALSE)
~ EXIT
END
END
~~~~~
  COMPILE EVALUATE_BUFFER ~.../csr291-fallback.d~
END ELSE BEGIN
  COPY_EXISTING - ~BDDAZZO.dlg~ ~override~ READ_LONG 12 so READ_LONG (so + 2 * 16 + 8) nt
  ACTION_IF nt <= 0 BEGIN
    OUTER_SPRINT csr291_transitions ~~~~~%csr291_transitions%
EXTEND_BOTTOM ~BDDAZZO~ 2
  IF ~~ THEN DO ~StartCutSceneMode()
StartCutSceneEx("bdcut60",FALSE)
~ EXIT
END
~~~~~
  END
END
ACTION_IF csr291_old_BDDAZZO <= 3 BEGIN
  LAF csr_dlg_state_weight INT_VAR state = 3 STR_VAR dialog = ~BDDAZZO~ RET csr291_weight = clause END
  OUTER_SPRINT csr291_fallback ~~~~~
REPLACE ~BDDAZZO~
IF %csr291_weight% ~~ THEN BEGIN 3
  SAY #%csr291_s65678%
  IF ~~ THEN DO ~StartCutSceneMode()
StartCutSceneEx("bdcut60",FALSE)
~ EXIT
END
END
~~~~~
  COMPILE EVALUATE_BUFFER ~.../csr291-fallback.d~
END ELSE BEGIN
  COPY_EXISTING - ~BDDAZZO.dlg~ ~override~ READ_LONG 12 so READ_LONG (so + 3 * 16 + 8) nt
  ACTION_IF nt <= 0 BEGIN
    OUTER_SPRINT csr291_transitions ~~~~~%csr291_transitions%
EXTEND_BOTTOM ~BDDAZZO~ 3
  IF ~~ THEN DO ~StartCutSceneMode()
StartCutSceneEx("bdcut60",FALSE)
~ EXIT
END
~~~~~
  END
END
COMPILE EVALUATE_BUFFER ~.../csr291-transitions.d~
