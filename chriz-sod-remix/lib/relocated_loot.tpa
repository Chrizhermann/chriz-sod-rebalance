// Relocation never identifies an item automatically. Read its source flag
// when available; conflicting copies use the unidentified result. Authored
// destination quantities, charges and other flags always get written.
DEFINE_PATCH_FUNCTION csr_loot_id_run
  INT_VAR item_offset = 0 item_count = 0
  STR_VAR item_resref = ~~
  RET csr_id_seen csr_id_value
BEGIN
  PATCH_IF item_offset <= BUFFER_LENGTH AND item_count <= (BUFFER_LENGTH - item_offset) / 20 BEGIN
    FOR (csr_id_i = 0; csr_id_i < item_count; ++csr_id_i) BEGIN
      SET csr_id_pos = item_offset + csr_id_i * 20
      READ_ASCII csr_id_pos csr_id_ref (8) NULL
      PATCH_IF ~%csr_id_ref%~ STRING_EQUAL_CASE ~%item_resref%~ BEGIN
        SET csr_id_bit = LONG_AT (csr_id_pos + 16) BAND 1
        PATCH_IF csr_id_seen BEGIN SET csr_id_value = csr_id_value BAND csr_id_bit END
        ELSE BEGIN SET csr_id_value = csr_id_bit END
        SET csr_id_seen = 1
      END
    END
  END ELSE BEGIN PATCH_PRINT ~SoD Remix: unreadable source item table; the reward is still granted.~ END
END
DEFINE_ACTION_FUNCTION csr_relocated_loot_id
  STR_VAR source = ~~ item_resref = ~~ RET flags id_bit
BEGIN
  OUTER_SPRINT source EVALUATE_BUFFER ~%source%~
  OUTER_SPRINT item_resref EVALUATE_BUFFER ~%item_resref%~
  OUTER_SET csr_id_seen = 0 OUTER_SET csr_id_value = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~%source%~ BEGIN
    COPY_EXISTING - ~%source%~ ~override~
      PATCH_IF (~%SOURCE_EXT%~ STRING_EQUAL_CASE ~CRE~) AND BUFFER_LENGTH >= 0x2d4 BEGIN
        READ_LONG 0x2bc csr_id_offset READ_LONG 0x2c0 csr_id_count
        LPF csr_loot_id_run INT_VAR item_offset = csr_id_offset item_count = csr_id_count
          STR_VAR item_resref RET csr_id_seen csr_id_value END
      END ELSE PATCH_IF (~%SOURCE_EXT%~ STRING_EQUAL_CASE ~ARE~) AND BUFFER_LENGTH >= 0x7c BEGIN
        READ_LONG 0x70 csr_id_co READ_SHORT 0x74 csr_id_cc
        READ_LONG 0x78 csr_id_io READ_SHORT 0x76 csr_id_ic
        PATCH_IF csr_id_co <= BUFFER_LENGTH AND csr_id_cc <= (BUFFER_LENGTH - csr_id_co) / 0xc0 AND
          csr_id_io <= BUFFER_LENGTH AND csr_id_ic <= (BUFFER_LENGTH - csr_id_io) / 20 BEGIN
          FOR (csr_id_c = 0; csr_id_c < csr_id_cc; ++csr_id_c) BEGIN
            READ_LONG (csr_id_co + csr_id_c * 0xc0 + 0x40) csr_id_first
            READ_LONG (csr_id_co + csr_id_c * 0xc0 + 0x44) csr_id_count
            PATCH_IF csr_id_first <= csr_id_ic AND csr_id_count <= csr_id_ic - csr_id_first BEGIN
              LPF csr_loot_id_run INT_VAR item_offset = csr_id_io + csr_id_first * 20 item_count = csr_id_count
                STR_VAR item_resref RET csr_id_seen csr_id_value END
            END
          END
        END
      END
  END
  ACTION_IF NOT csr_id_seen BEGIN
    PRINT ~SoD Remix: %item_resref% has no readable source instance in %source%; granting it unidentified.~
  END
  OUTER_SET id_bit = csr_id_value
  ACTION_IF id_bit BEGIN OUTER_SPRINT flags ~IDENTIFIED~ END
  ELSE BEGIN OUTER_SPRINT flags ~NONE~ END
END
