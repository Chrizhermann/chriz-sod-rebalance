// #256 creature construction. No writes on INCLUDE or in preflight.
// Call csr256_spells_preflight first. Caller supplies csr256_xp_mage,
// csr256_xp_guard, csr256_xp_elemental; each slot has the same XP in every tier.
// Fresh resource clones only: this never changes the donors or existing actors.

DEFINE_PATCH_FUNCTION csr256_check_cre INT_VAR expected_class = 0 BEGIN
  PATCH_IF (SOURCE_SIZE < 0x2d4) BEGIN
    PATCH_FAIL ~#256: truncated creature donor.~
  END
  READ_ASCII 0 csr256_sig (8)
  READ_BYTE 0x33 csr256_ev
  PATCH_IF (NOT (~%csr256_sig%~ STRING_EQUAL ~CRE V1.0~) OR
            (csr256_ev > 1) OR
            ((expected_class > 0) AND (BYTE_AT 0x273 != expected_class)) OR
            (LONG_AT 0x20 != 0)) BEGIN
    PATCH_FAIL ~#256: unsupported creature signature, class, or active state.~
  END
  SET csr256_es = 48
  PATCH_IF csr256_ev BEGIN SET csr256_es = 264 END
  DEFINE_ASSOCIATIVE_ARRAY csr256_tables BEGIN
    0x2a0 => 12  0x2a8 => 16  0x2b0 => 12
    0x2bc => 20  0x2c4 => ~%csr256_es%~
  END
  PHP_EACH csr256_tables AS csr256_ptr => csr256_size BEGIN
    READ_LONG csr256_ptr csr256_off
    READ_LONG (csr256_ptr + 4) csr256_count
    PATCH_IF ((csr256_count < 0) OR (csr256_off < 0) OR
              (csr256_off > SOURCE_SIZE) OR
              (csr256_count > (SOURCE_SIZE - csr256_off) / csr256_size) OR
              ((csr256_count > 0) AND (csr256_off < 0x2d4))) BEGIN
      PATCH_FAIL ~#256: creature variable table is out of bounds.~
    END
    PHP_EACH csr256_tables AS csr256_ptr2 => csr256_size2 BEGIN
      READ_LONG csr256_ptr2 csr256_off2
      READ_LONG (csr256_ptr2 + 4) csr256_count2
      PATCH_IF ((csr256_ptr != csr256_ptr2) AND
                (csr256_count > 0) AND (csr256_count2 > 0) AND
                (csr256_off < csr256_off2 + csr256_count2 * csr256_size2) AND
                (csr256_off2 < csr256_off + csr256_count * csr256_size)) BEGIN
        PATCH_FAIL ~#256: overlapping creature variable tables.~
      END
    END
    PATCH_IF ((csr256_count > 0) AND
              (csr256_off < LONG_AT 0x2b8 + 80) AND
              (LONG_AT 0x2b8 < csr256_off + csr256_count * csr256_size)) BEGIN
      PATCH_FAIL ~#256: creature table overlaps equipment slots.~
    END
  END
  READ_LONG 0x2b8 csr256_slots
  READ_LONG 0x2c0 csr256_items
  PATCH_IF ((csr256_slots < 0x2d4) OR (csr256_slots > SOURCE_SIZE - 80)) BEGIN
    PATCH_FAIL ~#256: invalid creature equipment slots.~
  END
  FOR (csr256_i = 0; csr256_i < 38; csr256_i += 1) BEGIN
    READ_SHORT (csr256_slots + csr256_i * 2) csr256_ix
    PATCH_IF ((csr256_ix != 0xffff) AND (csr256_ix >= csr256_items)) BEGIN
      PATCH_FAIL ~#256: creature equipment index exceeds item table.~
    END
  END
  // Reviewed chassis infrastructure only. Do not inherit hidden spell grants,
  // contingencies, invulnerability, or arbitrary foreign local variables.
  READ_LONG 0x2c4 csr256_fo
  READ_LONG 0x2c8 csr256_fc
  FOR (csr256_i = 0; csr256_i < csr256_fc; csr256_i += 1) BEGIN
    SET csr256_b = csr256_fo + csr256_i * csr256_es
    PATCH_IF csr256_ev BEGIN
      READ_LONG (csr256_b + 8) csr256_op
      READ_ASCII (csr256_b + 40) csr256_resource (8) NULL
    END ELSE BEGIN
      READ_SHORT csr256_b csr256_op
      READ_ASCII (csr256_b + 20) csr256_resource (8) NULL
    END
    PATCH_IF NOT ((csr256_op = 233) OR (csr256_op = 293) OR
      (csr256_op = 187) OR
      ((csr256_op = 326) AND
        ((~%csr256_resource%~ STRING_EQUAL_CASE ~C0PR#AT1~) OR
         (~%csr256_resource%~ STRING_EQUAL_CASE ~C0PR#MF1~) OR
         (~%csr256_resource%~ STRING_EQUAL_CASE ~C0PR#FS1~) OR
         (~%csr256_resource%~ STRING_EQUAL_CASE ~C0PR#EK1~) OR
         (~%csr256_resource%~ STRING_EQUAL_CASE ~C0PR#CL~))) OR
      ((csr256_op = 272) AND (~%csr256_resource%~ STRING_EQUAL_CASE ~C0FSDROP~)) OR
      ((expected_class = 0) AND (csr256_op = 206) AND
        ((~%csr256_resource%~ STRING_EQUAL_CASE ~SPOGRE01~) OR
         (~%csr256_resource%~ STRING_EQUAL_CASE ~SPPR720~)))) BEGIN
      PATCH_FAIL ~#256: unreviewed donor effect %csr256_op% (%csr256_resource%); refusing to duplicate encounter effects.~
    END
  END
END

DEFINE_PATCH_FUNCTION csr256_check_fist BEGIN
  PATCH_IF (SOURCE_SIZE < 0x72) BEGIN PATCH_FAIL ~#256: truncated elemental fist.~ END
  READ_ASCII 0 csr256_sig (8)
  READ_LONG 0x64 csr256_ao
  READ_SHORT 0x68 csr256_ac
  READ_LONG 0x6a csr256_fo
  PATCH_IF (NOT (~%csr256_sig%~ STRING_EQUAL ~ITM V1  ~) OR
            (csr256_ac != 1) OR (csr256_ao < 0x72) OR
            (csr256_ao > SOURCE_SIZE - 56) OR
            (BYTE_AT csr256_ao != 1)) BEGIN
    PATCH_FAIL ~#256: elemental fist is not the reviewed single melee ability.~
  END
  READ_SHORT (csr256_ao + 0x1e) csr256_fc
  READ_SHORT (csr256_ao + 0x20) csr256_first
  PATCH_IF ((csr256_fo < 0x72) OR (csr256_fo > SOURCE_SIZE) OR
            (csr256_first + csr256_fc > (SOURCE_SIZE - csr256_fo) / 48)) BEGIN
    PATCH_FAIL ~#256: elemental fist effects are out of bounds.~
  END
END

// BG:EE+SoD has ELEARG01 and SUMELEAR, but not BG2's ELEAR01/ELEARL01
// or ELEARL.ITM. Prefer the reviewed EET chassis; normalize the clean SoD
// fallback clones below. Never use the quest guardian BDEARTHE.
DEFINE_ACTION_FUNCTION csr256_earth_donors
  RET csr256_earth_l csr256_earth_s csr256_earth_weapon csr256_fallback_l csr256_fallback_s
BEGIN
  OUTER_SPRINT csr256_earth_l ~ELEARL01~
  OUTER_SPRINT csr256_earth_s ~ELEAR01~
  OUTER_SPRINT csr256_earth_weapon ~ELEARL~
  OUTER_SET csr256_fallback_l = 0
  OUTER_SET csr256_fallback_s = 0
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~ELEARL01.CRE~ BEGIN
    OUTER_SPRINT csr256_earth_l ~SUMELEAR~
    OUTER_SET csr256_fallback_l = 1
  END
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~ELEAR01.CRE~ BEGIN
    OUTER_SPRINT csr256_earth_s ~ELEARG01~
    OUTER_SET csr256_fallback_s = 1
  END
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~ELEARL.ITM~ BEGIN
    OUTER_SPRINT csr256_earth_weapon ~ELEAR~
  END
END

DEFINE_ACTION_FUNCTION csr256_creatures_preflight BEGIN
  LAF csr256_earth_donors RET csr256_earth_l csr256_earth_s csr256_earth_weapon csr256_fallback_l csr256_fallback_s END
  ACTION_FOR_EACH csr256_req IN
    ~BDOLONEI.CRE~ ~BDCRUE45.CRE~ ~BDELFIRL.CRE~ ~BDELFIRM.CRE~
    ~BDELFIRG.CRE~ ~%csr256_earth_l%.CRE~ ~%csr256_earth_s%.CRE~ ~ELEARG01.CRE~
    ~STAF01.ITM~ ~DART01.ITM~ ~CLCK12.ITM~ ~POTN52.ITM~
    ~HELM01.ITM~ ~PLAT01.ITM~ ~SW2H02.ITM~ ~IMMUNE2.ITM~
    ~FIREELEL.ITM~ ~FIREELEM.ITM~ ~%csr256_earth_weapon%.ITM~ ~ELEAR.ITM~ BEGIN
    ACTION_IF NOT FILE_EXISTS_IN_GAME ~%csr256_req%~ BEGIN
      FAIL ~#256: missing required creature/equipment resource %csr256_req%.~
    END
  END
  ACTION_FOR_EACH csr256_donor IN ~BDOLONEI~ ~BDCRUE45~ ~BDELFIRL~
    ~BDELFIRM~ ~BDELFIRG~ ~%csr256_earth_l%~ ~%csr256_earth_s%~ ~ELEARG01~ BEGIN
    OUTER_SET csr256_expected = 0
    ACTION_IF (~%csr256_donor%~ STRING_EQUAL ~BDOLONEI~) BEGIN OUTER_SET csr256_expected = 1 END
    ACTION_IF (~%csr256_donor%~ STRING_EQUAL ~BDCRUE45~) BEGIN OUTER_SET csr256_expected = 2 END
    COPY_EXISTING ~%csr256_donor%.CRE~ ~override~
      LPF csr256_check_cre INT_VAR expected_class = csr256_expected END
    BUT_ONLY
  END
  ACTION_FOR_EACH csr256_fist IN ~FIREELEL~ ~%csr256_earth_weapon%~ BEGIN
    COPY_EXISTING ~%csr256_fist%.ITM~ ~override~ LPF csr256_check_fist END BUT_ONLY
  END
  ACTION_FOR_EACH csr256_new IN ~CSR256FM~ ~CSR256CM~ ~CSR256G1~ ~CSR256G2~
    ~CSR26E1L~ ~CSR26E1S~ ~CSR26E1G~ ~CSR26E2L~ ~CSR26E2S~
    ~CSR26F1L~ ~CSR26F1S~ ~CSR26F1G~ ~CSR26F2L~ ~CSR26F2S~ BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%csr256_new%.CRE~ BEGIN
      FAIL ~#256: owned creature name %csr256_new% already exists.~
    END
  END
  ACTION_IF (FILE_EXISTS_IN_GAME ~CSR26ELW.ITM~ OR FILE_EXISTS_IN_GAME ~CSR26FLW.ITM~) BEGIN
    FAIL ~#256: owned lesser-elemental weapon name already exists.~
  END
  ACTION_IF ((csr256_xp_mage < 0) OR (csr256_xp_guard < 0) OR (csr256_xp_elemental < 0)) BEGIN
    FAIL ~#256: invalid fixed encounter XP allocation.~
  END
  // Keep the approved book valid on both vanilla and SR. Protection from Fire
  // is level 3 in vanilla, level 4 in SR. Remove one offensive Fireball copy
  // on vanilla; retain Haste, both Flame Arrows and every defensive reserve.
  ACTION_IF NOT ((csr256_protfire_level = 3) OR (csr256_protfire_level = 4)) BEGIN
    FAIL ~#256: unsupported Protection from Fire spell level.~
  END
  // Other level changes need a new reviewed allocation. Detect those before
  // the first owned item/creature is written, rather than overfilling a book.
  ACTION_DEFINE_ASSOCIATIVE_ARRAY csr256_expected_levels BEGIN
    stoneskin => 4 mirrorimage => 2 shield => 1 fireshield => 4
    spiritarmor => 4 minordeflect => 3 haste => 3 fireball => 3
    flamearrow => 3 slow => 3 glitterdust => 2 grease => 1
    breach => 5 malison => 4 magicmissile => 1
  END
  ACTION_PHP_EACH csr256_expected_levels AS csr256_key => csr256_expected_level BEGIN
    OUTER_SET csr256_actual_level = EVAL ~csr256_%csr256_key%_level~
    ACTION_IF (csr256_actual_level != csr256_expected_level) BEGIN
      FAIL ~#256: %csr256_key% changed spell level; the finite level-13 book requires a reviewed allocation.~
    END
  END
END

DEFINE_PATCH_FUNCTION csr256_identity STR_VAR dv = ~~ ai = ~~ BEGIN
  WRITE_ASCIIE 0x248 ~%ai%~ #8
  WRITE_ASCII 0x250 ~~ #8
  WRITE_ASCII 0x258 ~~ #8
  WRITE_ASCII 0x260 ~~ #8
  WRITE_ASCII 0x268 ~~ #8
  WRITE_ASCIIE 0x280 ~%dv%~ #32
  WRITE_ASCII 0x2cc ~~ #8
  WRITE_BYTE 0x270 255
  WRITE_BYTE 0x274 0
  WRITE_LONG 0x10 0
  WRITE_LONG 0x20 0
  WRITE_LONG 0x1c 0
  // Opcode187 stores local variables. None of the original encounter's
  // no-combat/prebuff/retreat flags may be carried into a new actor.
  LPF DELETE_EFFECT INT_VAR match_opcode = 187 END
  REMOVE_KNOWN_SPELLS
  REMOVE_MEMORIZED_SPELLS
END

DEFINE_PATCH_FUNCTION csr256_add_spell INT_VAR spell_level = 1 copies = 1 STR_VAR spell_res = ~~ BEGIN
  SET csr256_zero_level = spell_level - 1
  ADD_KNOWN_SPELL ~%spell_res%~ (csr256_zero_level) wizard
  ADD_MEMORIZED_SPELL ~%spell_res%~ (csr256_zero_level) wizard (copies)
END

// ADD_MEMORIZED_SPELL requires an existing slot record for that spell level.
// Donors can have sparse books, so create every wizard level explicitly.
DEFINE_PATCH_FUNCTION csr256_wizard_slots BEGIN
  READ_LONG 0x2a8 csr256_old_off
  READ_LONG 0x2ac csr256_old_n
  SET csr256_old_size = csr256_old_n * 16
  DELETE_BYTES csr256_old_off csr256_old_size
  PATCH_FOR_EACH csr256_pointer IN 0x2a0 0x2b0 0x2b8 0x2bc 0x2c4 BEGIN
    READ_LONG csr256_pointer csr256_offset
    PATCH_IF (csr256_offset >= csr256_old_off + csr256_old_size) BEGIN
      WRITE_LONG csr256_pointer (csr256_offset - csr256_old_size)
    END
  END
  SET csr256_new_off = BUFFER_LENGTH
  INSERT_BYTES csr256_new_off 96
  WRITE_LONG 0x2a8 csr256_new_off
  WRITE_LONG 0x2ac 6
  FOR (csr256_l = 0; csr256_l < 6; csr256_l += 1) BEGIN
    WRITE_SHORT (csr256_new_off + csr256_l * 16) csr256_l
    WRITE_SHORT (csr256_new_off + csr256_l * 16 + 6) 1
  END
END

DEFINE_PATCH_FUNCTION csr256_verify_book BEGIN
  DEFINE_ASSOCIATIVE_ARRAY csr256_caps BEGIN 0 => 5 1 => 5 2 => 5 3 => 4 4 => 4 5 => 2 END
  READ_LONG 0x2a8 csr256_mio
  READ_LONG 0x2ac csr256_mic
  FOR (csr256_i = 0; csr256_i < csr256_mic; csr256_i += 1) BEGIN
    SET csr256_b = csr256_mio + csr256_i * 16
    READ_SHORT csr256_b csr256_l
    READ_SHORT (csr256_b + 6) csr256_type
    READ_LONG (csr256_b + 12) csr256_n
    PATCH_IF ((csr256_type != 1) OR (csr256_l > 5)) BEGIN
      PATCH_IF (csr256_n != 0) BEGIN PATCH_FAIL ~#256: unexpected innate/divine/high-level combat spell.~ END
      WRITE_SHORT (csr256_b + 2) 0
      WRITE_SHORT (csr256_b + 4) 0
    END ELSE BEGIN
      SET csr256_cap = $csr256_caps(~%csr256_l%~)
      PATCH_IF (csr256_n > csr256_cap) BEGIN PATCH_FAIL ~#256: rebuilt wizard book exceeds the level-13 budget.~ END
      WRITE_SHORT (csr256_b + 2) csr256_cap
      WRITE_SHORT (csr256_b + 4) csr256_cap
    END
  END
END

DEFINE_ACTION_FUNCTION csr256_creatures_install BEGIN
  LAF csr256_earth_donors RET csr256_earth_l csr256_earth_s csr256_earth_weapon csr256_fallback_l csr256_fallback_s END
  // Only the lesser clones get softened weapons. Preserve on-hit effects
  // (including troll-finishing infrastructure) and all original item bytes
  // except base damage and enchantment. Never alter a shared elemental fist.
  COPY_EXISTING ~%csr256_earth_weapon%.ITM~ ~override/CSR26ELW.ITM~
    READ_LONG 0x64 csr256_ao
    WRITE_LONG 0x60 2
    WRITE_SHORT (csr256_ao + 0x16) 6
    WRITE_SHORT (csr256_ao + 0x18) 2
    WRITE_SHORT (csr256_ao + 0x1a) 0
  COPY_EXISTING ~FIREELEL.ITM~ ~override/CSR26FLW.ITM~
    READ_LONG 0x64 csr256_ao
    WRITE_LONG 0x60 2
    WRITE_SHORT (csr256_ao + 0x16) 6
    WRITE_SHORT (csr256_ao + 0x18) 1
    WRITE_SHORT (csr256_ao + 0x1a) 0

  ACTION_FOR_EACH csr256_role IN ~F~ ~C~ BEGIN
    OUTER_SPRINT csr256_ai ~CSR26FMA~
    OUTER_SPRINT csr256_name ~Crusader Fire Mage~
    ACTION_IF (~%csr256_role%~ STRING_EQUAL ~C~) BEGIN
      OUTER_SPRINT csr256_ai ~CSR26CMA~
      OUTER_SPRINT csr256_name ~Crusader Earth Mage~
    END
    COPY_EXISTING ~BDOLONEI.CRE~ ~override/CSR256%csr256_role%M.CRE~
      LPF csr256_identity STR_VAR dv = EVAL ~CSR256%csr256_role%M~ ai = EVAL ~%csr256_ai%~ END
      LPF csr256_wizard_slots END
      SAY NAME1 ~%csr256_name%~
      SAY NAME2 ~%csr256_name%~
      // The donor is a named story mage; discard her personal voice lines.
      FOR (csr256_sound = 0xa4; csr256_sound < 0x234; csr256_sound += 4) BEGIN
        WRITE_LONG csr256_sound 0xffffffff
      END
      WRITE_LONG 0x14 csr256_xp_mage
      WRITE_SHORT 0x24 52
      WRITE_SHORT 0x26 52
      WRITE_BYTE 0x234 13
      WRITE_BYTE 0x235 0
      WRITE_BYTE 0x236 0
      WRITE_LONG 0x244 0x40000000
      WRITE_BYTE 0x52 16
      WRITE_BYTE 0x54 11
      WRITE_BYTE 0x55 7
      WRITE_BYTE 0x56 9
      WRITE_BYTE 0x57 11
      WRITE_BYTE 0x58 8
      REMOVE_CRE_ITEMS
      ADD_CRE_ITEM ~STAF01~ #0 #0 #0 ~IDENTIFIED~ ~WEAPON1~ EQUIP
      ADD_CRE_ITEM ~DART01~ #20 #0 #0 ~IDENTIFIED~ ~WEAPON2~
      ADD_CRE_ITEM ~CLCK12~ #0 #0 #0 ~IDENTIFIED&UNDROPPABLE~ ~ARMOR~ EQUIP
      ADD_CRE_ITEM ~POTN52~ #1 #0 #0 ~IDENTIFIED~ ~QITEM1~
      LPF csr256_add_spell INT_VAR spell_level = csr256_stoneskin_level copies = 2 STR_VAR spell_res = EVAL ~%csr256_stoneskin_res%~ END
      LPF csr256_add_spell INT_VAR spell_level = csr256_mirrorimage_level copies = 3 STR_VAR spell_res = EVAL ~%csr256_mirrorimage_res%~ END
      LPF csr256_add_spell INT_VAR spell_level = csr256_shield_level STR_VAR spell_res = EVAL ~%csr256_shield_res%~ END
      LPF csr256_add_spell INT_VAR spell_level = csr256_breach_level STR_VAR spell_res = EVAL ~%csr256_breach_res%~ END
      LPF csr256_add_spell INT_VAR spell_level = csr256_magicmissile_level copies = 3 STR_VAR spell_res = EVAL ~%csr256_magicmissile_res%~ END
      PATCH_IF (~%csr256_role%~ STRING_EQUAL ~F~) BEGIN
        LPF csr256_add_spell INT_VAR spell_level = csr256_fireshield_level STR_VAR spell_res = EVAL ~%csr256_fireshield_res%~ END
        LPF csr256_add_spell INT_VAR spell_level = csr256_protfire_level STR_VAR spell_res = EVAL ~%csr256_protfire_res%~ END
        LPF csr256_add_spell INT_VAR spell_level = csr256_haste_level STR_VAR spell_res = EVAL ~%csr256_haste_res%~ END
        LPF csr256_add_spell INT_VAR spell_level = csr256_flamearrow_level copies = 2 STR_VAR spell_res = EVAL ~%csr256_flamearrow_res%~ END
        SET csr256_fireballs = 2
        PATCH_IF (csr256_protfire_level = 3) BEGIN SET csr256_fireballs = 1 END
        LPF csr256_add_spell INT_VAR spell_level = csr256_fireball_level copies = csr256_fireballs STR_VAR spell_res = EVAL ~%csr256_fireball_res%~ END
      END ELSE BEGIN
        LPF csr256_add_spell INT_VAR spell_level = csr256_spiritarmor_level STR_VAR spell_res = EVAL ~%csr256_spiritarmor_res%~ END
        LPF csr256_add_spell INT_VAR spell_level = csr256_minordeflect_level copies = 2 STR_VAR spell_res = EVAL ~%csr256_minordeflect_res%~ END
        LPF csr256_add_spell INT_VAR spell_level = csr256_glitterdust_level copies = 2 STR_VAR spell_res = EVAL ~%csr256_glitterdust_res%~ END
        LPF csr256_add_spell INT_VAR spell_level = csr256_slow_level copies = 3 STR_VAR spell_res = EVAL ~%csr256_slow_res%~ END
        LPF csr256_add_spell INT_VAR spell_level = csr256_grease_level STR_VAR spell_res = EVAL ~%csr256_grease_res%~ END
        LPF csr256_add_spell INT_VAR spell_level = csr256_malison_level STR_VAR spell_res = EVAL ~%csr256_malison_res%~ END
      END
      LPF csr256_verify_book END
  END
  ACTION_FOR_EACH csr256_slot IN ~1~ ~2~ BEGIN
    COPY_EXISTING ~BDCRUE45.CRE~ ~override/CSR256G%csr256_slot%.CRE~
      LPF csr256_identity STR_VAR dv = EVAL ~CSR256G%csr256_slot%~ ai = ~CSR26MEL~ END
      SAY NAME1 ~Crusader Veteran~
      SAY NAME2 ~Crusader Veteran~
      WRITE_LONG 0x14 csr256_xp_guard
      REMOVE_CRE_ITEMS
      ADD_CRE_ITEM ~HELM01~ #0 #0 #0 ~IDENTIFIED~ ~HELMET~ EQUIP
      ADD_CRE_ITEM ~PLAT01~ #0 #0 #0 ~IDENTIFIED&UNDROPPABLE~ ~ARMOR~ EQUIP
      ADD_CRE_ITEM ~SW2H02~ #0 #0 #0 ~IDENTIFIED&UNDROPPABLE~ ~WEAPON1~ EQUIP TWOHANDED
      ADD_CRE_ITEM ~POTN52~ #1 #0 #0 ~IDENTIFIED~ ~QITEM1~
  END
  ACTION_FOR_EACH csr256_element IN ~E~ ~F~ BEGIN
    ACTION_FOR_EACH csr256_slot IN ~1~ ~2~ BEGIN
      ACTION_FOR_EACH csr256_tier IN ~L~ ~S~ ~G~ BEGIN
        ACTION_IF NOT ((~%csr256_slot%~ STRING_EQUAL ~2~) AND (~%csr256_tier%~ STRING_EQUAL ~G~)) BEGIN
          OUTER_SPRINT csr256_donor ~%csr256_earth_s%~
          OUTER_SPRINT csr256_weapon ~ELEAR~
          ACTION_IF (~%csr256_element%~ STRING_EQUAL ~E~) BEGIN
            ACTION_IF (~%csr256_tier%~ STRING_EQUAL ~L~) BEGIN
              OUTER_SPRINT csr256_donor ~%csr256_earth_l%~
              OUTER_SPRINT csr256_weapon ~CSR26ELW~
            END
            ACTION_IF (~%csr256_tier%~ STRING_EQUAL ~G~) BEGIN OUTER_SPRINT csr256_donor ~ELEARG01~ END
          END ELSE BEGIN
            OUTER_SPRINT csr256_donor ~BDELFIRM~
            OUTER_SPRINT csr256_weapon ~FIREELEM~
            ACTION_IF (~%csr256_tier%~ STRING_EQUAL ~L~) BEGIN
              OUTER_SPRINT csr256_donor ~BDELFIRL~
              OUTER_SPRINT csr256_weapon ~CSR26FLW~
            END
            ACTION_IF (~%csr256_tier%~ STRING_EQUAL ~G~) BEGIN OUTER_SPRINT csr256_donor ~BDELFIRG~ END
          END
          COPY_EXISTING ~%csr256_donor%.CRE~ ~override/CSR26%csr256_element%%csr256_slot%%csr256_tier%.CRE~
            LPF csr256_identity STR_VAR dv = EVAL ~CSR256%csr256_element%%csr256_slot%~ ai = ~CSR26MEL~ END
            WRITE_LONG 0x14 csr256_xp_elemental
            PATCH_IF (~%csr256_element%~ STRING_EQUAL ~E~) BEGIN
              PATCH_IF ((csr256_fallback_l AND (~%csr256_tier%~ STRING_EQUAL ~L~)) OR
                        (csr256_fallback_s AND (~%csr256_tier%~ STRING_EQUAL ~S~))) BEGIN
                // Both clean fallback donors share the reviewed AC2, STR19,
                // one attack, resistance profile and tier-appropriate animation.
                // These are the only differing combat fields to normalize.
                WRITE_BYTE 0x234 10
                PATCH_IF (~%csr256_tier%~ STRING_EQUAL ~L~) BEGIN
                  WRITE_SHORT 0x24 80 WRITE_SHORT 0x26 80
                  WRITE_BYTE 0x52 10
                  WRITE_BYTE 0x54 8 WRITE_BYTE 0x55 10 WRITE_BYTE 0x56 9
                  WRITE_BYTE 0x57 9 WRITE_BYTE 0x58 11
                END ELSE BEGIN
                  WRITE_SHORT 0x24 96 WRITE_SHORT 0x26 96
                  WRITE_BYTE 0x52 9
                  WRITE_BYTE 0x54 7 WRITE_BYTE 0x55 9 WRITE_BYTE 0x56 8
                  WRITE_BYTE 0x57 8 WRITE_BYTE 0x58 10
                END
              END
              PATCH_IF (csr256_fallback_l OR csr256_fallback_s) BEGIN
                // Native BG:EE summon templates use SUMMONED classifications.
                // Match the encounter-owned EET chassis rather than inheriting
                // player-summon accounting or the original summoning scripts.
                WRITE_BYTE 0x237 1
                WRITE_BYTE 0x275 4
              END
            END
            // Preserve the source immunity item only if the donor wore it.
            SET csr256_immune = 0
            READ_LONG 0x2bc csr256_io
            READ_LONG 0x2c0 csr256_ic
            FOR (csr256_i = 0; csr256_i < csr256_ic; csr256_i += 1) BEGIN
              READ_ASCII (csr256_io + csr256_i * 20) csr256_item (8) NULL
              PATCH_IF (~%csr256_item%~ STRING_EQUAL_CASE ~IMMUNE2~) BEGIN SET csr256_immune = 1 END
            END
            REMOVE_CRE_ITEMS
            PATCH_IF csr256_immune BEGIN
              ADD_CRE_ITEM ~IMMUNE2~ #0 #0 #0 ~IDENTIFIED&UNDROPPABLE~ ~LRING~ EQUIP
            END
            ADD_CRE_ITEM ~%csr256_weapon%~ #0 #0 #0 ~IDENTIFIED&UNDROPPABLE~ ~WEAPON1~ EQUIP
        END
      END
    END
  END
END
