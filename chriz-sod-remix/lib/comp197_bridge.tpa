// #197 removes Skie's bridge cameo spawns. The installed victory triggers,
// Khalid routes, Bence, journals and every other action remain untouched.
DEFINE_PATCH_FUNCTION csr197_bridge_spawns BEGIN
  REPLACE_TEXTUALLY CASE_INSENSITIVE ~^[ %TAB%]*CreateCreature("bdskie",\[[0-9]+\.[0-9]+\],[^)]*)[^%WNL%]*[%WNL%]+~ ~~
END
