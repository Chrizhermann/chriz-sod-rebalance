// Component 115 owns these complete blocks.
IF
  Global("bd_khal_spawn","bd2000",0)
  InPartyAllowDead("khalid")
THEN
  RESPONSE #100
    SetGlobal("bd_khal_spawn","bd2000",1)
    Continue()
END

IF
  Global("bd_khal_spawn","bd2000",0)
  Global("csr_kh_fort","GLOBAL",2)
  !InPartyAllowDead("khalid")
  !Name("khalid",Player1)
  !Name("khalid",Player2)
  !Name("khalid",Player3)
  !Name("khalid",Player4)
  !Name("khalid",Player5)
  !Name("khalid",Player6)
  OR(2)
    NumInPartyLT(1)
    InMyArea(Player1)
  OR(2)
    NumInPartyLT(2)
    InMyArea(Player2)
  OR(2)
    NumInPartyLT(3)
    InMyArea(Player3)
  OR(2)
    NumInPartyLT(4)
    InMyArea(Player4)
  OR(2)
    NumInPartyLT(5)
    InMyArea(Player5)
  OR(2)
    NumInPartyLT(6)
    InMyArea(Player6)
  GlobalLT("Chapter","GLOBAL",%csr115_ch13%)
  !StateCheck("Khalid",STATE_REALLY_DEAD)
  BeenInParty("khalid")
THEN
  RESPONSE #100
    SetGlobal("bd_khal_spawn","bd2000",1)
    MoveGlobal("bd2000","khalid",[2900.1310])
    ApplySpellRES("bdresurr","khalid")
    SmallWait(1)
    ActionOverride("khalid",Face(E))
    ApplySpellRES("bdrejuve","khalid")
    ChangeEnemyAlly("khalid",NEUTRAL)
    ChangeSpecifics("khalid",ALLIES)
    ActionOverride("khalid",SetGlobal("bd_joined","locals",0))
    ActionOverride("khalid",SetGlobal("bd_retreat","locals",0))
    ActionOverride("khalid",SaveObjectLocation("LOCALS","bd_default_loc",Myself))
    ActionOverride("khalid",ChangeAIScript("bdkhalid",OVERRIDE))
    ActionOverride("khalid",ChangeAIScript("bdfort",CLASS))
    ActionOverride("khalid",ChangeAIScript("bdshout",RACE))
    ActionOverride("khalid",ChangeAIScript("bdfigh01",GENERAL))
    ActionOverride("khalid",ChangeAIScript("",DEFAULT))
    ActionOverride("khalid",SetDialogue("bdkhalid"))
    Continue()
END

IF
  Global("bd_khal_spawn","bd2000",0)
  Global("csr_kh_fort","GLOBAL",2)
  !InPartyAllowDead("khalid")
  !Name("khalid",Player1)
  !Name("khalid",Player2)
  !Name("khalid",Player3)
  !Name("khalid",Player4)
  !Name("khalid",Player5)
  !Name("khalid",Player6)
  OR(2)
    NumInPartyLT(1)
    InMyArea(Player1)
  OR(2)
    NumInPartyLT(2)
    InMyArea(Player2)
  OR(2)
    NumInPartyLT(3)
    InMyArea(Player3)
  OR(2)
    NumInPartyLT(4)
    InMyArea(Player4)
  OR(2)
    NumInPartyLT(5)
    InMyArea(Player5)
  OR(2)
    NumInPartyLT(6)
    InMyArea(Player6)
  GlobalLT("Chapter","GLOBAL",%csr115_ch13%)
  !StateCheck("Khalid",STATE_REALLY_DEAD)
  !BeenInParty("khalid")
THEN
  RESPONSE #100
    SetGlobal("bd_khal_spawn","bd2000",1)
    SetGlobal("SPRITE_IS_DEADKHALID","global",0)
    CreateCreature("khalid7",[2900.1310],E)
    ActionOverride("khalid",MakeGlobalOverride())
    ChangeSpecifics("khalid",ALLIES)
    ActionOverride("khalid",ChangeAIScript("bdkhalid",OVERRIDE))
    ActionOverride("khalid",ChangeAIScript("bdfort",CLASS))
    ActionOverride("khalid",ChangeAIScript("bdshout",RACE))
    ActionOverride("khalid",ChangeAIScript("bdfigh01",GENERAL))
    ActionOverride("khalid",ChangeAIScript("",DEFAULT))
    Continue()
END
