// Component 115 owns these complete blocks.
IF
  Global("csr_kh_fort","GLOBAL",1)
  Global("bd_bridgefort_plot","global",0)
  GlobalLT("bd_plot","global",250)
THEN
  RESPONSE #100
    CutSceneId(Player1)
    ActionOverride(Player2,LeaveAreaLUA("bd2100","",[1410.910],SW))
    ActionOverride(Player3,LeaveAreaLUA("bd2100","",[1510.910],SE))
    ActionOverride(Player4,LeaveAreaLUA("bd2100","",[1410.860],NW))
    ActionOverride(Player5,LeaveAreaLUA("bd2100","",[1510.860],NE))
    ActionOverride(Player6,LeaveAreaLUA("bd2100","",[1460.840],N))
    LeaveAreaLUAPanic("bd2100","",[1460.930],S)
    LeaveAreaLUA("bd2100","",[1460.930],S)
    MultiPlayerSync()
    SmallWait(5)
    AddXPObject(Myself,5000)
    AddXPObject(Player2,5000)
    AddXPObject(Player3,5000)
    AddXPObject(Player4,5000)
    AddXPObject(Player5,5000)
    AddXPObject(Player6,5000)
    MoveViewObject(Player1,INSTANT)
    CreateVisualEffectObject("spportal","teleport_inside")
    SmallWait(15)
    FadeFromColor([10.0],0)
    SmallWait(25)
    AddJournalEntry(%csr115_s66863%,QUEST_DONE)
    ActionOverride("bdbfort",StartDialogNoSet(Player1))
END

IF
  !Global("csr_kh_fort","GLOBAL",1)
  Global("bd_bridgefort_plot","global",0)
  GlobalLT("bd_plot","global",250)
THEN
  RESPONSE #100
    CutSceneId(Player1)
    ActionOverride(Player2,LeaveAreaLUA("bd2100","",[1410.910],SW))
    ActionOverride(Player3,LeaveAreaLUA("bd2100","",[1510.910],SE))
    ActionOverride(Player4,LeaveAreaLUA("bd2100","",[1410.860],NW))
    ActionOverride(Player5,LeaveAreaLUA("bd2100","",[1510.860],NE))
    ActionOverride(Player6,LeaveAreaLUA("bd2100","",[1460.840],N))
    LeaveAreaLUAPanic("bd2100","",[1460.930],S)
    LeaveAreaLUA("bd2100","",[1460.930],S)
    MultiPlayerSync()
    SmallWait(5)
    AddXPObject(Myself,5000)
    AddXPObject(Player2,5000)
    AddXPObject(Player3,5000)
    AddXPObject(Player4,5000)
    AddXPObject(Player5,5000)
    AddXPObject(Player6,5000)
    MoveGlobal("bd2100","khalid",[1460.1025])
    ActionOverride("khalid",Face(NE))
    ActionOverride("khalid",SetSequence(SEQ_HEAD_TURN))
    MoveViewObject(Player1,INSTANT)
    CreateVisualEffectObject("spportal","teleport_inside")
    SmallWait(15)
    FadeFromColor([10.0],0)
    SmallWait(25)
    AddJournalEntry(%csr115_s66863%,QUEST_DONE)
    ActionOverride("bdbfort",StartDialogNoSet(Player1))
END
