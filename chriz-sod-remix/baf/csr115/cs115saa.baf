IF
  Global("csr_kh_fort","GLOBAL",1)
  True()
THEN
  RESPONSE #100
    CutSceneId(Player1)
    CreateCreature("cutspy",[1530.746],E)
    MoveToPoint([1600.705])
    ActionOverride(Player2,MoveToPoint([1590.510]))
    ActionOverride(Player3,MoveToPoint([1660.524]))
    ActionOverride(Player4,MoveToPoint([1629.498]))
    ActionOverride(Player5,MoveToPoint([1699.509]))
    ActionOverride(Player6,MoveToPoint([1665.478]))
    Wait(3)
    CreateCreature("csr115ad",[1209.1046],E)
    ActionOverride("csr115ad",SetInterrupt(FALSE))
    ActionOverride("csr115ad",MoveToPointNoInterrupt([1534.747]))
    ActionOverride("csr115ad",DisplayStringWait(Myself,%csr115_s46536%))
    Wait(7)
    ActionOverride("csr115ad",Face(NW))
    Wait(3)
    ActionOverride("csr115ad",DisplayStringWait(Myself,%csr115_s46542%))
    Wait(3)
    ActionOverride("csr115ad",DisplayStringHead(Myself,%csr115_s46544%))
    Wait(3)
    ActionOverride("csr115ad",EscapeArea())
    SetGlobal("bd_205_stakeout","global",2)
    Wait(8)
    StartCutSceneEx("bdc205ba",FALSE)
END

