// Component 115 owns these complete blocks.
IF
  Global("csr_kh_fort","GLOBAL",1)
  Global("bd_bridgefort_plot","global",6)
THEN
  RESPONSE #100
    StartCutSceneMode()
    CreateCreature("bdcrusbf",[2605.2080],NE)
    MoveViewPoint([2975.1510],INSTANT)
    CreateCreature("bdbfort2",[3205.1375],SW)
    ActionOverride("bdbfort2",MoveToPoint([2975.1510]))
    Wait(3)
    ActionOverride(Player1,MoveToPoint([3000.1480]))
    DisplayStringHead("bdbfort2",%csr115_s36852%)
    Wait(3)
    MoveViewPoint([3035.1910],INSTANT)
    CreateCreature("cutspy",[3035.1910],S)
    SmallWait(10)
    ActionOverride("bdcrusbf",MoveToPoint([2765.1935]))
    SmallWait(45)
    ActionOverride("bdcrusbf",Face(NE))
    SmallWait(15)
    DisplayStringHead("bdcrusbf",%csr115_s36854%)
    SmallWait(20)
    ActionOverride("bdcrusbf",Face(S))
    ActionOverride("bdcrusbf",SetSequence(SEQ_ATTACK_SLASH))
    SmallWait(20)
    ActionOverride("bdcrusx2",Face(S))
    SmallWait(20)
    ActionOverride("bdcrusx2",Face(NE))
    SmallWait(5)
    ActionOverride(Player1,Face(S))
    ActionOverride("bdbfort2",MoveToPoint([3010.1410]))
    ActionOverride("bdcrusbf",Face(NE))
    ActionOverride("bdbarghe",SetGlobal("bd_retreat","locals",0))
    ActionOverride("bdolonei",SetGlobal("bd_retreat","locals",0))
    ActionOverride("bdvichan",SetGlobal("bd_retreat","locals",0))
    ActionOverride("bdhormor",SetGlobal("bd_retreat","locals",0))
    ActionOverride("bdbarghe",JumpToPoint([2800.2250]))
    ActionOverride("bdolonei",JumpToPoint([2465.2150]))
    ActionOverride("bdbarghe",MoveToPoint([3010.1960]))
    ActionOverride("bdolonei",MoveToPoint([2935.1975]))
    Wait(2)
    ActionOverride("bdvichan",JumpToPoint([2735.2230]))
    ActionOverride("bdhormor",JumpToPoint([2845.2290]))
    ActionOverride("bdvichan",MoveToPoint([2965.2035]))
    ActionOverride("bdhormor",MoveToPoint([3045.2005]))
    Wait(4)
    ActionOverride("bdbfort2",Face(S))
    Wait(2)
    ActionOverride("bdbarghe",StartDialogNoSet(Player1))
END

