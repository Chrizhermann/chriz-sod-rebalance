// Component 115 owns these complete blocks.
IF
  InMyArea(Player1)
  !ActuallyInCombat()
  !GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
  !Global("bd_pbdd037","MYAREA",-1)
  Switch("bd_pbdd037","MYAREA")
  OR(2)
    Global("csr_kh_carry","GLOBAL",1)
    Global("csr_kh_fort","GLOBAL",1)
THEN
  RESPONSE #0
    DisplayStringHead("DYNAHEIR",@11582)
    SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
