    SetGlobal("bd_pbdd037","MYAREA",40)
  RESPONSE #40
    DisplayStringHead("KHALID",%csr115_s59070%)
    SetGlobalTimer("BD_BANTER_DELAY","MYAREA",8)
    SetGlobal("bd_pbdd037","MYAREA",-1)
  RESPONSE #50
    DisplayStringHead("DYNAHEIR",%csr115_s59071%)
    SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
    SetGlobal("bd_pbdd037","MYAREA",60)
  RESPONSE #60
    DisplayStringHead("KHALID",%csr115_s59072%)
    SetGlobalTimer("BD_BANTER_DELAY","MYAREA",11)
    SetGlobal("bd_pbdd037","MYAREA",70)
  RESPONSE #70
    DisplayStringHead("DYNAHEIR",%csr115_s59073%)
    SetGlobalTimer("BD_BANTER_DELAY","MYAREA",ONE_ROUND)
    SetGlobal("bd_pbdd037","MYAREA",701)
  RESPONSE #71
    DisplayStringHead("MINSC",%csr115_s59074%)
    SetGlobalTimer("BD_BANTER_DELAY","MYAREA",11)
    SetGlobal("bd_pbdd037","MYAREA",-1)
  RESPONSE #80
    DisplayStringHead("DYNAHEIR",%csr115_s59075%)
    SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
    SetGlobal("bd_pbdd037","MYAREA",40)
END

