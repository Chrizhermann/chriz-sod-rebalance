IF
  True()
THEN
  RESPONSE #100
    CutSceneId("bdcutid")
    FadeToColor([20.0],0)
    Wait(3)
    StartMovie("sodcin02")
    Wait(1)
    CloseDoor("Bhaal_Skull")
    AmbientActivate("Bhaal_Smoke01",TRUE)
    AmbientActivate("Bhaal_Smoke02",TRUE)
    AmbientActivate("Bhaal_Smoke03",TRUE)
    AmbientActivate("Bhaal_Smoke04",TRUE)
    AmbientActivate("Bhaal_Smoke05",TRUE)
    AmbientActivate("Bhaal_Smoke06",TRUE)
    ActionOverride(Player1,JumpToPoint([900.1510]))
    ActionOverride(Player2,JumpToPoint([1060.1635]))
    ActionOverride(Player3,JumpToPoint([1075.1530]))
    ActionOverride(Player4,JumpToPoint([995.1655]))
    ActionOverride(Player5,JumpToPoint([930.1650]))
    ActionOverride(Player6,JumpToPoint([1095.1590]))
    ActionOverride(Player2,FaceObject(Player1))
    ActionOverride(Player3,FaceObject(Player1))
    ActionOverride(Player4,FaceObject(Player1))
    ActionOverride(Player5,FaceObject(Player1))
    ActionOverride(Player6,FaceObject(Player1))
    CreateCreature("bdfist22",[1170.1600],NW)
    CreateCreature("bdfist23",[1175.1645],NW)
    CreateCreature("bdfist24",[1160.1695],NW)
    CreateCreature("bdfist21",[1075.1685],NW)
    CreateCreature("bdfist25",[1106.1755],NW)
    Wait(1)
    MoveViewObject(Player1,INSTANT)
    SmallWait(5)
    FadeFromColor([20.0],0)
    Wait(2)
    AddJournalEntry(%csr120_s66864%,QUEST_DONE)
    AddJournalEntry(%csr120_s66865%,QUEST)
    ActionOverride(Player1,SetSequence(SEQ_AWAKE))
    SmallWait(5)
    ActionOverride(Player1,SetSequence(SEQ_AWAKE))
    DisplayStringHead("bdfist22",%csr120_s70646%)
    SmallWait(10)
    ActionOverride(Player1,Face(SE))
    SmallWait(10)
    SmallWait(30)
    ActionOverride(Player1,Face(NW))
