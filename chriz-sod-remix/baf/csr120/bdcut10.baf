IF
  True()
THEN
  RESPONSE #100
    CutSceneId(Player1)
    ClearAllActions()
    SmallWait(5)
    AdvanceTime(THREE_DAYS)
    DayNight(19)
    ApplySpellRES("bdrejuve",Myself)
    ApplySpellRES("bdrejuve",Player2)
    ApplySpellRES("bdrejuve",Player3)
    ApplySpellRES("bdrejuve",Player4)
    ApplySpellRES("bdrejuve",Player5)
    ApplySpellRES("bdrejuve",Player6)
    ActionOverride(Player2,LeaveAreaLUA("bd1000","",[500.3660],NE))
    ActionOverride(Player3,LeaveAreaLUA("bd1000","",[400.3660],NE))
    ActionOverride(Player4,LeaveAreaLUA("bd1000","",[450.3710],NE))
    ActionOverride(Player5,LeaveAreaLUA("bd1000","",[350.3710],NE))
    ActionOverride(Player6,LeaveAreaLUA("bd1000","",[400.3760],NE))
    LeaveAreaLUAPanic("bd1000","",[450.3610],NE)
    LeaveAreaLUA("bd1000","",[450.3610],NE)
    MultiPlayerSync()
    Wait(3)
    AddXPObject(Myself,7500)
    AddXPObject(Player2,7500)
    AddXPObject(Player3,7500)
    AddXPObject(Player4,7500)
    AddXPObject(Player5,7500)
    AddXPObject(Player6,7500)
    SetGlobal("bd_plot","global",100)
    SetGlobal("bd_npc_camp_chapter","global",2)
    IncrementChapter("chptxt8")
    AddJournalEntry(%csr120_s56974%,INFO)
    FadeToColor([0.0],0)
    FadeFromColor([20.0],0)
    EndCutSceneMode()
END
