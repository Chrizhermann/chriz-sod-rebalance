// csrskixp - component 197: native SoD join-XP floors for the restored recruit.
// The same ladder used by BDMINSC/BDKHALID and component 160's Imoen.
// BDSKIE was a plot actor in vanilla, so her personal script had none.
// Only a valid party member can catch up; each XP mutation is a floor, never
// a reduction or additive reward. BD_JOINXP/BDSODXP retain the native one-time
// join and safehouse handshake. No class, kit, level or equipment is changed.
// Extending BDSKIE also repairs already-recruited saved palace Skie. Imported
// BG1 SKIE actors use their original scripts and are not changed by this patch.

IF
  Global("BD_JOINXP","LOCALS",1)
  Global("BD_SAFEHOUSE_DONE","GLOBAL",1)
  Global("BDSODXP","LOCALS",0)
  IsValidForPartyDialogue(Myself)
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    SetGlobal("BDSODXP","LOCALS",1)
    SetGlobal("BD_JOINXP","LOCALS",0)
    SetInterrupt(TRUE)
END

IF
  Global("BD_JOINXP","LOCALS",0)
  IsValidForPartyDialogue(Myself)
  XPGT(Player1,249999)
  XPLT(Myself,250000)
THEN
  RESPONSE #100
    SetInterrupt(FALSE)
    SetGlobal("BD_JOINXP","LOCALS",1)
    ChangeStat(Myself,XP,250000,SET)
    SetInterrupt(TRUE)
END

