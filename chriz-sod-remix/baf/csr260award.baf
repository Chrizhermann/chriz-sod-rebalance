IF
  GlobalGT("bd_plot","global",400)
  GlobalLT("chapter","global",11)
THEN
  RESPONSE #100
    StartCutSceneMode()
    ClearAllActions()
    FadeToColor([20.0],0)
    Wait(1)
    SetGlobal("bd_cant_rest","myarea",1)
    SetGlobalTimer("BD_NPC_BANTER","GLOBAL",TWELVE_HOURS)
    AddWorldmapAreaFlag("BD5000",6)
    AddWorldmapAreaFlag("BD7400",6)
    AddWorldmapAreaFlag("BD2000",6)
    AddAreaFlag(64)
    OpenDoor("Door05")
    OpenDoor("Door06")
    TriggerActivation("Mdd1205",TRUE)
    TriggerActivation("MDD1102",FALSE)
    AmbientActivate("force_wall",FALSE)
    AddMapNoteColor([3143.3367],%csr260_str269073%,2)
    AddMapNoteColor([2793.1775],%csr260_str269075%,2)
    AddMapNoteColor([4393.480],%csr260_str269076%,2)
    AddMapNoteColor([2394.2416],%csr260_str269138%,1)
    AddMapNoteColor([825.1280],%csr260_str269074%,2)
    TriggerActivation("Lightningtrap",TRUE)
    TriggerActivation("Hold_persontrap1",TRUE)
    TriggerActivation("Flamestriketrap1",TRUE)
    TriggerActivation("Speartrap1",TRUE)
    TriggerActivation("Speartrap2",TRUE)
    TriggerActivation("Speartrap3",TRUE)
    TriggerActivation("Speartrap4",TRUE)
    TriggerActivation("Speartrap5",TRUE)
    TriggerActivation("Speartrap6",TRUE)
    TriggerActivation("Speartrap7",TRUE)
    TriggerActivation("Speartrap8",TRUE)
    TriggerActivation("Speartrap9",TRUE)
    TriggerActivation("Speartrap10",TRUE)
    TriggerActivation("map_table",FALSE)
    TriggerActivation("stone_icon",FALSE)
    TriggerActivation("Wine Barrels",FALSE)
    ApplySpellRES("bdremove",Player1)
    SmallWait(5)
    SetGlobal("bd_npc_camp_chapter","global",5)
    IncrementChapter("chptxt11")
    AddJournalEntry(%csr260_str256373%,INFO)
    SoundActivate("AM_Distant_Battle",TRUE)
    SoundActivate("SS_Magic_Battle",TRUE)
    SoundActivate("SS_Rumble_Battle",TRUE)
    AddXPObject(Player1,20000)
    AddexperienceParty(%csr_xp_chunk_260%)
    AddXPObject(Player2,20000)
    AddXPObject(Player3,20000)
    AddXPObject(Player4,20000)
    AddXPObject(Player5,20000)
    AddXPObject(Player6,20000)
    SetCutSceneLite(TRUE)
    EndCutSceneMode()
END
