// Complete owned council sequence, from the previous installer output.
IF
  Global("BD_plot","global",51)
  OnCreation()
  NearLocation(Player1,1057,821,10)
  Global("BD_HELPED_KILL_ASSASSINS","GLOBAL",0)
THEN
  RESPONSE #100
    StartCutSceneMode()
    SetGlobal("BD_plot","global",52)
    CreateCreature("BDELTAN",[1128.630],NE)
    CreateCreature("BDBELT",[680.390],NE)
    CreateCreature("BDSKIE",[856.414],SW)
    CreateCreature("BDENTAR",[728.366],SW)
    CreateCreature("bdfistcc",[700.280],SW)
    ActionOverride("BDFISTCC",SetDialogue("BDFFPOOL"))
    CreateCreature("bdfistcc",[1050.540],SW)
    ActionOverride("BDFISTCC",SetDialogue("BDFFPOOL"))
    CreateCreature("bdfistcc",[682.672],SW)
    ActionOverride("BDFISTCC",SetDialogue("BDFFPOOL"))
    CreateCreature("bdfistcc",[585.610],SW)
    ActionOverride("BDFISTCC",SetDialogue("BDFFPOOL"))
    CreateCreature("bdjospil",[201.485],E)
    ActionOverride("bdjospil",ChangeAIScript("RANDWALK",DEFAULT))
    ActionOverride("BDELTAN",FaceObject(Player1))
    ActionOverride(Player1,MoveToPoint([719.491]))
    MoveViewPoint([719.491],BD_NORMAL)
    SmallWait(8)
    ActionOverride("BDELTAN",MoveToPoint([808.474]))
    SmallWait(10)
    ActionOverride("BDBELT",FaceObject(Player1))
    SmallWait(3)
    ActionOverride("BDENTAR",FaceObject(Player1))
    SmallWait(13)
    ActionOverride("BDBELT",MoveToPoint([712.438]))
    ActionOverride("BDENTAR",MoveToPoint([760.426]))
    Wait(1)
    CreateCreature("BDSCHAEL",[919.722],NW)
    CreateCreature("BDLIIA",[919.722],NW)
    ActionOverride("BDSCHAEL",MoveToPoint([744.510]))
    ActionOverride("BDLIIA",MoveToPoint([792.499]))
    Wait(3)
    ActionOverride(Player1,Face(NE))
    ActionOverride("BDSCHAEL",Face(N))
    SmallWait(3)
    ActionOverride("BDSCHAEL",StartDialogNoSet(Player1))
    Continue()
END

IF
