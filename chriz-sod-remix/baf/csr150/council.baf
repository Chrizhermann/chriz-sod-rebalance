    CreateCreature("bdfistcc",[700.280],SW)
    ActionOverride("BDFISTCC",SetDialogue("BDFFPOOL"))
    CreateCreature("bdfistcc",[1050.540],SW)
    ActionOverride("BDFISTCC",SetDialogue("BDFFPOOL"))
